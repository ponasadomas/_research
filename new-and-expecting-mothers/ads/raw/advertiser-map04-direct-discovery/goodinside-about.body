ons":{"maxWidth":1200,"lazyLoad":false},"isRSC":null},"children":[{"@type":"@builder.io/sdk:Element","@version":2,"id":"builder-378373b8d2fc4dfe89f7b6a199f9b734","component":{"name":"Symbol","options":{"symbol":{"model":"symbol","entry":"eeced363f68d424c939539f26cedbd18","ownerId":"ac912521f6d24dfbb365f8985ed4c0c0","data":{"cssCode":"/*\n* Custom CSS styles\n*\n* Global by default, but use `\u0026` to scope to just this content, e.g.\n*\n*   \u0026 .foo {\n*     color: 'red'\n*   }\n*/\n\n/** vvvvv Workaround for Brightcove video player aspect ratio issues vvvvv **/\n\n/* first div within Builder.io box */\n.fillVideoHeightDiv \u003e div:first-child {\n    height: 100%;\n}\n\n/* first div within div mentioned above */\n.fillVideoHeightDiv \u003e div:first-child \u003e div:first-child {\n    height: 100%;\n}\n\n/* select container element for Brightcove within div mentioned above */\n.fillVideoHeightDiv \u003e div:first-child \u003e div:first-child \u003e [class=\"vjs-play-button-background\"] {\n    height: 100%;\n}\n\n.fillVideoHeightDiv \u003e div:first-child \u003e div:first-child \u003e [class=\"vjs-play-button-background\"] \u003e video-js {\n    height: 100%;\n}\n\n/** ^^^^^ Workaround for Brightcove video player aspect ratio issues ^^^^^ **/\n\n/* ensure brightcove media players within testimonial carousel don't stretch */\n.testimonialCarouselVideoBox {\n    max-width: 418px;\n    min-width: 418px;\n}\n\n/* In the current design, this is the first and second video in the testimonial carousel */\n[data-swiper-slide-index=\"0\"],  [data-swiper-slide-index=\"2\"] {\n    max-width: 418px;\n    min-width: 418px;\n}\n\n#testimonial-section \u003e section {\n    align-items: center;\n}\n\n@media(max-width: 640px){\n    /* ensure brightcove media players within testimonial carousel don't stretch */\n    .testimonialCarouselVideoBox {\n        min-width: 329px;\n        max-width: 329px;\n        min-height: 329px;\n        max-height: 329px;\n        margin: auto;\n        position: relative;\n        top: 10%;\n    }\n    /* In the current design, this is the first and second video in the testimonial carousel */\n     [data-swiper-slide-index=\"0\"],  [data-swiper-slide-index=\"2\"] {\n        max-width: 329px !important;\n        min-width: 329px !important;\n    }\n}\n\n@media(max-width: 1199px){\n    .simpleStepsBox{\n        gap: 40px !important;\n    }\n    .stepBox {\n        flex: 0 !important;\n    }\n}\n\n.tabletCarousel\u003e div \u003e div \u003e div.swiper-wrapper \u003e div.swiper-slide {\n    display: flex;\n    justify-content: center;\n}","customFonts":[{"category":"sans-serif","family":"Montserrat","files":{"100":"https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCtr6Uw-Y3tcoqK5.ttf","200":"https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCvr6Ew-Y3tcoqK5.ttf","300":"https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCs16Ew-Y3tcoqK5.ttf","500":"https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCtZ6Ew-Y3tcoqK5.ttf","600":"https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCu170w-Y3tcoqK5.ttf","700":"https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCuM70w-Y3tcoqK5.ttf","800":"https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCvr70w-Y3tcoqK5.ttf","900":"https://fonts.gstatic.com/s/montserrat/v26/JTUHjIg1_i6t8kCHKm4532VJOt5-QNFgpCvC70w-Y3tcoqK5.ttf","100italic":"https://fonts.gstatic.com/s/montserrat/v26/JTUFjIg1_i6t8kCHKm459Wx7xQYXK0vOoz6jq6R8aX9-p7K5ILg.ttf","200italic":"https://fonts.gstatic.com/s/montserrat/v26/JTUFjIg1_i6t8kCHKm459Wx7xQYXK0vOoz6jqyR9aX9-p7K5ILg.ttf","300italic":"https://fonts.gstatic.com/s/montserrat/v26/JTUFjIg1_i6t8kCHKm459Wx7xQYXK0vOoz6jq_p9aX9-p7K5ILg.ttf","500italic":"https://fonts.gstatic.com/s/montserrat/v26/JTUFjIg1_i6t8kCHKm459Wx7xQYXK0vOoz6jq5Z9aX9-p7K5ILg.ttf","600italic":"https://fonts.gstatic.com/s/mo