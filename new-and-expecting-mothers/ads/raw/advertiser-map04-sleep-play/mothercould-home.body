<script>
  const CSS_SOURCE = `
    .mnc-overlay {
      font-family: 'Lato', Arial, Helvetica, sans-serif !important;
      font-weight: 400 !important;
    }
    h1,h2,h3,h4,h5,h6,p,span,div {
      font-weight: 400 !important;
    }
  `;

  function injectStyles(hostEl) {
    const shadowHost = hostEl.querySelector(':scope > div'); // plain div child
    if (!shadowHost || !shadowHost.shadowRoot) return;       // safety check

    if (shadowHost.shadowRoot.querySelector('style[data-injected]')) return;

    const style = document.createElement('style');
    style.setAttribute('data-injected', '');
    style.textContent = CSS_SOURCE;
    shadowHost.shadowRoot.appendChild(style);
  }

  const obs = new MutationObserver(muts => {
    for (const m of muts) {
      for (const n of m.addedNodes) {
        if (n.nodeType !== 1) continue;
        if (n.classList?.contains('mnc-root')) injectStyles(n);
        n.querySelectorAll?.('.mnc-root').forEach(injectStyles);
      }
    }
  });

  obs.observe(document.documentElement, { childList: true, subtree: true });
</script><script>
  document.addEventListener('DOMContentLoaded', function() {
    // Array of block IDs to make clickable
    const blockIds = [
      'block-426e1108e6e481e8927c',
      'block-0f18f8517c57221e35c9',
      'block-1233c566522179ee773b',
      'block-fe1b7f36235df11b28a4',
      'block-a32d575c6ed64594cbb2'
    ];
    
    blockIds.forEach(function(blockId) {
      const block = document.getElementById(blockId);
      
      if (block) {
        // Find the first link inside the block
        const link = block.querySelector('a');
        
        if (link) {
          // Get the href and target attributes
          const href = link.getAttribute('href');
          const target = link.getAttribute('target');
          
          // Make the entire block clickable
          block.style.cursor = 'pointer';
          
          block.addEventListener('click', function(e) {
            // Prevent double-firing if clicking directly on the link
            if (e.target.tagName !== 'A') {
              if (target === '_blank') {
                window.open(href, '_blank');
              } else {
                window.location.href = href;
              }
            }
          });
        }
      }
    });
  });
</script>

<style>
  @media only screen and (max-width:768px) {
  /* Hide the logo on mobile by default */
  .header-title-logo {
    display: none !important;
  }

  /* Show the logo only when the mobile menu is open */
  body.header--menu-open .header-title-logo {
    display: block !important;
  }
}
  </style>

