<script>
  (function () {
    const root = document.currentScript.parentElement.querySelector('[data-hero-rating]');
    if (!root) return;

    const target = root.querySelector('[data-dynamic-rating]');
    const stars = root.querySelector('[data-rating-stars]');

    // The label ships with `is-pending` so the fallback never flashes. Every
    // exit path below must reveal it again.
    const reveal = function () {
      if (target) target.classList.remove('is-pending');
    };

    const store = root.dataset.ratingStore;
    const sku = root.dataset.ratingSku;
    if (!store) {
      reveal();
      return;
    }

    // With a SKU we read that product's average; without one we fall back to
    // the store-wide average.
    const url = sku
      ? 'https://api.reviews.io/product/rating?' + new URLSearchParams({ store: store, sku: sku })
      : 'https://api.reviews.io/timeline/data?' +
        new URLSearchParams({
          store: store,
          type: 'store_review',
          sort: 'date_desc',
          page: '1',
          per_page: '1',
          lang: 'en',
        });

    fetch(url)
      .then(function (r) {
        return r.ok ? r.json() : null;
      })
      .then(function (data) {
        if (!data) return;
        const average = sku ? data.rating : data.storeStats && data.storeStats.average_rating;
        const value = Number(average);
        if (!value) return;

        if (target) {
          const template = target.dataset.ratingTemplate;
          if (template && template.indexOf('[rating]') !== -1) {
            target.textContent = template.replace('[rating]', value.toFixed(1));
          }
        }

        if (stars) {
          const fill = Math.max(0, Math.min(100, value * 20));
          stars.style.setProperty('--hero-stars-fill', fill.toFixed(2) + '%');
        }
      })
      .catch(function () {
        // Keep the server-rendered fallback.
      })
      .finally(reveal);
  })();
</script>


