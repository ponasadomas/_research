<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Prevent search modal from opening during initial page load
    let pageLoadComplete = false;
    setTimeout(() => {
      pageLoadComplete = true;
    }, 1000);

    function isMobile() {
      return (
        /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ||
        (typeof navigator.maxTouchPoints === 'number' && navigator.maxTouchPoints > 0)
      );
    }

    // Matches the breakpoint in custom-base.css that collapses the theme search dialog
    // to 1px and hands the visible search UI to Globo's fullscreen layer.
    function isCompactSearchViewport() {
      return window.matchMedia('(max-width: 990px)').matches;
    }

    // Below 990px the visible search UI is Globo's fullscreen layer, which lives outside
    // the top layer. Opening the theme dialog with showModal() would put it in the top
    // layer and make everything outside it inert, so Globo's input could never take focus
    // and every tap would land on the modal backdrop. Open it non-modally instead.
    // Patched on the element so all three callers are covered: openSearchModal() below,
    // DialogComponent.showDialog(), and the declarative on:click bindings.
    function patchSearchDialogModality(searchModal) {
      const dialog = searchModal.querySelector('dialog');
      if (!dialog || dialog.dataset.modalityPatched) return;
      dialog.dataset.modalityPatched = 'true';

      const nativeShowModal = dialog.showModal.bind(dialog);
      dialog.showModal = function () {
        if (isCompactSearchViewport()) {
          if (!dialog.open) dialog.show();
          return;
        }
        nativeShowModal();
      };
    }

    // Try to focus Globo input; if not in DOM yet, poll until found then focus and clear interval.
    function focusGloboInputWithRetry() {
      document.documentElement.classList.remove('scroll-lock');
      document.body.classList.remove('scroll-lock');

      function doFocus(globoInput) {
        if (!globoInput || !(globoInput instanceof HTMLElement)) return false;
        try {
          globoInput.scrollIntoView({ block: 'nearest', behavior: 'instant' });
          globoInput.focus({ preventScroll: false });
          globoInput.click();
          globoInput.setSelectionRange(0, 0);
          // Second focus after a tick (helps iOS keyboard open)
          setTimeout(function () {
            globoInput.focus();
            globoInput.setSelectionRange(0, 0);
          }, 50);
          return true;
        } catch (e) {
          return false;
        }
      }

      function tryFocus() {
        const globoInput = document.querySelector('#gl-d-searchbox-input');
        return globoInput ? doFocus(globoInput) : false;
      }

      if (tryFocus()) return;

      const intervalMs = 80;
      const maxMs = 5000;
      let elapsed = 0;
      const intervalId = setInterval(function () {
        if (tryFocus()) {
          clearInterval(intervalId);
          return;
        }
        elapsed += intervalMs;
        if (elapsed >= maxMs) clearInterval(intervalId);
      }, intervalMs);
    }

    // When Globo injects #gl-d-searchbox-input, focus it (runs when search is open on mobile).
    function observeGloboInputAndFocus() {
      if (!isMobile()) return;
      const observer = new MutationObserver(function (mutations) {
        for (let i = 0; i < mutations.length; i++) {
          const nodes = mutations[i].addedNodes;
          for (let j = 0; j < nodes.length; j++) {
            const node = nodes[j];
            if (node.nodeType !== 1) continue;
            const input = node.id === 'gl-d-searchbox-input' ? node : node.querySelector?.('#gl-d-searchbox-input');
            if (input && input instanceof HTMLElement) {
              document.documentElement.classList.remove('scroll-lock');
              document.body.classList.remove('scroll-lock');
              setTimeout(function () {
                input.focus();
                input.click();
                input.setSelectionRange(0, 0);
              }, 0);
              return;
            }
          }
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
      setTimeout(function () {
        observer.disconnect();
      }, 6000);
    }

    // Desktop: focus theme search input (#cmdk-input). Mobile: focus Globo input (#gl-d-searchbox-input) only.
    function focusSearchInput() {
      document.documentElement.classList.remove('scroll-lock');
      document.body.classList.remove('scroll-lock');

      if (isMobile()) {
        return focusGloboInputWithRetry();
      }

      const themeInput = document.querySelector('#cmdk-input');
      if (themeInput && themeInput.offsetParent !== null) {
        themeInput.focus();
        themeInput.setSelectionRange(0, 0);
        return true;
      }
      return false;
    }

    // Function to open search modal with multiple fallback methods
    function openSearchModal() {
      const searchModal = document.querySelector('#search-modal');

      if (searchModal) {
        const dialog = searchModal.querySelector('dialog');

        if (dialog && typeof dialog.showModal === 'function') {
          dialog.showModal();
          requestAnimationFrame(() => setTimeout(focusSearchInput, 50));
          return true;
        }
      }

      if (searchModal && typeof searchModal.showDialog === 'function') {
        searchModal.showDialog();
        requestAnimationFrame(() => setTimeout(focusSearchInput, 50));
        return true;
      }

      if (window.searchPopupPersist && window.searchPopupPersist.show) {
        window.searchPopupPersist.show();
        setTimeout(focusSearchInput, 100);
        return true;
      }

      const hiddenSearchInput = document.querySelector('input[type="search"][name="q"]');
      if (hiddenSearchInput) {
        hiddenSearchInput.focus();
        hiddenSearchInput.click();
        return true;
      }

      if (searchModal) {
        searchModal.style.display = 'block';
        searchModal.style.position = 'fixed';
        searchModal.style.top = '0';
        searchModal.style.left = '0';
        searchModal.style.width = '100%';
        searchModal.style.height = '100%';
        searchModal.style.zIndex = '9999';
        searchModal.setAttribute('open', '');

        const dialog = searchModal.querySelector('dialog');
        if (dialog) {
          dialog.setAttribute('open', '');
          dialog.style.display = 'block';
        }

        requestAnimationFrame(() => setTimeout(focusSearchInput, 50));
        return true;
      }

      return false;
    }

    // On mobile: after 300ms click the open dialog then focus Globo input (poll until found).
    function mobileSearchFocusDelayed() {
      if (!isMobile()) return;

      setTimeout(function () {
        const openDialog = document.querySelector('.dialog-modal[open]');
        if (openDialog && openDialog instanceof HTMLElement) {
          openDialog.click();
          // Wait for the dialog click to finish before focusing the Globo input
          setTimeout(focusGloboInputWithRetry, 200);
        } else {
          focusGloboInputWithRetry();
        }
      }, 300);
    }

    // Focus when dialog opens (reliable timing after showModal/showDialog)
    const searchModalEl = document.querySelector('#search-modal');
    if (searchModalEl) {
      patchSearchDialogModality(searchModalEl);

      searchModalEl.addEventListener('dialog:open', function () {
        if (isMobile()) {
          focusSearchInput();
          observeGloboInputAndFocus();
          setTimeout(focusSearchInput, 100);
          setTimeout(focusSearchInput, 300);
          setTimeout(focusSearchInput, 600);
          mobileSearchFocusDelayed();
        } else {
          focusSearchInput();
          setTimeout(focusSearchInput, 100);
          setTimeout(focusSearchInput, 300);
        }
      });
      searchModalEl.addEventListener('dialog:close', function () {
        hasFocused = false;
      });

      // Ensure theme close button closes on first tap (backdrop or event order can block otherwise)
      searchModalEl.addEventListener(
        'click',
        function (e) {
          if (e.target && e.target.closest('.predictive-search__close-modal-button')) {
            if (typeof searchModalEl.closeDialog === 'function') {
              e.preventDefault();
              e.stopPropagation();
              searchModalEl.closeDialog();
            }
          }
        },
        true,
      );
    }

    let hasFocused = false;

    const searchButtons = document.querySelectorAll('button[data-search-trigger="true"], .js-open-search-modal');

    searchButtons.forEach((button) => {
      button.addEventListener(
        'click',
        function (e) {
          if (!pageLoadComplete) return;

          e.preventDefault();
          e.stopPropagation();
          e.stopImmediatePropagation();

          const searchInputs = document.querySelectorAll('input[type="search"]');
          searchInputs.forEach((input) => {
            input.blur();
          });

          openSearchModal();
          if (isMobile()) {
            focusGloboInputWithRetry();
            observeGloboInputAndFocus();
            mobileSearchFocusDelayed();
          }
          return false;
        },
        { passive: false },
      );

      button.addEventListener(
        'contextmenu',
        function (e) {
          e.preventDefault();
          return false;
        },
        { passive: false },
      );
    });

    // Add click handler for search input - single click triggers double-click effect
    // This improves mobile user experience by making a single tap behave like a double-click
    document.addEventListener('click', function (e) {
      // Check if clicked directly on the search input field
      if (e.target && e.target.id === 'gl-d-searchbox-input') {
        // Remove scroll-lock classes that prevent clicking on the input
        // These classes are added by the modal system but interfere with input interactions
        document.documentElement.classList.remove('scroll-lock');
        document.body.classList.remove('scroll-lock');

        // Don't prevent the normal click - let it happen naturally
        // Just add the double-click effect after the natural click
        const input = e.target;

        // Allow the natural click to happen first, then add double-click effect
        setTimeout(() => {
          // Focus the input (in case it wasn't focused by the natural click)
          input.focus();

          // Simulate a second click for double-click effect
          setTimeout(() => {
            input.focus();
            input.setSelectionRange(0, 0); // Position cursor at the beginning
          }, 50);
        }, 10);
      }

      // Reset focus flag when search is closed (Globo or theme close button)
      if (
        e.target &&
        (e.target.closest('.gl-d-close-btn') || e.target.closest('.predictive-search__close-modal-button'))
      ) {
        hasFocused = false;

        // Globo's close button only tears down its own layer, leaving the non-modal theme
        // dialog open. showDialog() bails when the dialog is already open, so without this
        // the next tap would not fire dialog:open and search would not reopen.
        if (searchModalEl && typeof searchModalEl.closeDialog === 'function') {
          searchModalEl.closeDialog();
        }
      }
    });
  });
</script>

            
        
      
        
          
