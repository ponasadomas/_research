  @media (min-width: 1024px) {
    /* Figma anchors both media columns on the page centre: the right-hand video
       starts at 717 and the left-hand image ends at 723 on a 1440 canvas whose
       centre is 720. Sizing the media column at 50% + 3px reproduces that, so
       the stacked blocks line up with the same small overlap. */
    /* The theme's .section grid already insets this by --page-margin, so only
       pad the remainder to reach Figma's 74px page margin. */
