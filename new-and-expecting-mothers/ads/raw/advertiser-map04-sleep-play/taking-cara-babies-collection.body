    display: none;
  }

  .image-with-text--classes .image-with-text__video-wrapper {
    position: relative;
  }

  /* Centred with inset + margin rather than a translate: custom-base.css forces
     transform:none on button:hover/:focus, which would drop the centring and
     make the badge jump on hover. */
  .image-with-text--classes .image-with-text__video-play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 71px;
    height: 71px;
    padding: 0;
    border: none;
    background: none;
    color: var(--color-white);
    cursor: pointer;
  }

  .image-with-text--classes .image-with-text__video-play[hidden] {
    display: none;
  }

  .image-with-text--classes .image-with-text__video-play svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (min-width: 1024px) {
    /* Figma anchors both media columns on the page centre: the right-hand video
       starts at 717 and the left-hand image ends at 723 on a 1440 canvas whose
       centre is 720. Sizing the media column at 50% + 3px reproduces that, so
       the stacked blocks line up with the same small overlap. */
    /* The theme's .section grid already insets this by --page-margin, so only
       pad the remainder to reach Figma's 74px page margin. */
    .image-with-text--classes .image-with-text__container,
    .image-with-text--classes .image-with-text__container:has(.image-with-text__grid--reverse) {
      max-width: none;
      padding-inline: max(0px, calc(74px - var(--page-margin, 40px)));
    }

    .image-with-text--classes .image-with-text__grid,
    .image-with-text--classes .image-with-text__grid--reverse {
      max-width: none;
      grid-template-columns: calc(50% - 99px) calc(50% + 3px);
      gap: 96px;
      align-items: center;
    }

    .image-with-text--classes .image-with-text__grid--reverse {
      grid-template-columns: calc(50% + 3px) calc(50% - 99px);
    }

    .image-with-text--classes .image-with-text__content {
      max-width: 470px;
    }

    .image-with-text--classes .image-with-text__grid--reverse .image-with-text__media-wrapper {
      order: -1;
    }

    .image-with-text--classes .image-with-text__media-wrapper {
      margin-inline: 0;
      padding-left: 0;
    }

    .image-with-text--classes .image-with-text__grid--reverse .image-with-text__image-wrapper img {
      max-width: none;
      margin-inline: 0;
    }
  }

  @media (max-width: 1023px) {
    /* Figma mobile puts every block on the same 20px margin. The base section
       gives the reversed container zero padding and the normal one 24px, which
       is what made the two blocks sit at different insets. */
    .image-with-text--classes .image-with-text__container,
    .image-with-text--classes .image-with-text__container:has(.image-with-text__grid--reverse) {
      max-width: none;
      padding-inline: max(0px, calc(20px - var(--page-margin, 16px)));
    }

    .image-with-text--classes .image-with-text__content {
      max-width: none;
      padding: 0;
      margin: 0;
    }

    .image-with-text--classes .image-with-text__section-heading {
      font-size: 30px;
      margin-bottom: 32px;
      text-align: left;
    }

    .image-with-text--classes .image-with-text__content {
