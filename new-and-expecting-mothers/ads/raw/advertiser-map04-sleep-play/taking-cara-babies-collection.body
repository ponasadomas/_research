  <script>
    (function () {
      const root = document.querySelector('.image-with-text--template--27940955750624__custom_image_with_text_7YW64C');
      if (!root) return;

      const button = root.querySelector('.image-with-text__video-play');
      const video = root.querySelector('.image-with-text__video');
      if (!button || !video) return;

      // Figma shows the poster with a play badge, so the native chrome only
      // appears once playback has actually started.
      button.addEventListener('click', function () {
        video.controls = true;
        button.hidden = true;
        video.play();
      });
    })();
  </script>



