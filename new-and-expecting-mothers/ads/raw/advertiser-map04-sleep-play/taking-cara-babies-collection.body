</section><section id="shopify-section-template--27940955750624__custom_product_reviews_p87cP4" class="shopify-section c-reviews-widget"><link href="//www.takingcarababies.com/cdn/shop/t/96/assets/custom-reviews-widget.css?v=47071440924170866251791531940" rel="stylesheet" type="text/css" media="all" />
<script src="https://widget.reviews.io/polaris/build.js"></script>
<h2 id="reviews" class="c-reviews-widget__title">What Parents Are Saying</h2>
<div id="ReviewsWidget"></div>
<script>
  new ReviewsWidget('#ReviewsWidget', {
