<link href="//www.takingcarababies.com/cdn/shop/t/96/assets/custom-header.css?v=115843324907780227541791531941" rel="stylesheet" type="text/css" media="all" />




<style>
  #c-page__cart .header[data-scroll-direction='none']:not([data-sticky-state]) .header__row,
  #c-page__product:not(
      [data-template='product'],
      [data-template='product.jacky-pdp'],
      :has(.c-product-information):not(:has(.c-product__layout--gift-card)),
      [data-template='product.product-class-bundle'],
      [data-template='product.the-5-24-month-collection'],
      [data-template='product.toddler-sleep-training'],
      [data-template='404'],
      [data-template='cart']
    ):not(:has(.c-hero-section--has-image))
    .header[data-scroll-direction='none']:not([data-sticky-state])
    .header__row,
  #c-page__blank .header[data-scroll-direction='none']:not([data-sticky-state]) .header__row,
  #c-page__cart .header[data-scroll-direction='none'][data-sticky-state='inactive'] .header__row,
  #c-page__product:not(
      [data-template='product'],
      [data-template='product.jacky-pdp'],
      :has(.c-product-information):not(:has(.c-product__layout--gift-card)),
      [data-template='product.product-class-bundle'],
      [data-template='product.the-5-24-month-collection'],
      [data-template='product.toddler-sleep-training'],
      [data-template='404'],
      [data-template='cart']
    ):not(:has(.c-hero-section--has-image))
    .header[data-scroll-direction='none'][data-sticky-state='inactive']
    .header__row,
  #c-page__blank .header[data-scroll-direction='none'][data-sticky-state='inactive'] .header__row {
    background-color: var(--color-white) !important;
  }

  #c-page__product:has(.c-hero-section--has-image)
    .header[data-scroll-direction='none']:not([data-sticky-state])
    .header__row,
  #c-page__product:has(.c-hero-section--has-image)
    .header[data-scroll-direction='none'][data-sticky-state='inactive']
    .header__row {
    background-color: var(--color-light-teal) !important;
  }#c-page__product .header[transparent]:not([data-sticky-state='active']) .header__row,
  #c-page__product .header[transparent] .header__columns,
  #c-page__product .header-section:has(.header[transparent]),
  #c-page__product #header-component[transparent] {
    background-color: transparent !important;
  }

  #c-page__product .header[transparent]:not([data-sticky-state='active']) .header__row .header-logo .header-logo__image {
    display: none;
  }

  #c-page__product .header[transparent]:not([data-sticky-state='active']) .header__row .header-logo .header-logo__image--inverse {
    display: block;
  }

  #c-page__product .header[transparent]:not([data-sticky-state='active']) .header-menu .menu-list__link .menu-list__link-title,
  #c-page__product .header[transparent]:not([data-sticky-state='active']) .header-actions__label {
    color: var(--color-white) !important;
  }

  #c-page__product .header[transparent]:not([data-sticky-state='active']) .header-menu .menu-list__link svg {
    color: var(--color-white);
  }

  /* Mobile header icons are mask-image glyphs tinted by background-color, not fills. */
  #c-page__product .header[transparent]:not([data-sticky-state='active']) .header__row :is(
      .header-drawer-icon:not(.header-drawer-icon--close),
      search-button .svg-wrapper,
      .account-actions__icon,
      .header-actions__cart-icon .svg-wrapper
    ) {
    background-color: var(--color-white) !important;
  }

  /* Pages, collections and gradient/image product heroes let their artwork run
     up behind the header, so the header contents need the inverse treatment for
     as long as the row is still see-through. */
  :is(
      #c-page__page,
      #c-page__article,
      #c-page__blog,
      #c-page__collection,
      #c-page__product:has(.c-hero-section--has-image)
    )
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    .header__row
    .header-logo
    .header-logo__image {
    display: none;
  }

  :is(
      #c-page__page,
      #c-page__article,
      #c-page__blog,
      #c-page__collection,
      #c-page__product:has(.c-hero-section--has-image)
    )
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    .header__row
    .header-logo
    .header-logo__image--inverse {
    display: block;
  }

  :is(
      #c-page__page,
      #c-page__article,
      #c-page__blog,
      #c-page__collection,
      #c-page__product:has(.c-hero-section--has-image)
    )
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    :is(.header-menu .menu-list__link .menu-list__link-title, .header-actions__label) {
    color: var(--color-white) !important;
  }

  :is(
      #c-page__page,
      #c-page__article,
      #c-page__blog,
      #c-page__collection,
      #c-page__product:has(.c-hero-section--has-image)
    )
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    .header-menu
    .menu-list__link
    svg {
    color: var(--color-white);
  }

  :is(
      #c-page__page,
      #c-page__article,
      #c-page__blog,
      #c-page__collection,
      #c-page__product:has(.c-hero-section--has-image)
    )
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    .header__row :is(
      .header-drawer-icon:not(.header-drawer-icon--close),
      search-button .svg-wrapper,
      .account-actions__icon,
      .header-actions__cart-icon .svg-wrapper
    ) {
    background-color: var(--color-white) !important;
  }

  #c-page__index:has(.c-hero-section--classes, .c-hero-section:not(.c-hero-section--text))
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    .header__row
    .header-logo
    .header-logo__image {
    display: none;
  }

  #c-page__index:has(.c-hero-section--classes, .c-hero-section:not(.c-hero-section--text))
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    .header__row
    .header-logo
    .header-logo__image--inverse {
    display: block;
  }

  #c-page__index:has(.c-hero-section--classes, .c-hero-section:not(.c-hero-section--text))
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    :is(.header-menu .menu-list__link .menu-list__link-title, .header-actions__label) {
    color: var(--color-white) !important;
  }

  #c-page__index:has(.c-hero-section--classes, .c-hero-section:not(.c-hero-section--text))
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    .header-menu
    .menu-list__link
    svg {
    color: var(--color-white);
  }

  #c-page__index:has(.c-hero-section--classes, .c-hero-section:not(.c-hero-section--text))
    .header[data-scroll-direction='none']:not([data-sticky-state='active'])
    .header__row :is(
      .header-drawer-icon:not(.header-drawer-icon--close),
      search-button .svg-wrapper,
      .account-actions__icon,
      .header-actions__cart-icon .svg-wrapper
    ) {
    background-color: var(--color-white) !important;
  }

  @media screen and (min-width: 1024px) {
    #c-page__page[data-template='page.meet-cara']
      .header[data-scroll-direction='none']:not([data-sticky-state='active'])
      .header__row
      .header-logo
      .header-logo__image {
      display: block;
    }

    #c-page__page[data-template='page.meet-cara']
      .header[data-scroll-direction='none']:not([data-sticky-state='active'])
      .header__row
      .header-logo
      .header-logo__image--inverse {
      display: none;
    }

    #c-page__page[data-template='page.meet-cara']
      .header[data-scroll-direction='none']:not([data-sticky-state='active'])
      :is(.header-menu .menu-list__link .menu-list__link-title, .header-actions__label) {
      color: var(--color-brand-green) !important;
    }

    #c-page__page[data-template='page.meet-cara']
      .header[data-scroll-direction='none']:not([data-sticky-state='active'])
      .header-menu
      .menu-list__link
      svg {
      color: var(--color-brand-green);
      fill: var(--color-brand-green);
    }

    #c-page__page[data-template='page.meet-cara']
