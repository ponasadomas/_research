2CmacRequiredCapabilities%2CmedicalDeviceInfo%2CmessagesScreenshots%2CminiGamesDeepLink%2CminimumOSVersion%2Cprivacy%2CprivacyDetails%2CprivacyPolicyUrl%2CremoteControllerRequirement%2CrequirementsByDeviceFamily%2CsellerInfo%2CsupportURLForLanguage%2CsupportedGameCenterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CgamesUrl%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=categorizations%2Ctop-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1518127990","platform":"iphone"}}},{"$kind":"Lockup","title":"The Short Years Baby Book","adamId":"1327539226","impressionMetrics":{"fields":{"id":"1327539226","name":"The Short Years Baby Book","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":3,"contentRating":100,"bundleId":"com.unboundapplications.theshortyears"}},"bundleId":"com.unboundapplications.theshortyears","isEditorsChoice":false,"subtitle":"Baby books on your phone","rating":4.9,"ratingCount":"4.8K","decorations":[],"icon":{"$kind":"Artwork","crop":"Icon.ApSiOS01","template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/9f/f5/92/9ff592cc-8645-5569-3bb7-18ca6b21a563/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}],"backgroundColor":{"red":0.9921568627450981,"green":0.9568627450980393,"blue":0.9215686274509803,"type":"rgb"},"textColor":{"red":0.07450980392156863,"green":0.06666666666666667,"blue":0.058823529411764705,"type":"rgb"},"style":"roundedRectPrerendered"},"isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Baby books on your phone","ageRating":"4+","productDescription":"Download The Short Years app and create your first baby book chapter in just five minutes!\n\nOnce a week, The Short Years App will remind you to upload a photo and answer a couple of questions about your baby’s milestones and special moments.  Many parents tell us they do this while feeding their baby or watching a show on Netflix.\n\nWe’ll turn your text, photos, and even video into beautiful baby book pages!\n\nOnce you’ve purchased your book, we will start printing and shipping your pages to you every time you complete three chapters in the app.  Just pop them in your book!\n\nAnd, if you want to capture all of the sweet memories until your baby turns five, simply add on “The Toddler Years” at checkout. Doing so will allow you to access The Toddler Years chapters in your app and to receive these extra chapters in print to add to your baby book. \n\nThe Short Years Baby Book has a premium fabric cover, handcrafted to stand up to a lifetime of enjoyment and measuring 11.5” x 9.25”. It is bound with three matte black rings, making adding pages to it a breeze.\n\nThe book includes:\n\n*19 chapter covers (+ an additional 5 if you upgrade to The Toddler Years) for easily organizing your book’s pages as they are shipped to you.\n*Hands and feet prints pages to take with you to the hospital or birth center.\n*Six lined journaling pages for jotting down extra notes \n*Personalized name card for cover\n*Free printing and shipping of all 119 of your baby book pages documenting baby’s first year.\n\nDiscover the easiest way to document and cherish your sweet one’s first year! ","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"shouldFlush":false,"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1327539226&pricingParameters=STDQ&pg=default&appExtVrsId=892874421"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1327539226"},{"locationPosition":3,"locationType":"lockup","name":"The Short Years Baby Book","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1327539226"},{"locationPosition":15,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1327539226","eventType":"click","targetType":"button","targetId":"1327539226","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified"}],"custom":{"jet_adamId":"1327539226"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1327539226","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=1327539226&pricingParameters=STDQ&pg=default&appExtVrsId=892874421","vendor":"Unbound Applications","appName":"The Short Years Baby Book","bundleId":"com.unboundapplications.theshortyears","appPlatforms":["phone","pad"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload":false,"preflightPackageUrl":null,"isArcadeApp":false,"isHalva":true,"supportsVisionOSCompatibleIOSBinary":false,"remoteDownloadIdentifiers":[],"hasMacIPAPackage":false,"contentRating":100,"pageInformation":{"baseFields":{"serverInstance":"10001","storeFrontHeader":"us","language":"en",