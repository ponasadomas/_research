shot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified"}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"product","pageUrl":"https://apps.apple.com/us/app/baby-led-weaning-recipes/id1114320457","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","referrerUrl":"https://amp-api-edge.apps.apple.com/v1/catalog/us/apps/1382444112?platform=web&additionalPlatforms=appletv%2Cipad%2Ciphone%2Cmac%2CrealityDevice%2Cwatch&extend=accessibility%2CaccessibilityDetails%2CageRating%2CbackgroundAssetsInfo%2CbackgroundAssetsInfoWithOptional%2CcustomArtwork%2CcustomCreativeArtworks%2CcustomCreativeVideos%2CcustomDeepLink%2CcustomIconArtwork%2CcustomPromotionalText%2CcustomScreenshotsByType%2CcustomVideoPreviewsByType%2Cdescription%2CexpectedReleaseDateDisplayFormat%2CfileSizeByDevice%2CgameDisplayName%2CiconArtwork%2CinstallSizeByDeviceInBytes%2CmacRequiredCapabilities%2CmedicalDeviceInfo%2CmessagesScreenshots%2CminiGamesDeepLink%2CminimumOSVersion%2Cprivacy%2CprivacyDetails%2CprivacyPolicyUrl%2CremoteControllerRequirement%2CrequirementsByDeviceFamily%2CsellerInfo%2CsupportURLForLanguage%2CsupportedGameCenterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CgamesUrl%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=categorizations%2Ctop-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1114320457","platform":"iphone"}}},{"$kind":"Lockup","title":"Baby Notebook - Photo Book","adamId":"1518127990","impressionMetrics":{"fields":{"id":"1518127990","name":"Baby Notebook - Photo Book","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":2,"contentRating":100,"bundleId":"com.babynotebookapp.babynotebook"}},"bundleId":"com.babynotebookapp.babynotebook","isEditorsChoice":false,"subtitle":"Monthly Pictures & Album Maker","rating":4.8,"ratingCount":"2K","decorations":[],"icon":{"$kind":"Artwork","crop":"Icon.ApSiOS01","template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource211/v4/79/12/d1/7912d197-aeb9-ebfd-8d74-356af4f007a1/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}],"backgroundColor":{"red":1,"green":1,"blue":1,"type":"rgb"},"textColor":{"red":0.047058823529411764,"green":0.050980392156862744,"blue":0.058823529411764705,"type":"rgb"},"style":"roundedRectPrerendered"},"isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Monthly Pictures & Album Maker","ageRating":"4+","productDescription":"Baby Notebook—the modern baby book every parent needs—reminders for milestones, upload photos in the moment, and order a beautiful hardbound baby book at the end of baby's first year.\n\nWe‘re here to help you *actually* complete a memory book for baby’s first year and beyond. \n\nCONVENIENT\nNo more sifting through photos, printing, cutting, and pasting, it's all done right on your phone.\n\nREMINDERS\nNever miss a beat with Baby Notebook’s weekly notifications reminding you to upload a photo or answer a writing prompt. Schedule your notifications in the app to receive your prompts on a day and time that works best for you.\n\nCUSTOMIZABLE\nEdit titles in your book to tell your baby’s unique story. Designed with inclusivity in mind, the Baby Notebook app empowers all parents—single parents, LGBTQIA parents, and parents of multiples—to complete a meaningful baby book for their little one.\n\nFLEXIBLE\nHide pages, replace page layouts, and rearrange pages in your book to ensure you can actually complete your baby book (no pages left blank).\n\nMODERN BABY BOOK\nAll the design work is done for you—no formatting required. It is modern, clean, and timeless. \n\nADDITIONAL PAGES\nYou can add more pages to your book (at an additional cost). This feature allows you to add more photo pages, special occasions, quote pages, and a second baby to your book (for twin Mamas)!\n\nYOUR BABY’S FIRST YEAR ONLY HAPPENS ONCE\nYou'll find our prices comparable to any quality photo book, but you won't have to do the formatting, prompt writing, and remembering — we've got you, mama. Just think, you'll have this gorgeous book at the end of your baby's first year with all these beautiful photos, and you didn't have to do much to get it done. THAT'S PRICELESS! Make your baby's first year last a lifetime—your future self will thank you.\n\nHear it from a mom who has received her baby book—“This book is beautiful. I am blown away by the quality of this book! It was so easy to add pictures and write notes. I’m so grateful for this baby book, and have already started the toddler book! This is priceless!”\n\nContinue documenting baby’s life with our yearly books:\n\nTODDLER BOOK\nAs your baby turns one, continue documenting their journey with Baby Notebook’s Toddler Book. Capture every milestone and precious moment from 12-24 months.\n\nTHE MAGIC YEARS BOOK\nWatch your baby grow into a little person with our Magic Years Book. Document quotes, conversations, photos, and artwork created by your child from 24-36 months.\n\nTHE FAMILY YEARBOOK\nAs your family grows, so do your memories. With Baby Notebook's Family Yearbook, capture every special (or ordinary) moment throughout the year. Build your book in real-time, ensuring you never miss a beat.\n\nDOWNLOAD FOR FREE\nGet started today with Baby Notebook for FREE and access the first 3 chapters of your book.\n\nPREMIUM SUBSCRIPTION\nUpgrade to our Premium subscription, which includes a 7-day FREE trial for first-time subscribers, then $49.99 per year (paid annually). Enjoy the BEST VALUE with our Premium plan, and receive 40% off your book(s), that’s $99 + shipping. \n\nPLUS SUBSCRIPTION\nOpt for our monthly Plus subscription plan for $6.99 per month and pay the full price of $165 for the book.\n\nPAID SUBSCRIBER BENEFITS\n- Full access to books: Baby, Toddler, Magic Years & Family Yearbook\n- Weekly prompts & reminders\n- Create books for multiple children\n- Personalized notification settings\n- Hide pages, edit titles & choose prompts\n- Replace page layouts & rearrange pages\n- Advanced photo editor & filters\n- Shuffle photos \n- Add pages (at an additional cost)\n- 12” x 12” books available for purchase, 100+ pages per book\n\nDownload the Baby Notebook app now and start preserving your baby’s memories today!\n\nFor support inquiries, email us at hello@babynotebook.app.\n\nYou can find our privacy policy and terms of service, here https://babynotebookapp.com/privacy and https://babynotebookapp.com/terms\n\nLearn more about Baby Notebook at www.babynotebookapp.com","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"shouldFlush":false,"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1518127990&pricingParameters=STDQ&pg=default&appExtVrsId=889801544"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1518127990"},{"locationPosition":2,"locationType":"lockup","name":"Baby Notebook - Photo Book","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1518127990"},{"locationPosition":15,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1518127990","eventType":"click","targetType":"button","targetId":"1518127990","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified"}],"custom":{"jet_adamId":"1518127990"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1518127990","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=1518127990&pricingParameters=STDQ&pg=default&appExtVrsId=889801544","vendor":"Baby Notebook LLC","appName":"Baby Notebook - Photo Book","bundleId":"com.babynotebookapp.babynotebook","appPlatforms":["phone","pad"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload":false,"preflightPackageUrl":null,"isArcadeApp":false,"isHalva":true,"supportsVisionOSCompatibleIOSBinary":false,"remoteDownloadIdentifiers":[],"hasMacIPAPackage":false,"contentRating":100,"pageInformation":{"baseFields":{"serverInstance":"10001","storeFrontHeader":"us","language":"en","storeFront":"us","environmentDataCenter":"DU00-RDC","pageType":"Software","pageId":"1382444112","pageDetails":"Little Ones™_Little Ones: Baby Sleep","platformDisplayStyle":"ios"},"timingMetrics":{"parseStartTime":1792878455062,"parseEndTime":1792878455064},"pageUrl":"https://amp-api-edge.apps.apple.com/v1/catalog/us/apps/1382444112?platform=web&additionalPlatforms=appletv%2Cipad%2Ciphone%2Cmac%2CrealityDevice%2Cwatch&extend=accessibility%2CaccessibilityDetails%2CageRating%2CbackgroundAssetsInfo%2CbackgroundAssetsInfoWithOptional%2CcustomArtwork%2CcustomCreativeArtworks%2CcustomCreativeVideos%2CcustomDeepLink%2Ccustom