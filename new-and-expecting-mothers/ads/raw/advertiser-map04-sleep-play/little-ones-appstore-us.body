Soother app. Inspired by WeeSleep™ experts, the MyVTech Soother app works with the V-Hush product series providing subscription free access to expert advice and features that enable better, longer sleep for the whole family. Easily access professional sleep tips and tools that encourage healthy sleep habits using the colorful night light, glow-on-the-ceiling projector, and powerful Bluetooth Speaker. Craft custom sleep-inducing atmospheres by selecting from over 200 pre-programmed stories, classical music, calming lullabies and soothing sounds, or stream from your favorite smartphone music service. Record and upload your own voice, songs, or stories to comfort your little one to sleep. \r\n• Adjust night light color and brightness\r\n• Select from hundreds of stories, songs and sounds\r\n• Create your own personal recordings\r\n• Stream music to the Bluetooth speaker\r\n• Select and control projection\r\n• Create custom alarms or nap timers\r\n","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"shouldFlush":false,"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1576144196&pricingParameters=STDQ&pg=default&appExtVrsId=887423421"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1576144196"},{"locationPosition":5,"locationType":"lockup","name":"MyVTechSoother","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1576144196"},{"locationPosition":15,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1576144196","eventType":"click","targetType":"button","targetId":"1576144196","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appSta