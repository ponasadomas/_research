":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false,"id":"informationRibbon"},"productRatings":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"18","name":"Ratings & Reviews","impressionType":"ratingsOverview","idType":"sequential","impressionIndex":2}},"contentType":"productRatings","marker":null,"items":[{"$kind":"Ratings","productId":"1382444112","ratingAverage":3.3,"totalNumberOfRatings":158,"context":"productPage","ratingCounts":[72,18,8,11,49]}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":{"title":"See All","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"shouldFlush":false,"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/app/1382444112?see-all=reviews&platform=iphone","location":[{"locationPosition":2,"locationType":"lockup","name":"See All","idType":"its_id","id":"SeeAllReviews"}],"eventType":"click","targetType":"button","targetId":"SeeAllReviews","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified"},{"shouldFlush":false,"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/app/1382444112?see-all=reviews&platform=iphone","location":[{"locationPosition":2,"locationType":"lockup","name":"See All","idType":"its_id","id":"RatingsOverview"}],"eventType":"click","targetType":"button","targetId":"RatingsOverview","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified"},{"shouldFlush":false,"fields":{"actionType":"navigate","actionUrl":"https://apps.apple.com/us/app/1382444112?see-all=reviews&platform=iphone","location":[{"locationPosition":2,"locationType":"lockup","name":"See All","idType":"its_id","id":"RatingsOverview"}],"eventType":"click","targetType":"button","targetId":"RatingsOverview","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified"}],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageUrl":"https://apps.apple.com/us/app/1382444112?see-all=reviews&platform=iphone","pageData":null,"presentationContext":"infer","animationBehavior":"infer","origin":"inapp","destination":{"storefront":"us","language":"en-US","platform":"iphone","id":"1382444112","see-all":"reviews","$kind":"SeeAllPageIntent"}},"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"title":"Ratings & Reviews","titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false,"id":"productRatings"},"allProductReviews":{"$kind":"Shelf","impressionMetrics":null,"contentType":"productReview","marker":null,"items":[{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"14098587804","title":"Life Line for New Parents","contents":"For our first kid we tried multiple sleep training apps before finding Little Ones. The schedule made sense (we didn’t closely follow the feeding schedule but stuck to the sleeping recommendations) and the guides on gentle sleep training methods based on our comfort level worked when nothing else would! Their guide to taking away the pacifier when the time was right was a life saver for me! I shared this app with many friends and for my 2nd child started from day 1 newborn. Her sleep schedule is predictable, we get to go out with big brother and it’s been such a contrast to the early struggles I remember. The community is helpful on every topic. \n\nOnly tip to watch out for is that the consulting assumes strictly following schedule. If you are not then the broad tips still help but talking to the consultants doesn’t result in direct help.\n\nHighly recommend to know what to do for sleep for your Little One!","rating":4,"reviewerName":"Thinklazy","date":"2026-05-23T23:50:50.000Z","dateText":"* null *","dateAuthorText":"* null * · Thinklazy","response":{"$kind":"Response","id":"62640299","contents":"Thank you for sharing such a thoughtful review. We’re so glad the schedules, gentle sleep guidance and transition support helped both of your children and gave you more confidence along the way.\n\nWe also appreciate your feedback about consultant support. Our consultants personalise advice based on the information shared, and the more closely a family is following the schedule framework, the more specific that guidance can often be. We’re grateful for your recommendation and for sharing Little Ones with so many other families. ","date":"2026-06-01T00:57:39.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"2","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"14098587804","title":"Life Line for New Parents","contents":"For our first kid we tried multiple sleep training apps before finding Little Ones. The schedule made sense (we didn’t closely follow the feeding schedule but stuck to the sleeping recommendations) and the guides on gentle sleep training methods based on our comfort level worked when nothing else would! Their guide to taking away the pacifier when the time was right was a life saver for me! I shared this app with many friends and for my 2nd child started from day 1 newborn. Her sleep schedule is predictable, we get to go out with big brother and it’s been such a contrast to the early struggles I remember. The community is helpful on every topic. \n\nOnly tip to watch out for is that the consulting assumes strictly following schedule. If you are not then the broad tips still help but talking to the consultants doesn’t result in direct help.\n\nHighly recommend to know what to do for sleep for your Little One!","rating":4,"reviewerName":"Thinklazy","date":"2026-05-23T23:50:50.000Z","dateText":"* null *","dateAuthorText":"* null * · Thinklazy","response":{"$kind":"Response","id":"62640299","contents":"Thank you for sharing such a thoughtful review. We’re so glad the schedules, gentle sleep guidance and transition support helped both of your children and gave you more confidence along the way.\n\nWe also appreciate your feedback about consultant support. Our consultants personalise advice based on the information shared, and the more closely a family is following the schedule framework, the more specific that guidance can often be. We’re grateful for your recommendation and for sharing Little Ones with so many other families. ","date":"2026-06-01T00:57:39.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1382444112","targetReviewId":"14098587804"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"id":"14098587804","impressionMetrics":{"fields":{"id":"14098587804","name":"","impressionType":"helpfulReview","idType":"its_id","impressionIndex":0}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"8260163764","title":"Saved my sanity","contents":"I found this program one sleepless night with my 4 month old. I would spend my nights searching for help for my baby who didn’t sleep. The only way I could get him asleep was to rock him asleep, then hold him for 30-60 minutes until I could put him down. Otherwise , he woke right up when I put him down. That was for every nap, and multiple times per night. Two family members told me about Healthy Sleep, Happy Baby, and how their husbands had to stop them from going into their baby’s room when the baby was crying inconsolably. My aunt even gave me the book. First of all, as a sleep deprived mom, I did not have the time or mental energy to read such a large book. Secondly, we refused to let our baby cry like that.  So finding this program was just what I needed. The app makes it so easy to know when to feed your baby and when he needs sleep. I was able to get started immediately, I didn’t have to read extensively before implementing it, which is what you need when you are desperate for sleep. I started out just trying to get my baby on the sleep schedule. After a few weeks of that, one night my baby woke up every two hours and I said it was time to try self settling. When the program said that the goal was to put your baby down wide awake, and letting him put himself asleep, I thought that was a wild fantasy! And now, several weeks later, my baby usually will put himself to sleep. I am amazed! I loved the gentle approach to sleep training. I didn’t feel like I was punishing or neglecting my baby. It definitely took persistence, and my baby still isn’t perfectly in sync with the program, but I now have a schedule for the day, and we are all getting more sleep and are all happier. I can’t thank you enough for this program! I would recommend it to anyone! I only wish I knew about it sooner!","rating":5,"reviewerName":"reviewfrog","date":"2022-01-20T01:33:24.000Z","dateText":"* null *","dateAuthorText":"* null * · reviewfrog","response":{"$kind":"Response","id":"27638245","contents":"Thank you for your lovely review and so glad we were able to help.","date":"2022-01-24T20:46:59.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"3","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"8260163764","title":"Saved my sanity","contents":"I found this program one sleepless night with my 4 month old. I would spend my nights searching for help for my baby who didn’t sleep. The only way I could get him asleep was to rock him asleep, then hold him for 30-60 minutes until I could put him down. Otherwise , he woke right up when I put him down. That was for every nap, and multiple times per night. Two family members told me about Healthy Sleep, Happy Baby, and how their husbands had to stop them from going into their baby’s room when the baby was crying inconsolably. My aunt even gave me the book. First of all, as a sleep deprived mom, I did not have the time or mental energy to read such a large book. Secondly, we refused to let our baby cry like that.  So finding this program was just what I needed. The app makes it so easy to know when to feed your baby and when he needs sleep. I was able to get started immediately, I didn’t have to read extensively before implementing it, which is what you need when you are desperate for sleep. I started out just trying to get my baby on the sleep schedule. After a few weeks of that, one night my baby woke up every two hours and I said it was time to try self settling. When the program said that the goal was to put your baby down wide awake, and letting him put himself asleep, I thought that was a wild fantasy! And now, several weeks later, my baby usually will put himself to sleep. I am amazed! I loved the gentle approach to sleep training. I didn’t feel like I was punishing or neglecting my baby. It definitely took persistence, and my baby still isn’t perfectly in sync with the program, but I now have a schedule for the day, and we are all getting more sleep and are all happier. I can’t thank you enough for this program! I would recommend it to anyone! I only wish I knew about it sooner!","rating":5,"reviewerName":"reviewfrog","date":"2022-01-20T01:33:24.000Z","dateText":"* null *","dateAuthorText":"* null * · reviewfrog","response":{"$kind":"Response","id":"27638245","contents":"Thank you for your lovely review and so glad we were able to help.","date":"2022-01-24T20:46:59.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1382444112","targetReviewId":"8260163764"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"id":"8260163764","impressionMetrics":{"fields":{"id":"8260163764","name":"","impressionType":"helpfulReview","idType":"its_id","impressionIndex":1}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"6245646719","title":"Save yourself the heartache","contents":"Buying this program was the biggest mistake that I made in my baby’s first year. My baby had a very difficult time syncing with their schedule, and it often turned me into a stressed out mama trying to force sleep on her baby when it was the last thing in the world she wanted. We both ended up in tears several times. In addition I personally found their expert feedback to be somewhat lazy. If you’re having an issue and you’re not on their schedule to the T, they deem your baby as overtired. I can’t tell you how many times I’ve been told that my baby is overtired- how is a baby that gets 10 more minutes of daytime sleep than they recommend overtired? I feel that they’re belief that the schedule is the be all end all prevents their sleep consultants from thinking more critically about what is causing issues- if your baby is not perfectly on the schedule then they assume that’s the problem, and they don’t go much deeper than that. I also was completely unprepared for the 4 month regression when it hit. Had I known you can begin teaching a baby to sleep independently before that, then I could have avoided a lot of that pain. I found the courses and sleep consultants from Taking Cara Babies much more helpful.","rating":1,"reviewerName":"missaprilkat","date":"2020-07-26T23:54:13.000Z","dateText":"* null *","dateAuthorText":"* null * · missaprilkat","response":{"$kind":"Response","id":"18130186","contents":"Hi there, Sorry to hear you are disappointed in the Program, You can email customerservice@littleones.co to discuss your eligibility for a refund.","date":"2020-09-27T23:14:06.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"4","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"6245646719","title":"Save yourself the heartache","contents":"Buying this program was the biggest mistake that I made in my baby’s first year. My baby had a very difficult time syncing with their schedule, and it often turned me into a stressed out mama trying to force sleep on her baby when it was the last thing in the world she wanted. We both ended up in tears several times. In addition I personally found their expert feedback to be somewhat lazy. If you’re having an issue and you’re not on their schedule to the T, they deem your baby as overtired. I can’t tell you how many times I’ve been told that my baby is overtired- how is a baby that gets 10 more minutes of daytime sleep than they recommend overtired? I feel that they’re belief that the schedule is the be all end all prevents their sleep consultants from thinking more critically about what is causing issues- if your baby is not perfectly on the schedule then they assume that’s the problem, and they don’t go much deeper than that. I also was completely unprepared for the 4 month regression when it hit. Had I known you can begin teaching a baby to sleep independently before that, then I could have avoided a lot of that pain. I found the courses and sleep consultants from Taking Cara Babies much more helpful.","rating":1,"reviewerName":"missaprilkat","date":"2020-07-26T23:54:13.000Z","dateText":"* null *","dateAuthorText":"* null * · missaprilkat","response":{"$kind":"Response","id":"18130186","contents":"Hi there, Sorry to hear you are disappointed in the Program, You can email customerservice@littleones.co to discuss your eligibility for a refund.","date":"2020-09-27T23:14:06.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1382444112","targetReviewId":"6245646719"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"id":"6245646719","impressionMetrics":{"fields":{"id":"6245646719","name":"","impressionType":"helpfulReview","idType":"its_id","impressionIndex":2}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"8013291066","title":"Miracle program!","contents":"I was at my wit's end with my 4 month old all of a a sudden not sleeping more than an hour at a time for 3 weeks. I read and tried two popular books - Babywise and Healthy Sleep Habits, Happy Child but they did not help one bit. I found this program with Google's help and it is a lifesaver. It was hard at first, and my baby's sleep did get worse, but I stuck with it as the program said to and here I am on day 8 of the program and my baby is sleeping almost exactly to the schedule of the program. I feel like a new woman now that we are all getting sleep. We still have more work to do to get him more on track, but I have seen such an improvement that I'm so thankful for this program. \n\nReasons I love it:\n1. It's 100% geared toward the weeks of age my baby is and his developmental needs\n2. It sends you notifications on your phone when it's time to feed your baby milk or solids, when it's time to start getting them ready for their nap or bedtime, when it's time to wake them up, etc. \n3. They have a daily schedule to follow for your baby and also a troubleshooting schedule to follow with tips on what to do to get your baby back on track if they don't sleep well or miss feedings, etc. \n4. Tons of quick read educational materials to better learn why your baby is having trouble sleeping, how to reach self-settling and more\n\nJust a great program and so worth the price. Getting a good night sleep is priceless to me.","rating":5,"reviewerName":"Jenjenchik","date":"2021-11-11T19:04:43.000Z","dateText":"* null *","dateAuthorText":"* null * · Jenjenchik","response":{"$kind":"Response","id":"26284642","contents":"Thank you so much for your lovely review! We would love to use this as a testimonial on our social channels. If that's ok with you can you please email customerservice@littleones.co\nThanks :)","date":"2021-11-15T20:28:25.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"5","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"8013291066","title":"Miracle program!","contents":"I was at my wit's end with my 4 month old all of a a sudden not sleeping more than an hour at a time for 3 weeks. I read and tried two popular books - Babywise and Healthy Sleep Habits, Happy Child but they did not help one bit. I found this program with Google's help and it is a lifesaver. It was hard at first, and my baby's sleep did get worse, but I stuck with it as the program said to and here I am on day 8 of the program and my baby is sleeping almost exactly to the schedule of the program. I feel like a new woman now that we are all getting sleep. We still have more work to do to get him more on track, but I have seen such an improvement that I'm so thankful for this program. \n\nReasons I love it:\n1. It's 100% geared toward the weeks of age my baby is and his developmental needs\n2. It sends you notifications on your phone when it's time to feed your baby milk or solids, when it's time to start getting them ready for their nap or bedtime, when it's time to wake them up, etc. \n3. They have a daily schedule to follow for your baby and also a troubleshooting schedule to follow with tips on what to do to get your baby back on track if they don't sleep well or miss feedings, etc. \n4. Tons of quick read educational materials to better learn why your baby is having trouble sleeping, how to reach self-settling and more\n\nJust a great program and so worth the price. Getting a good night sleep is priceless to me.","rating":5,"reviewerName":"Jenjenchik","date":"2021-11-11T19:04:43.000Z","dateText":"* null *","dateAuthorText":"* null * · Jenjenchik","response":{"$kind":"Response","id":"26284642","contents":"Thank you so much for your lovely review! We would love to use this as a testimonial on our social channels. If that's ok with you can you please email customerservice@littleones.co\nThanks :)","date":"2021-11-15T20:28:25.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1382444112","targetReviewId":"8013291066"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"id":"8013291066","impressionMetrics":{"fields":{"id":"8013291066","name":"","impressionType":"helpfulReview","idType":"its_id","impressionIndex":3}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"6989925365","title":"Great Complement to a Great Program","contents":"We purchased the little ones program when our oldest kid was around 4 months old because we were having trouble getting them to sleep properly. We had read countless books, Google, you name it, but little ones simplified all the noise and presented an easy to follow program that worked. The program is not magic, every kid is different, you need to figure out what will work best for your kid. The program has been so successful for us we have used for all of our kids and could not be happier!\n\nThis app is the perfect compliment to the little ones program. It takes and already easy program and makes it even simpler with notifications and coming up next alerts. Best part of all you can have all your individual kids programs separate. Just scroll between kids to find out who should be doing what when.\n\nOverall the app and the programs work great and I could not be happier.","rating":5,"reviewerName":"Rubbles07","date":"2021-02-13T16:46:30.000Z","dateText":"* null *","dateAuthorText":"* null * · Rubbles07","response":{"$kind":"Response","id":"21196771","contents":"Thank you so much for your lovely review!!","date":"2021-02-22T00:23:51.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"6","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"6989925365","title":"Great Complement to a Great Program","contents":"We purchased the little ones program when our oldest kid was around 4 months old because we were having trouble getting them to sleep properly. We had read countless books, Google, you name it, but little ones simplified all the noise and presented an easy to follow program that worked. The program is not magic, every kid is different, you need to figure out what will work best for your kid. The program has been so successful for us we have used for all of our kids and could not be happier!\n\nThis app is the perfect compliment to the little ones program. It takes and already easy program and makes it even simpler with notifications and coming up next alerts. Best part of all you can have all your individual kids programs separate. Just scroll between kids to find out who should be doing what when.\n\nOverall the app and the programs work great and I could not be happier.","rating":5,"reviewerName":"Rubbles07","date":"2021-02-13T16:46:30.000Z","dateText":"* null *","dateAuthorText":"* null * · Rubbles07","response":{"$kind":"Response","id":"21196771","contents":"Thank you so much for your lovely review!!","date":"2021-02-22T00:23:51.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1382444112","targetReviewId":"6989925365"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"id":"6989925365","impressionMetrics":{"fields":{"id":"6989925365","name":"","impressionType":"helpfulReview","idType":"its_id","impressionIndex":4}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"11484809726","title":"Honest new mom review","contents":"The app itself could use a little work but my god did the program change my life. It made me like my baby again. We’ve only been using it for 3 days so far and it has changed my outlook on being a parent, I might actually consider having a second lol. I am not able to follow the program to a T because of work, however we use the general idea and schedule then shift as needed in small amounts. We’re three nights in a row of only waking up once around 3 AM to eat. She’s 3 1/2 months old. This is after coming off of waking every two hours and not being able to settle back down for over a week. I was going insane because I was getting about an hour of sleep total per night. Not only is she sleeping better and learning to settle herself but she’s also sleeping in her bassinet, which before was the entire reason she wouldn’t sleep at all. GAME CHANGER!","rating":4,"reviewerName":"Mewalt","date":"2024-07-12T14:40:18.000Z","dateText":"* null *","dateAuthorText":"* null * · Mewalt","response":{"$kind":"Response","id":"45257981","contents":"This is so great to hear! Thank you for your review ","date":"2024-07-14T20:40:19.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"7","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"11484809726","title":"Honest new mom review","contents":"The app itself could use a little work but my god did the program change my life. It made me like my baby again. We’ve only been using it for 3 days so far and it has changed my outlook on being a parent, I might actually consider having a second lol. I am not able to follow the program to a T because of work, however we use the general idea and schedule then shift as needed in small amounts. We’re three nights in a row of only waking up once around 3 AM to eat. She’s 3 1/2 months old. This is after coming off of waking every two hours and not being able to settle back down for over a week. I was going insane because I was getting about an hour of sleep total per night. Not only is she sleeping better and learning to settle herself but she’s also sleeping in her bassinet, which before was the entire reason she wouldn’t sleep at all. GAME CHANGER!","rating":4,"reviewerName":"Mewalt","date":"2024-07-12T14:40:18.000Z","dateText":"* null *","dateAuthorText":"* null * · Mewalt","response":{"$kind":"Response","id":"45257981","contents":"This is so great to hear! Thank you for your review ","date":"2024-07-14T20:40:19.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1382444112","targetReviewId":"11484809726"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"id":"11484809726","impressionMetrics":{"fields":{"id":"11484809726","name":"","impressionType":"helpfulReview","idType":"its_id","impressionIndex":5}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"4409563422","title":"Terrible UI, inflexible support and repetitive advice","contents":"This app is annoying to use from a UI standpoint. There is a forum with extensive information - previously asked questions similar to ones you have  with answers. They are impossible to find though because there is NO SEARCH function anywhere in the app. Same goes for their articles. If you want to find something you have to use their categories and then just scroll through everything hoping to find what you want. \n\nThis might be excusable if the information you got or the support was outstanding, but it's not. If your kid doesn't thrive under their strict and inflexible schedule, they don't ever help you adjust it. Here's what happens when you ask for help: \n\nYou: my child isn't sleeping the way your schedule says they will. I'm doing everything you say and it isn't working.\n\nThem: you must be doing something wrong. What are you feeding them? Is the room pitch black? Are you using a noise machine? Is the baby cold? \n\nYou: I'm feeding what and when you say exactly, yes the room is darker than a cave, yes noise machine, no not cold. \n\nThem:.... silence for several days... you must be patient. Keep trying! Make sure their room is dark. \n\nI suggest saving yourself some time and money and just use awake windows appropriate for your child, using a noise machine and blackout curtains. Let your baby cry a little using an increment method so they learn to go to sleep on their own. That's essentially all this is.","rating":2,"reviewerName":"Hand Hugs","date":"2019-07-04T13:04:13.000Z","dateText":"* null *","dateAuthorText":"* null * · Hand Hugs","moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"8","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"4409563422","title":"Terrible UI, inflexible support and repetitive advice","contents":"This app is annoying to use from a UI standpoint. There is a forum with extensive information - previously asked questions similar to ones you have  with answers. They are impossible to find though because there is NO SEARCH function anywhere in the app. Same goes for their articles. If you want to find something you have to use their categories and then just scroll through everything hoping to find what you want. \n\nThis might be excusable if the information you got or the support was outstanding, but it's not. If your kid doesn't thrive under their strict and inflexible schedule, they don't ever help you adjust it. Here's what happens when you ask for help: \n\nYou: my child isn't sleeping the way your schedule says they will. I'm doing everything you say and it isn't working.\n\nThem: you must be doing something wrong. What are you feeding them? Is the room pitch black? Are you using a noise machine? Is the baby cold? \n\nYou: I'm feeding what and when you say exactly, yes the room is darker than a cave, yes noise machine, no not cold. \n\nThem:.... silence for several days... you must be patient. Keep trying! Make sure their room is dark. \n\nI suggest saving yourself some time and money and just use awake windows appropriate for your child, using a noise machine and blackout curtains. Let your baby cry a little using an increment method so they learn to go to sleep on their own. That's essentially all this is.","rating":2,"reviewerName":"Hand Hugs","date":"2019-07-04T13:04:13.000Z","dateText":"* null *","dateAuthorText":"* null * · Hand Hugs"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1382444112","targetReviewId":"4409563422"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"id":"4409563422","impressionMetrics":{"fields":{"id":"4409563422","name":"","impressionType":"helpfulReview","idType":"its_id","impressionIndex":6}}},{"$kind":"ProductReview","componentType":"productReview","sourceType":"user","review":{"$kind":"Review","id":"5786283391","title":"Must follow the program exactly for success","contents":"My son has started going to bed by 7pm by himself in his own bed since 6 months. He is 14 months now. My son used to wake several times in the night. The first night I followed the program exactly he slept through the night. Then he would switch on and off between waking up once or twice which is much better than 4 - 6 times. By around 11ish months he was sleeping through the night.\n\n Some people were saying they’re annoyed they can’t just quickly search for things. I read everything so I just knew where to find things when I had questions. As I said if you don’t follow the program exactly you won’t be successful. I’ve bought tons of products that were supposed to help my baby sleep. This is the only thing that worked for me.","rating":5,"reviewerName":"samm_denise","date":"2020-04-09T14:36:43.000Z","dateText":"* null *","dateAuthorText":"* null * · samm_denise","response":{"$kind":"Response","id":"18130197","contents":"Thank you for your review.","date":"2020-09-27T23:15:21.000Z","dateText":"* null *"},"moreAction":{"title":"Ratings & Reviews","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[],"custom":{}},"$kind":"flowAction","actionClass":"FlowAction","page":"reviews","pageData":{"shelves":[{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"9","name":"","impressionType":"ratingsDetails","idType":"sequential","impressionIndex":0}},"contentType":"reviews","marker":null,"items":[{"$kind":"Review","id":"5786283391","title":"Must follow the program exactly for success","contents":"My son has started going to bed by 7pm by himself in his own bed since 6 months. He is 14 months now. My son used to wake several times in the night. The first night I followed the program exactly he slept through the night. Then he would switch on and off between waking up once or twice which is much better than 4 - 6 times. By around 11ish months he was sleeping through the night.\n\n Some people were saying they’re annoyed they can’t just quickly search for things. I read everything so I just knew where to find things when I had questions. As I said if you don’t follow the program exactly you won’t be successful. I’ve bought tons of products that were supposed to help my baby sleep. This is the only thing that worked for me.","rating":5,"reviewerName":"samm_denise","date":"2020-04-09T14:36:43.000Z","dateText":"* null *","dateAuthorText":"* null * · samm_denise","response":{"$kind":"Response","id":"18130197","contents":"Thank you for your review.","date":"2020-09-27T23:15:21.000Z","dateText":"* null *"}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false}],"presentationOptions":[],"isIncomplete":false,"pageMetrics":{"$kind":"PageMetrics","instructions":[],"custom":{}},"$kind":"ReviewsPage","adamId":"1382444112","targetReviewId":"5786283391"},"presentationContext":"infer","animationBehavior":"infer","origin":"inapp"}},"id":"5786283391","impressionMetrics":{"fields":{"id":"5786283391","name":"","impressionType":"helpfulReview","idType":"its_id","impressionIndex":7}}}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":true,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false,"id":"allProductReviews"},"mostRecentVersion":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"20","name":"What’s New","impressionType":"versionHistory","idType":"sequential","impressionIndex":2}},"contentType":"titledParagraph","marker":null,"items":[{"$kind":"TitledParagraph","text":"Minor bug fixes and improvements.","style":"overview","wantsCollapsedNewlines":true,"primarySubtitle":"Version 8.1.10","secondarySubtitle":"Tue Oct 13 2026 04:12:58 GMT+0000 (Coordinated Universal Time)"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":{"title":"Version History","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"shouldFlush":false,"fields":{"location":[{"locationPosition":2,"locationType":"button","name":"Version History","idType":"its_id","id":"See All"}],"actionType":"navigate","target":"button_See All","eventType":"click","targetType":"button","targetId":"See All","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidenti