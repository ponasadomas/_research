],"custom":{}},"$kind":"ExternalUrlAction","actionClass":"ExternalUrlAction","url":"https://www.littleones.co/pages/privacy-policy","isSensitive":false},"systemImageName":"hand.raised.fill"}],"url":null,"mergeWhenFetched":false,"fetchStrategy":"onPageLoad","batchGroup":null,"seeAllAction":null,"footerTitle":null,"footerAction":null,"eyebrow":null,"eyebrowArtwork":null,"footerStyle":null,"titleArtwork":null,"subtitle":null,"isHorizontal":false,"isHidden":false,"rowsPerColumn":null,"itemCount":{"type":"all"},"background":{"type":"none"},"contentsMetadata":{"type":"none"},"overrideLayoutConfigurations":[],"isPersonalized":false,"shouldFilterApps":false,"id":"purchasedLinks"},"textLinksShelf":null,"similarItems":{"$kind":"Shelf","impressionMetrics":{"fields":{"id":"customers-also-bought-apps","name":"You Might Also Like","impressionType":"similarItems","idType":"relationship","impressionIndex":15}},"contentType":"smallLockup","marker":null,"items":[{"$kind":"Lockup","title":"Qeepsake: Family Photo Album","adamId":"1332312787","impressionMetrics":{"fields":{"id":"1332312787","name":"Qeepsake: Family Photo Album","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":0,"contentRating":100,"bundleId":"co.qeepsake.qeepsake"}},"bundleId":"co.qeepsake.qeepsake","isEditorsChoice":false,"subtitle":"Baby Book & Milestones Journal","rating":4.9,"ratingCount":"15K","decorations":[],"icon":{"$kind":"Artwork","crop":"Icon.ApSiOS01","template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/84/86/35/848635ad-ff0c-8190-ea47-09125c755f33/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}],"backgroundColor":{"red":0.996078431372549,"green":0.996078431372549,"blue":0.9803921568627451,"type":"rgb"},"textColor":{"red":0.16470588235294117,"green":0.10196078431372549,"blue":0.2,"type":"rgb"},"style":"roundedRectPrerendered"},"isIOSBinaryMacOSCompatible":false,"useAdsLocale":false,"tertiaryTitle":null,"tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Baby Book & Milestones Journal","ageRating":"4+","productDescription":"Tell your family’s fullest story, one text at a time.\n\nAs seen on ABC’s Shark Tank, Qeepsake helps busy parents save beautiful memories of their little one, from pregnancy to school years. Easily journal photos and milestones via text or the Qeepsake app. Order printed albums to hold your memories in a real photo book.\n\nQeepsake sends you age-appropriate question prompts for your little one, even in the earliest stages of pregnancy. Simply reply to a text message and a new memory is saved in your child’s journal!\n\nIt’s never too late to start! Not only can you backdate entries from earlier memories, but Qeepsake also offers prompts for every journey. Maternity to adoption, IVF to school years, babyhood to parenting—journal every moment with Qeepsake.\n\nAdd more to your saved memories! With the Qeepsake app, you can:\n\n- Upload more photos & videos\n- Edit your journal entries\n- Build photo collages\n- Preview and order your family album\n\nQeepsake instantly turns your family, baby, kid-related moments, and Qeepsake memories into a personally crafted hardcover or softcover photo book filled with all your pictures and journal entries. Cherish and share your new photo album for years to come!\n\nYou can preview your family’s picture album, baby photo book, and memory journal anytime using the Qeepsake app. Spend less time fussing with complicated book editing software and get back to making new memories with your family!\n\nCapture, record, and share childhood moments without missing a single one. Easily save every moment of your child’s life, pregnancy through childhood, with Qeepsake.\n\nQeepsake Features:\n\nSave Moments & Memories\n\n- Qeepsake sends you personalized, age-informed question prompts for any number of children\n- Qeepsake automatically saves your photos and memories into a beautifully formatted baby book or family photo album\n- Share access with your spouse or other contributors to add to your child’s journal\n- Weekly recap emails of all your new journal entries to share with friends & family\n\nEasy Photo Journals\n\n- Text your photos and memories to save them\n- Build photo collages effortlessly\n- Create beautifully formatted books based off your photos and entries automatically\n\nMilestones for Any Occasion\n\n- Use Qeepsake to make a maternity, baby, or family journal\n- Save the precious firsts in your child’s life\n- Capture key moments in your pregnancy\n- Journal milestones and memories as your child grows\n- Create a photo book to share when they’re older\n\nWe text you prompts, you text us the memories you want to hold tight. Subscription Pricing and Terms: Unlock full access to Qeepsake’s digital features (unlimited photo storage, unlimited journal entries, video uploads, a larger and more frequent set of question prompts, question prompts via multiple channels (including SMS), the ability to answer missed questions, backdate journal entries, and more) with auto-renewing monthly and yearly subscription membership options.\n\nIf you select an auto-renewing subscription membership option, payment will be charged to your iTunes Account at confirmation of purchase and your Qeepsake subscription will automatically renew (at the duration selected) unless auto-renew is turned off at least 24 hours before the end of the current period. Your credit card will be charged for renewal through your iTunes account within 24-hours prior to the end of the current period.\n\nTurn off an auto-renewing subscription at any time from your iTunes Account Settings. Refunds will not be issued for any unused portion of the term. Any unused portion of a free trial period will be forfeited when you purchase a subscription where applicable. For more information on our terms of service and privacy policy, visit https://app.qeepsake.com/terms OR https://app.qeepsake.com/privacy\n\nSupport: Loving the Qeepsake app? Please leave a review! Want to help us improve the app? Email [support@qeepsake.com](mailto:support@qeepsake.com).","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"shouldFlush":false,"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=1332312787&pricingParameters=STDQ&pg=default&appExtVrsId=890708027"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1332312787"},{"locationPosition":0,"locationType":"lockup","name":"Qeepsake: Family Photo Album","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"1332312787"},{"locationPosition":15,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"1332312787","eventType":"click","targetType":"button","targetId":"1332312787","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified"}],"custom":{"jet_adamId":"1332312787"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"1332312787","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=1332312787&pricingParameters=STDQ&pg=default&appExtVrsId=890708027","vendor":"Tinybeans USA Ltd.","appName":"Qeepsake: Family Photo Album","bundleId":"co.qeepsake.qeepsake","appPlatforms":["phone"],"isPreorder":false,"excludeAttribution":true,"metricsPlatformDisplayStyle":"ios","isRedownload":false,"preflightPackageUrl":null,"isArcadeApp":false,"isHalva":false,"suppo