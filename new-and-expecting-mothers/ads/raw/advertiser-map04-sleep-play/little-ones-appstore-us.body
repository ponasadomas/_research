ativeVideos%2CcustomDeepLink%2CcustomIconArtwork%2CcustomPromotionalText%2CcustomScreenshotsByType%2CcustomVideoPreviewsByType%2Cdescription%2CexpectedReleaseDateDisplayFormat%2CfileSizeByDevice%2CgameDisplayName%2CiconArtwork%2CinstallSizeByDeviceInBytes%2CmacRequiredCapabilities%2CmedicalDeviceInfo%2CmessagesScreenshots%2CminiGamesDeepLink%2CminimumOSVersion%2Cprivacy%2CprivacyDetails%2CprivacyPolicyUrl%2CremoteControllerRequirement%2CrequirementsByDeviceFamily%2CsellerInfo%2CsupportURLForLanguage%2CsupportedGameCenterFeatures%2CsupportsFunCamera%2CsupportsSharePlay%2CversionHistory%2CwebsiteUrl&extend%5Bapps%5D=distributionKind%2CisVerifiedForAppleSiliconMac&extend%5Bapp-events%5D=description%2CgamesUrl%2CproductArtwork%2CproductVideo&include=alternate-apps%2Capp-bundles%2Ccustomers-also-bought-apps%2Cdeveloper%2Cdeveloper-other-apps%2Cmerchandised-in-apps%2Crelated-editorial-items%2Creviews&include%5Bapps%5D=app-events&views=categorizations%2Ctop-in-app-purchasables&availableIn%5Bapp-events%5D=future&sparseLimit%5Bapps%3Acustomers-also-bought-apps%5D=40&sparseLimit%5Bapps%3Adeveloper-other-apps%5D=40&sparseLimit%5Bapps%3Arelated-editorial-items%5D=40&limit%5Breviews%5D=8&l=en-US","destination":{"storefront":"us","language":"en-US","$kind":"ProductPageIntent","id":"1362796822","platform":"iphone"}}},{"$kind":"Lockup","title":"Playground Buddy","adamId":"933016168","impressionMetrics":{"fields":{"id":"933016168","name":"Playground Buddy","impressionType":"lockup","idType":"its_id","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","platformDisplayStyle":"ios","impressionIndex":8,"contentRating":100,"bundleId":"ca.birdseyetechnology.Playground-Buddy"}},"bundleId":"ca.birdseyetechnology.Playground-Buddy","isEditorsChoice":false,"subtitle":"Worldwide Playground Finder","rating":4.1,"ratingCount":"48","decorations":[],"icon":{"$kind":"Artwork","crop":"Icon.ApSiOS01","template":"https://is1-ssl.mzstatic.com/image/thumb/PurpleSource221/v4/12/db/37/12db3723-d588-9a0b-04a0-d593938e64d0/Placeholder.mill/{w}x{h}{c}.{f}","width":1024,"height":1024,"variants":[{"$kind":"ArtworkVariant","format":"jpeg","quality":70,"supportsWideGamut":false}],"backgroundColor":{"red":0.5019607843137255,"green":0.7529411764705882,"blue":0.4549019607843137,"type":"rgb"},"textColor":{"red":0.01568627450980392,"green":0.027450980392156862,"blue":0.01568627450980392,"type":"rgb"},"style":"roundedRectPrerendered"},"isIOSBinaryMacOSCompatible":true,"useAdsLocale":false,"tertiaryTitle":"Designed for iPad.\nNot verified for macOS.","tertiaryTitleAction":null,"tertiaryTitleArtwork":null,"developerTagline":"Worldwide Playground Finder","ageRating":"4+","productDescription":"Every parent knows the question: \"Where can we go play?\" Playground Buddy answers it in seconds. Discover over 700,000 playgrounds around the world, see what each one is really like before you go, and turn any afternoon into an adventure.\n\nWhether you're a parent, grandparent, nanny, or anyone lucky enough to look after a little one, Playground Buddy helps you find the perfect spot — from the swings around the corner to a hidden gem across the country.\n\nWHY FAMILIES LOVE PLAYGROUND BUDDY\n• Find playgrounds near you, across town, or anywhere you're traveling\n• See real photos and details before you make the trip\n• Get one-tap directions in Apple Maps or Google Maps\n• Filter for exactly what you need — swings, slides, water play, shade, washrooms, fenced areas, and wheelchair-accessible equipment\n• Save your favorites and build your family's go-to list\n• Log your visits, rate each playground, and keep private notes\n• See everywhere you've already been, right on the map\n\nBUILT BY FAMILIES, FOR FAMILIES\nPlayground Buddy is powered by a community of caregivers just like you. Spot a playground that's missing? Add it in a few taps and help the next family find it. Took a great photo? Share it so others know what to expect.\n\nPHOTOS THAT PROTECT KIDS' PRIVACY\nChildren's safety comes first. That's why Playground Buddy automatically blurs faces in the photos you upload — so you can show what a playground looks like without sharing who was there.\n\nPLAN THE PERFECT OUTING\n• Heading somewhere new? Search any city and scope out playgrounds before you arrive.\n• Long car trip? Find a great place to stretch little legs along the way.\n• Need a break from the sun? Filter for shaded and covered spots.\n\nFinding somewhere wonderful for your kids to play should be the easy part of your day. Download Playground Buddy and discover your next favorite playground today.","buttonAction":{"title":"Get","presentationStyle":[],"actionMetrics":{"$kind":"ActionMetrics","data":[{"shouldFlush":false,"fields":{"reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","actionDetails":{"buyParams":"productType=C&price=0&salableAdamId=933016168&pricingParameters=STDQ&pg=default&appExtVrsId=887927932"},"location":[{"locationPosition":0,"locationType":"button","name":"Get","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"933016168"},{"locationPosition":8,"locationType":"lockup","name":"Playground Buddy","reco_algoId":"cab_1","reco_eligible":"1","reco_hash":"cab_1","idType":"its_id","id":"933016168"},{"locationPosition":15,"locationType":"similarItems","name":"You Might Also Like","idType":"relationship","id":"customers-also-bought-apps"}],"jet_adamId":"933016168","eventType":"click","targetType":"button","targetId":"933016168","platformContext":"iphone","alt_ab2_data":"[]"},"includingFields":["impressionsSnapshot","pageFields","contentRestrictionReasons","appState"],"excludingFields":["amsMetricsID"],"topic":"xp_amp_appstore_unidentified"}],"custom":{"jet_adamId":"933016168"}},"$kind":"OfferAction","actionClass":"OfferAction","adamId":"933016168","purchaseConfiguration":{"$kind":"PurchaseConfiguration","buyParams":"productType=C&price=0&salableAdamId=933016168&pricingParameters=STDQ&pg=default&appExtVrsId=887927932","vend