<script>
  (function() {
    class StickyBarazzcya2vmszjaselluaigenblocke787477we39vm extends HTMLElement {
      constructor() {
        super();
        this.storageKey = 'ai-sticky-bar-closed-azzcya2vmszjaselluaigenblocke787477we39vm';
      }

      connectedCallback() {
        if (this.isClosed()) {
          this.classList.add('ai-sticky-bar-hidden-azzcya2vmszjaselluaigenblocke787477we39vm');
          return;
        }

        const delay = parseInt(this.dataset.delay) * 1000 || 5000;
        
        setTimeout(() => {
          this.show();
        }, delay);

        this.setupEventListeners();
      }

      show() {
        this.classList.add('ai-sticky-bar-visible-azzcya2vmszjaselluaigenblocke787477we39vm');
      }

      hide() {
        this.classList.remove('ai-sticky-bar-visible-azzcya2vmszjaselluaigenblocke787477we39vm');
        setTimeout(() => {
          this.classList.add('ai-sticky-bar-hidden-azzcya2vmszjaselluaigenblocke787477we39vm');
        }, 400);
      }

      isClosed() {
        return sessionStorage.getItem(this.storageKey) === 'true';
      }

      setClosed() {
        sessionStorage.setItem(this.storageKey, 'true');
      }

      setupEventListeners() {
        const closeButton = this.querySelector('.ai-sticky-bar-close-azzcya2vmszjaselluaigenblocke787477we39vm');
        
        if (closeButton) {
          closeButton.addEventListener('click', () => {
            this.setClosed();
            this.hide();
          });
        }
      }
    }

    customElements.define('sticky-bar-azzcya2vmszjaselluaigenblocke787477we39vm', StickyBarazzcya2vmszjaselluaigenblocke787477we39vm);
  })();
</script>


