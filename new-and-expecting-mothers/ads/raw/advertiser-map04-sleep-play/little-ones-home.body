    <script>
      // klaviyo identify on nenwsletter form in footer
      (function () {

        document.addEventListener('DOMContentLoaded', function() {
          var form = document.getElementById('Contact-sections--14957223018594__footer');
          var emailInput = form.querySelector('input[name="contact[email]"]'); // Common name for email in Shopify newsletter forms

          if(form) {
            form.addEventListener('submit', function() {
              var email = emailInput.value;
              // Basic email validation
              var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (emailPattern.test(email)) {
                if (typeof klaviyo !== 'undefined' && klaviyo.identify) {
                  console.log('klaviyo identify email on submit', { email });
                  klaviyo.identify({
                    email: email
                  }, (err) => {
                    klaviyo.track('Website Footer Email subscription', {
                    });
                  });
                }
              }
            });
          }

          if (emailInput) {
            emailInput.addEventListener('blur', function() {
              var email = emailInput.value;
              // Basic email validation
              var emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              if (emailPattern.test(email)) {
                if (typeof klaviyo !== 'undefined' && klaviyo.identify) {
                  console.log('klaviyo identify email', { email });
                  klaviyo.identify({
                    email: email
                  }, (err) => {
                    klaviyo.track('Website Footer Email subscription', {
                    });
                  });
                }
              }
            });
          }
        });
      })();

      // Klaviyo event for add to cart & view cart
      (function () {
        var addToCartButtonClass = 'featured-product__add-to-cart-button';
        var otherAddToCartClass = 'zpa-add-to-cart-btn';
        var imageAddToCartClass = 'zpa-disabled-when-link-empty';

        document.addEventListener('DOMContentLoaded', function() {
          document.addEventListener('click', function(e) {
            if (
              e.target.classList.contains(addToCartButtonClass) || 
              e.target.closest('.' + addToCartButtonClass) || 
              e.target.classList.contains(otherAddToCartClass) || 
              e.target.closest('.' + otherAddToCartClass) ||
              e.target.classList.contains(imageAddToCartClass) || 
              e.target.closest('.' + imageAddToCartClass)
              ) {
              console.log('add to cart click');
              function registerEvent() {
                if (typeof klaviyo !== 'undefined' && klaviyo.track) {
                  klaviyo.track('Custom: Added to cart', {
                    'page_location': window.location.pathname,
                  });
                }
              }
              registerEvent();
            }
          });

          if(window.location.href.includes('/cart')) {
            function registerEvent() {
              if (typeof klaviyo !== 'undefined' && klaviyo.track) {
                klaviyo.track('Custom: Viewed cart', {
                  'page_location': window.location.pathname,
                });
              }
            }
            registerEvent();
          }
        });

      })();
    </script>
