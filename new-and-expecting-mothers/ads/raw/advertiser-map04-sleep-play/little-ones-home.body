        if (window.OMG_BLOCK_URL) window.OMG_BLOCK_URL[SCOPE_KEYS[k]] = [];
      }

      // The frame stays where it is. BLOCKED_SRC is kept so Gen 2 lets it through if it is
      // inserted (or moved) after this. Deferred because Gen 1 queues a frame before it has
      // finished hiding it.
      function releaseFrame(frame) {
        Promise.resolve().then(function () {
          var src = frame.getAttribute(BLOCKED_SRC) || frame.getAttribute('data-src');
          setAttribute.call(frame, BLOCKED_SRC, src);
          setAttribute.call(frame, 'src', src);
          frame.removeAttribute('data-src');
          frame.style.display = '';
        });
      }

      function isShopifyFrame(frame) {
        return isShopifyTracking(frame.getAttribute(BLOCKED_SRC) || frame.getAttribute('data-src'));
      }

      function isShopifyScript(entry) {
        return isShopifyTracking(scriptSource(entry) || entry.textContent);
      }

      // Whatever was held back before the embed rendered. Filtered in place: the block code and
      // the consent scripts read these same arrays when the visitor consents.
      function releaseHeld(list, isShopify, release) {
        var kept = [];
        for (var i = 0; i < list.length; i++) {
          if (isShopify(list[i])) release(list[i]);
          else kept.push(list[i]);
        }
        list.length = 0;
        Array.prototype.push.apply(list, kept);
      }
      releaseHeld(storage.scripts, isShopifyScript, releaseScript);
      releaseHeld(storage.iframes, isShopifyFrame, releaseFrame);

      // Gen 2 keeps blocking both kinds for the life of the page and queues every node it holds
      // back through this push, so anything it catches from now on is handed straight back.
      function handBack(list, isShopify, release) {
        var push = list.push;
        list.push = function () {
          for (var j = 0; j < arguments.length; j++) {
            if (isShopify(arguments[j])) release(arguments[j]);
            else push.call(list, arguments[j]);
          }
          return list.length;
        };
      }
      handBack(storage.scripts, isShopifyScript, releaseScript);
      handBack(storage.iframes, isShopifyFrame, releaseFrame);
    } catch (e) {}
  })();
</script>
