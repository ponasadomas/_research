<script src="https://www.youtube.com/iframe_api" async></script>
<script>
  (async function(){
    function getPercentScrolled() {
      var h = document.documentElement, 
        b = document.body,
        st = 'scrollTop',
        sh = 'scrollHeight';
    
      var percent = (h[st]||b[st]) / ((h[sh]||b[sh]) - h.clientHeight) * 100;
      return Math.round(percent);
    }

    // blog cta click event
    const ctaButtons = document.querySelectorAll("a.blog-cta-widget__button");
    for (const ctaButton of ctaButtons){
      ctaButton.addEventListener("click", function(){
        (typeof gtag !== 'undefined') && gtag("event", "blog_cta_click", {
          link_url: ctaButton.href,
          link_text: ctaButton.innerText,
          percent_scrolled: getPercentScrolled(),
        });
      })
    }

    // open album perfect sounds event
    const platforms = ["Spotify", "Apple", "Youtube", "Amazon"];
    if (window.location.pathname === "/pages/perfect-sounds"){
      const buttons = document.querySelectorAll("a.button");
      for (const button of buttons){
        const platform = button.innerText;
        if (!platforms.includes(platform)) continue;
        button.addEventListener("click", function(){
          (typeof gtag !== 'undefined') && gtag("event", "open_album_perfect_sounds", {
            platform,
          });
        })
      }
    }

    // page long view event
    let viewSecond = 0;
    const pageLongViewInterval = setInterval(function(){
      if (viewSecond > 90 && getPercentScrolled() > 50){
        (typeof gtag !== 'undefined') && gtag("event", "page_long_view", {
          page_title: document.title,
          page_location: window.location.href,
        });
        clearInterval(pageLongViewInterval);
      }

      viewSecond++;
    }, 1000);

    // video action event
    // self-hosted video
    const deferredMediaEls = document.querySelectorAll("deferred-media");
    for (const deferredMediaEl of deferredMediaEls){
      const deferredMediaButton = deferredMediaEl.querySelector("button");
      
      deferredMediaButton.addEventListener("click", function(){
        setTimeout(function(){
          const video = deferredMediaEl.querySelector("video");
          const source = video.querySelector("source");

          video.addEventListener("play", function(){
            (typeof gtag !== 'undefined') && gtag("event", "video_action", {
              status: "playing",
              title: video.title,
              duration: video.duration,
              url: source.src,
              percent: Math.round((video.currentTime / video.duration) * 100)
            });
          });
  
          video.addEventListener("ended", function(){
            (typeof gtag !== 'undefined') && gtag("event", "video_action", {
              status: "ended",
              title: video.title,
              duration: video.duration,
              url: source.src,
              percent: Math.round((video.currentTime / video.duration) * 100)
            });
          });
        }, 10);
      });
    }

    // video action event
    // youtube video
    const iframes = document.querySelectorAll("iframe");
    const youtubeIframesIds = [];
    const youtubeIframeLoadPromises = [];
    for (const iframe of iframes){
      if (iframe.src.includes("youtube.com/embed")){
        iframe.id = iframe.id ? iframe.id : `youtube-iframe-${youtubeIframesIds.length}`;
        const iframeSrcURL = new URL(iframe.src);

        iframeSrcURL.searchParams.set("enablejsapi", "1");
        iframeSrcURL.searchParams.set("origin", window.location.origin);

        const newSrc = iframeSrcURL.href;
        if (iframe.src !== newSrc) {
          const loadPromise = new Promise(function(resolve) {
            iframe.addEventListener("load", resolve, { once: true });
          });
          iframe.src = newSrc;
          youtubeIframeLoadPromises.push(loadPromise);
        }

        youtubeIframesIds.push(iframe.id);
      }
    }
    if (youtubeIframeLoadPromises.length > 0) {
      await Promise.all(youtubeIframeLoadPromises);
    }
    let youtubePlayerApiIntervalTime = 0;
    const youtubePlayerApiInterval = setInterval(function(){
      if ((window.YT && window.YT.Player) || youtubePlayerApiIntervalTime > 10000){
        clearInterval(youtubePlayerApiInterval);

        if (window.YT.Player){
          function onStateChange(event){
            const STATES = ['unstarted', 'ended', 'playing', 'paused', 'buffering', 'video cued'];
            const state = STATES[event.data + 1]; // plus by 1, because unstarted = -1;

            switch(state){
              case "playing":
                (typeof gtag !== 'undefined') && gtag("event", "video_action", {
                  status: state,
                  title: event.target.videoTitle,
                  duration: event.target.getDuration(),
                  url: event.target.getVideoUrl(),
                  percent: Math.round((event.target.getCurrentTime() / event.target.getDuration()) * 100)
                });
                break;
              case "ended":
                (typeof gtag !== 'undefined') && gtag("event", "video_action", {
                  status: state,
                  title: event.target.videoTitle,
                  duration: event.target.getDuration(),
                  url: event.target.getVideoUrl(),
                  percent: Math.round((event.target.getCurrentTime() / event.target.getDuration()) * 100)
                });
                break;
            }
          }

          for (const iframeId of youtubeIframesIds){
            const player = new YT.Player(iframeId, {
              events: { 
                onStateChange: onStateChange,
              } 
            });
          }
        }

      }

      youtubePlayerApiIntervalTime++;
    }, 50);

    // form submit event
    let formSubmitIntervalTime = 0;
    const formSubmitInterval = setInterval(function(){
      const pdfDownloadForm = document.querySelector(".pdf-download--form form");
      
      if (pdfDownloadForm){
        clearInterval(formSubmitInterval);
        const pdfDownloadFormSubmitBtn = pdfDownloadForm.querySelector("button:last-child");
        if (pdfDownloadFormSubmitBtn){
          pdfDownloadFormSubmitBtn.addEventListener("click", function(){
            (typeof gtag !== 'undefined') && gtag("event", "form_submit", {
              page_location: window.location.pathname,
              value: 4,
              currency: "USD"
            });
          });
        }
      }
      if(formSubmitIntervalTime > 10000) {
        clearInterval(formSubmitInterval);
      }
      formSubmitIntervalTime += 100;
    }, 100);
  })()
</script><script>(()=>{if(window.ZipifyPages??={},!window.ZipifyPages.isGlobalSectionScriptsLoaded)return;window.ZipifyPages.isGlobalSectionScriptsLoaded=!1;"https://cdn03.zipify.com/javascript/fr-page-published-scripts.min.js".split(",").map((i=>i.trim())).forEach((i=>{const e=document.createElement("script");Object.assign(e,{src:i,defer:!0,type:"module"}),document.body.appendChild(e)}))})();</script><script id="published-popup-template" type="text/template"><form class="zpa-crm-popup-form" id="zpa-crm-form" action="/subscribe" method="post" data-zpa-crm-form><header class="zpa-crm-popup-header"><button class="zpa-popup-btn-close" type="button"aria-label="Close Navigation" data-close-btn><svg class="zpa-popup-btn-close-icon" width="34" height="34" data-name="btn-close"><use href="#btn-close"></use></svg></button></header><div class="zpa-crm-popup-body" data-popup-content></div></form></script> <script id="crm-button-popup" type="text/template">{! if (progress_image_option == 1)!}<div class="zpa-crm-popup-progressbar-wrap"><img class="zpa-crm-popup-img-progress zpa-img-fluid zpa-center-block" src="{!= progress_image.src !}"></div>{! !}<h1 class="zpa-crm-popup-title" style="color:{!= form_name_color !}; font-family:{!= form_name_font_family !}; font-size:{!= form_name_font_size !};">{!= form_name !}</h1><div class="zpa-crm-popup-form-container">{! if (form_image_option == 1) !}<div class="zpa-crm-popup-image-box"><img class="zpa-crm-popup-img-asside zpa-img-fluid zpa-center-block" style="border-radius:{!= form_image_shape !};" src="{!= form_image.src !}"></div>{! !}<div class="zpa-crm-popup-form-box"><div class="zpa-crm-popup-field-wrap">{! if (first_name_option == 1) !}<label class="zpa-crm-popup-field-wrap zpa-crm-popup-field-first-name zpa-text-field zpa-offset-bottom-xs"><input class="zpa-text-field__input" type="text" name="first_name" data-user-fname data-zp-input><span class="zpa-text-field__label">First Name</span></label>{! !}{! if (last_name_option == 1) !}