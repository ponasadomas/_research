      <style>
.aq-banner {
  width: 100%;
  padding: 20px;
  background: var(--aq-banner-bg, #f8e8e8);
  border-radius: var(--aq-radius, 20px);

}

.aq-banner__content {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.aq-banner__text {
  flex: 1;
  min-width: 200px;
}

.aq-banner__title {
  margin: 0 0 4px 0;
  font-size: var(--aq-banner-fs, 18px);
  font-weight: 600;
  color: var(--aq-banner-color, #212326);
}

.aq-banner__subtitle {
  margin: 0;
  color: var(--aq-banner-color, #212326);
  opacity: 0.8;
  font-size: 14px;
  line-height: 1.4;
}

.aq-banner__cta {
  display: inline-block;
  padding: 10px 24px;
  background: var(--aq-bg, #1a1a1a);
  color: var(--aq-text, #fff);
  border: none;
  border-radius: var(--aq-btn-radius, 20px);
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  white-space: nowrap;
  flex-shrink: 0;
  transition: opacity 0.15s ease;
}
.aq-banner__cta:hover { opacity: 0.85; }
.aq-banner__cta:focus-visible { opacity: 0.85; outline: 2px solid var(--aq-text, #fff); outline-offset: 2px; }

@media (max-width: 640px) {
  .aq-banner { padding: 16px; }
  .aq-banner__content { flex-direction: column; text-align: center; }
  .aq-banner__text { min-width: 0; }
  .aq-banner__cta { width: 100%; text-align: center; }
}
</style><div class="aq-banner" style="--aq-bg:#fed4df;--aq-text:#000;--aq-radius:8px;--aq-banner-bg:#fef4f7;--aq-banner-color:#212326;--aq-banner-fs:18px;--aq-btn-radius:20px"><div class="aq-banner__content"><div class="aq-banner__text"><h3 class="aq-banner__title">Is this the right choice for you?</h3><p class="aq-banner__subtitle">Take our quick quiz to find the sleep solution you're looking for.</p></div><button type="button" class="aq-banner__cta" data-quiz-trigger="cmu1sl2an0011op6skfgoc95i" data-quiz-mode="live" data-quiz-placement="banner" data-quiz-id="cmu1sl2an0011op6skfgoc95i">Find my sleep solution</button></div></div>
    
  


