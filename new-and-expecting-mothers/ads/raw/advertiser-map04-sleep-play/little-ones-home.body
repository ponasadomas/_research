        setAttribute.call(script, BLOCKED_SRC, src || 'released');
        if (entry.type) script.type = entry.type;
        if (src) setAttribute.call(script, 'src', src);
        else script.text = entry.textContent;
        document.head.appendChild(script);
      }

      // Gen 1 reads these on every check, so switching them off stops it blocking either kind.
      // Gen 2 compiled its patterns on first use and ignores them.
      var SCOPE_KEYS = ['web_pixel', 'shopify'];
      for (var k = 0; k < SCOPE_KEYS.length; k++) {
