 per Kit; ships with each Play Kit; cancel any time\"},{\"id\":\"1c078796-7881-4fce-8f53-3009b4d7ebcb\",\"key\":\"bookBundleInside\",\"value\":\"Take a Look Inside the Books\"},{\"id\":\"c464e237-13ef-4ff2-ac66-273f6edc223c\",\"key\":\"addOnTwoWeeks\",\"value\":\"Weeks {{minWeek}}-{{maxWeek}}\"},{\"id\":\"10a8446f-a221-4987-a184-293c53dcff00\",\"key\":\"addOnTwoMonths\",\"value\":\"Months {{minMonth}}-{{maxMonth}}\"},{\"id\":\"7392102f-3da9-4a5d-a923-0dff9f488dfb\",\"key\":\"addOnThreeMonths\",\"value\":\"Months {{minMonth}}, {{midMonth}}, {{maxMonth}}\"},{\"id\":\"b9dcc655-36cd-4463-aa6b-18fa345869b7\",\"key\":\"bookBundleHeader\",\"value\":\"Book Bundle Add-On\"},{\"id\":\"b5c9814d-f360-4c35-b345-71616475c87d\",\"key\":\"subtotal\",\"value\":\"Subtotal\"},{\"id\":\"92bc9fbb-5223-4c0e-844a-a85fb0513c8f\",\"key\":\"susbcriptionPlan\",\"value\":\"Subscription plan\"},{\"id\":\"93b07e3e-8b14-466b-a254-155d9e57fc05\",\"key\":\"books_addon\",\"value\":\"Book Bundle Add-On\"},{\"id\":\"498c5d06-2b3e-4f6e-ae83-a525484a0c63\",\"key\":\"previousPlayAddOn\",\"value\":\"Previous Play Kit ({{kitName}})\"},{\"id\":\"bd98f56d-12e7-4340-bcb7-ba1d49a2c65b\",\"key\":\"reviewOrderButton\",\"value\":\"Review Your Order\"},{\"id\":\"ce42ea84-9e38-4c2b-b5c7-b46f9dcd9066\",\"key\":\"orderReviewTitle\",\"value\":\"Your Order Review\"},{\"id\":\"81dfc964-a589-424f-abad-8899920ff75c\",\"key\":\"orderReviewAddOn\",\"value\":\"Add-On\"},{\"id\":\"78221d25-1df4-41dc-822a-8ba2ca8f378f\",\"key\":\"orderReviewYourChild\",\"value\":\"Your Child\"},{\"id\":\"276e7810-3356-45d7-86b6-c6a53a838741\",\"key\":\"orderReviewShipSoon\",\"value\":\"Shipping Soon\"},{\"id\":\"33bcf5cc-d889-49ea-8fef-adc138f3b3ef\",\"key\":\"orderReviewShips\",\"value\":\"Ships: {{date}}\"},{\"id\":\"7181f982-c421-4b42-be02-981a89d7886a\",\"key\":\"orderReviewShipsNow\",\"value\":\"Ships in 1-2 Business Days\"},{\"id\":\"bbc4a264-386f-4649-a1e5-38b4ae4b9544\",\"key\":\"orderReviewRemoveAddOn\",\"value\":\"Remove\"},{\"id\":\