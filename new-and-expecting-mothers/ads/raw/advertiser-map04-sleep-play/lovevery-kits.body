ick-active" tabindex="-1" aria-hidden="false" style="outline:none;width:14.285714285714286%"><div><div class="!flex h-full justify-center" tabindex="-1" style="width:100%;display:inline-block"><div class="mx-2 my-2 grid grid-rows-auto content-baseline w-full overflow-hidden rounded-lg bg-white md:mx-8 md:max-w-[360px]" data-testid="quotecard"><img alt="Lovevery Play Kit" loading="lazy" width="1440" height="1800" decoding="async" data-nimg="1" class="h-auto w-full flex-none" style="color:transparent" srcSet="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F279KCOprCiAh4i6QfL6Lyy%2Fbf9bacaff4fdd3740490c3fdc1c8704c%2FCasey_1.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 1x, /_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F279KCOprCiAh4i6QfL6Lyy%2Fbf9bacaff4fdd3740490c3fdc1c8704c%2FCasey_1.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 2x" src="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F279KCOprCiAh4i6QfL6Lyy%2Fbf9bacaff4fdd3740490c3fdc1c8704c%2FCasey_1.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz"/><div class="relative flex-auto p-4 pb-14 text-center text-base md:p-6 md:pb-16"><p>&quot;Every box feels intentional and thoughtfully designed for exactly what they’re learning in that season. It’s one of the few subscriptions in our home that truly gets used daily.&quot;</p><p class="absolute bottom-6 left-0 w-full text-center text-sm font-bold md:text-base">Casey W.</p></div></div></div></div></div><div data-index="2" class="slick-slide slick-active" tabindex="-1" aria-hidden="false" style="outline:none;width:14.285714285714286%"><div><div class="!flex h-full justify-center" tabindex="-1" style="width:100%;display:inline-block"><div class="mx-2 my-2 grid grid-rows-auto content-baseline w-full overflow-hidden rounded-lg bg-white md:mx-8 md:max-w-[360px]" data-testid="quotecard"><img alt="Lovevery Play Kit" loading="lazy" width="1440" height="1800" decoding="async" data-nimg="1" class="h-auto w-full flex-none" style="color:transparent" srcSet="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F5bDqIdt954sOk2UjeHXzx9%2F28ca5ce48a5a0f48ea58f3a34a9fd605%2FShannon_1.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 1x, /_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F5bDqIdt954sOk2UjeHXzx9%2F28ca5ce48a5a0f48ea58f3a34a9fd605%2FShannon_1.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 2x" src="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F5bDqIdt954sOk2UjeHXzx9%2F28ca5ce48a5a0f48ea58f3a34a9fd605%2FShannon_1.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz"/><div class="relative flex-auto p-4 pb-14 text-center text-base md:p-6 md:pb-16"><p>&quot;What I love most about Lovevery is how seamlessly they bring problem-solving, experimentation, and discovery into everyday play. &quot;</p><p class="absolute bottom-6 left-0 w-full text-center text-sm font-bold md:text-base">Shannon M.</p></div></div></div></div></div><div data-index="3" class="slick-slide" tabindex="-1" aria-hidden="true" style="outline:none;width:14.285714285714286%"><div><div class="!flex h-full justify-center" tabindex="-1" style="width:100%;display:inline-block"><div class="mx-2 my-2 grid grid-rows-auto content-baseline w-full overflow-hidden rounded-lg bg-white md:mx-8 md:max-w-[360px]" data-testid="quotecard"><img alt="Child playing with several playthings from The Realist Play Kit" loading="lazy" width="1440" height="1800" decoding="async" data-nimg="1" class="h-auto w-full flex-none" style="color:transparent" srcSet="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F6ystHTEUzCSj8AyKjE98r2%2F78f7701aaccc6807fc069972cf0c75be%2F2.png&amp;w=1920&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 1x, /_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F6ystHTEUzCSj8AyKjE98r2%2F78f7701aaccc6807fc069972cf0c75be%2F2.png&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 2x" src="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F6ystHTEUzCSj8AyKjE98r2%2F78f7701aaccc6807fc069972cf0c75be%2F2.png&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz"/><div class="relative flex-auto p-4 pb-14 text-center text-base md:p-6 md:pb-16"><p>&quot;It gave me so much peace of mind, since I knew Lovevery had done the research. It wasn&#x27;t another thing on my to-do list.&quot; </p><p class="absolute bottom-6 left-0 w-full text-center text-sm font-bold md:text-base">Raina W.</p></div></div></div></div></div><div data-index="4" class="slick-slide" tabindex="-1" aria-hidden="true" style="outline:none;width:14.285714285714286%"><div><div class="!flex h-full justify-center" tabindex="-1" style="width:100%;display:inline-block"><div class="mx-2 my-2 grid grid-rows-auto content-baseline w-full overflow-hidden rounded-lg bg-white md:mx-8 md:max-w-[360px]" data-testid="quotecard"><img alt="Lovevery Play Kit" loading="lazy" width="1440" height="1800" decoding="async" data-nimg="1" class="h-auto w-full flex-none" style="color:transparent" srcSet="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F6jLQDmbV4TBhUpidIpe5tD%2F94c8798c82ee05f2b58726842785dbb6%2FNikki_1.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 1x, /_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F6jLQDmbV4TBhUpidIpe5tD%2F94c8798c82ee05f2b58726842785dbb6%2FNikki_1.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 2x" src="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2F6jLQDmbV4TBhUpidIpe5tD%2F94c8798c82ee05f2b58726842785dbb6%2FNikki_1.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz"/><div class="relative flex-auto p-4 pb-14 text-center text-base md:p-6 md:pb-16"><p>&quot;Lovevery playkits are the ultimate parenting hack for hours of open ended play. I love how the books and toys are geared towards development and learning through play. And as an artist, I love the patterns, colors and quality!&quot;</p><p class="absolute bottom-6 left-0 w-full text-center text-sm font-bold md:text-base">Nikki W.</p></div></div></div></div></div><div data-index="5" class="slick-slide" tabindex="-1" aria-hidden="true" style="outline:none;width:14.285714285714286%"><div><div class="!flex h-full justify-center" tabindex="-1" style="width:100%;display:inline-block"><div class="mx-2 my-2 grid grid-rows-auto content-baseline w-full overflow-hidden rounded-lg bg-white md:mx-8 md:max-w-[360px]" data-testid="quotecard"><img alt="Lovevery Play Kit" loading="lazy" width="1440" height="1800" decoding="async" data-nimg="1" class="h-auto w-full flex-none" style="color:transparent" srcSet="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2FGAny5OEVzKrlVeMoApdm7%2F6e115226d25e4b7039445c8acdb6ed25%2FMelissa_6.jpg&amp;w=1920&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 1x, /_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2FGAny5OEVzKrlVeMoApdm7%2F6e115226d25e4b7039445c8acdb6ed25%2FMelissa_6.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz 2x" src="/_next/image/?url=https%3A%2F%2Fimages.ctfassets.net%2F0sea1vycfyqy%2FGAny5OEVzKrlVeMoApdm7%2F6e115226d25e4b7039445c8acdb6ed25%2FMelissa_6.jpg&amp;w=3840&amp;q=75&amp;dpl=dpl_44zh7Mxu8GxLwsys3UDQNrxmsrpz"/><div class="relative flex-auto p-4 pb-14 text-center text-base md:p-6 md:pb-16"><p>&quot;Watching them learn new skills in front of my eyes is magical. I am always told how my boys seem beyond their years in their capabilities and I honestly put so much down to our Lovevery boxes &quot;</p><p class="absolute bottom-6 left-0 w-full text-center text-sm font-bold md:text-base">Melissa C.</p></div></div></div></div></div><div data-index="6" class="slick-slide" tabindex="-1" aria-hidden="true" style="outline:none;width:14.285714285714286%"><div><div class="!flex h-full justify-center" t