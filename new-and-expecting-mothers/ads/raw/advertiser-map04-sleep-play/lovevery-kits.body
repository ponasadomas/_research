}.\"},{\"id\":\"923e823a-7f47-427b-8167-20f0f01f9e21\",\"key\":\"errorIntro\",\"value\":\"Oh no! There’s missing information.\"},{\"id\":\"4fc21a57-fc0d-4708-8059-2caaa0293081\",\"key\":\"noName\",\"value\":\"Your child\"},{\"id\":\"5b795386-f7ba-407d-9496-56875067f96f\",\"key\":\"addOn\",\"value\":\"Add On\"},{\"id\":\"fa3a25aa-6300-4da2-9ade-8856ced9e69c\",\"key\":\"save\",\"value\":\"Save\"},{\"id\":\"5f6c3d58-6af1-4440-8a7b-3e88dedce350\",\"key\":\"month\",\"value\":\"Month\"},{\"id\":\"8fb75494-f533-4a13-a760-a10db71a6ed9\",\"key\":\"year\",\"value\":\"Year\"},{\"id\":\"f3ae6c7f-4923-4b40-bb1e-47596fadf3cc\",\"key\":\"day\",\"value\":\"Day\"},{\"id\":\"46f76644-e31a-4f6c-97d8-f23a032cea09\",\"key\":\"dateErrorIncomplete\",\"value\":\"Child's birth date / due date / adjusted birth date\"},{\"id\":\"8768f6ca-4afa-4301-9604-f04d8f213f53\",\"key\":\"bookBundleAlt\",\"value\":\"A look inside {{bookTitle}} from {{bundleTitle}}\"},{\"id\":\"c15aae3e-159d-4f1f-ab33-423408ce07db\",\"key\":\"upsellheader\",\"value\":\"More stage-based play\"},{\"id\":\"2dae2571-6182-4832-a0e4-ab8ac51ef6b3\",\"key\":\"childInfoModalTitle\",\"value\":\"Recommended Starting Play Kit\"},{\"id\":\"765e9a4e-a92c-4bf4-a0b3-79a5549399f1\",\"key\":\"childInfoModalBody\",\"value\":\"Based on your child's age, we recommend starting with this Play Kit so they can strengthen coordination and build emotional intelligence.\"},{\"id\":\"0350ffd8-2fc8-417d-a0a7-6abad2dd0708\",\"key\":\"childInfoModalMonths\",\"value\":\"Months {{months}}\"},{\"id\":\"05c48828-05e3-4194-9c77-822d623c8fc9\",\"key\":\"childInfoModalButton\",\"value\":\"Buy Now\"},{\"id\":\"0a0caed3-2912-4016-96f2-c5c2b359f2c6\",\"key\":\"childInfoModalExplore\",\"value\":\"Explore {{playKit}}\"},{\"id\":\"82c37433-fbef-43ca-9ca9-f4fecbe0ef3e\",\"key\":\"orderReviewFutureShipmentsDesc\",\"value\":\"We'll send you an email 7 days before your next play kit ships so you have a chance to change, skip, or cancel.\"},{\"id\":\"43969b9c-333c-4a4e-b973-e38672d7d5ee\",\"key\":\"childInfoModalSkinToneLabel\",\"value\":\"Choose a skin tone for your doll: {{SkinToneLabel}}\"},{\"id\":\"7c98e6e5-d177-4bd2-8ee4-170dd8625a28\",\"key\":\"startingKitLangTooltipText1\",\"value\":\"Play Guides offered in every language.\"},{\"id\":\"a19a5a47-ea94-44c5-9d8d-29670f1f71bd\",\"key\":\"startingKitLangTooltipText2\",\"value\":\"Baby books and playthings (0-12 months) come only in English, but include little to no text.\"},{\"id\":\"beed627a-6366-4379-bb7d-cf06899e6dc6\",\"key\":\"startingKitLangTooltipText3\",\"value\":\"The Book Bundle Add-On is only available with English language subscriptions.\"},{\"id\":\"ff7a416c-6239-4706-8636-6384c8436d30\",\"key\":\"startingKitLangTooltipText4\",\"value\":\"Toddler books (13-48 months) available in all languages.\"},{\"id\":\"8925a9aa-a9f0-468c-9d56-532dd1df3b26\",\"key\":\"step\",\"value\":\"Step\"},{\"id\":\"467efb1f-75e1-4d16-b6d6-64580084e1eb\",\"key\":\"of\",\"value\":\"of\"},{\"id\":\"24c72115-b10d-46ac-a0bb-39aaa10bb0a5\",\"key\":\"paymentOptionDescription1\",\"value\":\"Cancel or skip any time. Easy returns.\"},{\"id\":\"6646920c-5dca-4f49-a71a-c841aba17164\",\"key\":\"paymentOptionDescription2\",\"value\":\"Plans automatically renew. Please see our terms for details.\"},{\"id\":\"76056e39-a679-48e7-b7c9-8f7bb1a4e5d3\",\"key\":\"ppkCtaButtonText\",\"value\":\"Pay Per Kit\"},{\"id\":\"d9059378-50b6-4d22-ad9a-a850f500e373\",\"key\":\"pufCtaButtonText\",\"value\":\"Prepay \u0026 Save\"},{\"id\":\"d0c4056a-a2ed-40e8-8814-aaa29231657c\",\"key\":\"pufCaptionText\",\"value\":\"By selecting prepay \u0026 save, you will automatically continue on a pay per kit plan after your 3-kit bundle ships. You can manage your payment options at any time in your Account Settings.\"},{\"id\":\"1bc37a38-1c83-4731-b9ad-3fc85a06e58c\",\"key\":\"ppkText\",\"value\":\"Pay when each Play Kit ships\"},{\"id\":\"7d3b68cb-09ff-4838-9eb1-08c02741c5e9\",\"key\":\"pufSavingsAmountText\",\"value\":\"save {{amount}}\"},{\"id\":\"e5ec1e89-ee0c-489b-8e49-7873b824e4ba\",\"key\":\"pufElbowTooltip\",\"value\":\"We deliver Play Kits every 3 months starting when your child turns 1, so the value of your kit is greater.\"},{\"id\":\"f2cf84eb-dfb5-489d-aa83-f0fdd1f71a38\",\"key\":\"referralDiscount\",\"value\":\"Referral Discount\"},{\"id\":\"ec5bb06d-c202-4af3-8e24-2ade2364af81\",\"key\":\"paymentOptionsHeader\",\"value\":\"Choose Your Subscription Plan\"},{\"id\":\"e7d7d03a-d44e-46c3-9ebd-baf3068b39c4\",\"key\":\"pufCaptionTextLast\",\"value\":\"By selecting prepay \u0026 save, you will automatically continue on a pay per kit plan after your 3-kit bundle ships. You can manage your payment options at any time in your Account Settings.\"},{\"id\":\"1d1df950-0825-46a9-9cc6-ab06a9086d74\",\"key\":\"continueToOrder\",\"value\":\"Continue to Order Review\"},{\"id\":\"263db542-c3f4-4498-aa08-9e77c93b0ebc\",\"key\":\"paymentOptionDescription2Single\",\"value\":\"Plan automatically renews. Cancel or skip any time. Easy returns.\"},{\"id\":\"aaa37d75-82dd-4036-b067-dd7f6b7ec6cf\",\"key\":\"noCommitmentMessage\",\"value\":\"\u003cspan class=\\\"text-purple\\\"\u003eNo commitment:\u003c/span\u003e Skip or cancel any time.\"},{\"id\":\"82031ba8-fc4b-4bff-94f5-434fe0e795dd\",\"key\":\"insideThePlayKit\",\"value\":\"Inside the Play Kit\"},{\"id\":\"17173c76-ea7a-4fc6-8220-6d49d65f3cc9\",\"key\":\"keyFeatures\",\"value\":\"Key Features\"},{\"id\":\"553d3ebf-e0eb-48b7-9303-4737d825d804\",\"key\":\"referralCredit\",\"value\":\"Referral credit\"},{\"id\":\"112df95d-d6a0-4c30-b7cb-7b6ec048abf7\",\"key\":\"paymentOptionsPrepayWithBooksHeading\",\"value\":\"3-Kit prepay \u0026 save plus book bundle\"},{\"id\":\"1f8fd705-a61d-4443-a8e3-1aad0cdd1997\",\"key\":\"paymentOptionsPrepayWithBooksBody1\",\"value\":\"\u003cspan class=\\\"font-bold\\\"\u003eSave 5%\u003c/span\u003e on all Play Kits when you prepay\"},{\"id\":\"3a4379f5-4977-4da1-af9d-668f7ad5e60f\",\"key\":\"paymentOptionsPrepayWithBooksBody2\",\"