hildInfoNameLabel\",\"value\":\" Child's Name (Optional):\"},{\"id\":\"3fad411a-7043-41f6-a83f-9fa879a840d0\",\"key\":\"childInfoBirthLabel\",\"value\":\"Child's Birth Date / Due Date / Adjusted Birth Date:\"},{\"id\":\"8b851f38-c7f2-44fb-9476-83094803a5b8\",\"key\":\"contactLabel\",\"value\":\"contact us\"},{\"id\":\"fd0fca96-780c-43c8-83b6-f086c3a6d5c3\",\"key\":\"childInfoMonthOption\",\"value\":\"Month\"},{\"id\":\"432bd359-3560-4ab0-856f-b32bd0a36f5d\",\"key\":\"childInfoYearOption\",\"value\":\"Year\"},{\"id\":\"89a3c427-9c0b-458f-ad16-4ea5d20b3330\",\"key\":\"childInfoDayOption\",\"value\":\"Day\"},{\"id\":\"c7ab337b-9de9-4952-a483-9c675f724ace\",\"key\":\"startingKitChildInfo\",\"value\":\"Your child's info\"},{\"id\":\"44176808-8446-463c-86ee-74af3a9e79f3\",\"key\":\"edit\",\"value\":\"Edit\"},{\"id\":\"48901503-b0bc-4afb-8ed5-54e422de07a1\",\"key\":\"startingKitTitle\",\"value\":\"Step 2 of 3: {{childName}} Recommended Starting Play Kit\"},{\"id\":\"94ba0793-4681-4ac7-8637-eba586f3a401\",\"key\":\"startingKitIncludes\",\"value\":\"Your Subscription Program Includes:\"},{\"id\":\"52caadf4-bcc6-45d2-ab1e-dc24f611a5ef\",\"key\":\"startingKitFeature1\",\"value\":\"The Play Guide with expert tips, activity ideas, and development insight about your child's exact stage\"},{\"id\":\"794a0c34-0124-478d-8d64-b1abee951858\",\"key\":\"startingKitFeature2\",\"value\":\"Stage-based emails about what's going on with your child's development right now\"},{\"id\":\"2eb4152f-ac76-4089-99b3-ee6bf9e0bb5a\",\"key\":\"startingKitFeature3\",\"value\":\"Access to perks and special offers\"},{\"id\":\"caa970a3-59de-4173-874d-240788ddca02\",\"key\":\"startingKitEarlyTitle\",\"value\":\"Interested in a Play Kit from an earlier stage?\"},{\"id\":\"64a283c8-6ff6-441c-a8a3-7e403416a092\",\"key\":\"startingKitEarlySubtitle\",\"value\":\"Add early developmental learning from previous Kits by selecting from the below.\"},{\"id\":\"c68201ba-a4b7-4f29-9883-c93c392b356e\",\"key\":\"startingK