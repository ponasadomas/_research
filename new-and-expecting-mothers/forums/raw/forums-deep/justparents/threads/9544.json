      "post_id": "85006",
      "author_handle": "Alison1968",
      "date_as_displayed": "Posted 14 years 5 months ago",
      "body": "Does anyone have a recommendation of a family friendly hotel in London? Mum, Dad and three boys all under 10 would appreciate any thoughts!",
      "permalink": "https://www.justparents.co.uk/forums/topic-9544/#85006",
      "raw_file": "_raw/forums-deep/justparents/responses/f96e40bf9e5584983564.html",
      "page_url": "https://www.justparents.co.uk/forums/topic-9544/",
      "role": "original_post",
