07:50:31.000Z","lastActivityDate":"2026-10-23T13:04:16.000Z","cmntCount":1,"images":[],"giphies":[],"user":{"globalUserId":"q2iqjLU6UAzpKjgw","screenName":"ZeeSh12","imageUrl":null,"__typename":"UserPublic"},"updateUser":{"globalUserId":"q2iqjLU6UAzpKjgw","screenName":"ZeeSh12","imageUrl":null,"__typename":"UserPublic"},"group":{"globalUserId":"whMf8yQx0LEdBV72","id":"225","title":"Pregnancy","url":"/groups/a225/pregnancy","__typename":"Group"},"lastActivityUser":{"screenName":"Mama1to3","__typename":"UserPublic"},"reactions":{"types":[],"count":0,"__typename":"ReactionSummary"},"poll":null,"__typename":"Post"},{"id":"34142409","globalUserId":"tMYIHCr6TzrkQOMl","title":"Subchronic hematoma ","bodySnippet":"I'm 7 weeks pregnant with hematoma it started at 4 weeks, any one who h had positive results and overcome it. Tell me about the discarge ","url":"/post/a34142409/subchronic-hematoma","isSensitive":null,"createDate":"2026-10-19T19:44:24.000Z","updateDate":"2026-10-19T19:44:24.000Z","lastActivityDate":"2026-10-20T09:09:39.000Z","cmntCount":2,"images":[],"giphies":[],"user":{"globalUserId":"tMYIHCr6TzrkQOMl","screenName":"Tebitedwa","imageUrl":null,"__typename":"UserPublic"},"updateUser":{"globalUserId":"tMYIHCr6TzrkQOMl","screenName":"Tebitedwa","imageUrl":null,"__typename":"UserPublic"},"group":{"globalUserId":"whMf8yQx0LEdBV72","id":"225","title":"Pregnancy","url":"/groups/a225/pregnancy","__typename":"Group"},"lastActivityUser":{"screenName":"SamLou1586","__typename":"UserPublic"},"reactions":{"types":[],"count":0,"__typename":"ReactionSummary"},"poll":null,"__typename":"Post"},{"id":"34142326","globalUserId":"Gvdi94pGcR43e4Vd","title":"TMI (POSSIBLE MUCUS PLUG )‼️","bodySnippet":"Hi i used the bathroom and seen this im 39 weeks could this be my mucus plug ?","url":"/post/a34142326/tmi-possible-mucus-plug","isSensitive":true,"createDate":"2026-10-16T00:30:40.000Z","updateDate":"2026-10-16T00:30:40.000Z","lastActivityDate":"2026-10-18T23:41:07.000Z","cmntCount":1,