    width: 50%;
}
.amazon-image {
    position: relative;
	float: right;
	margin: 0 0 16px 16px;
	border: none !important;
}
.amazon-image:hover, .amazon-image:focus, .amazon-image:active {
    border: none !important;
}
.amazon-image span {
    position: absolute;
    bottom: 0;
    left: 0;
