Answer"},{"count":1,"__typename":"PollAnswer"}],"__typename":"Poll"},"__typename":"Post"},{"id":"78751799","globalUserId":"j0e0vPi481atqWa5","title":"C-Section recovery expectations ","bodySnippet":"Hi moms! I recently had an unplanned c-section, almost two weeks postpartum now. I’m wondering about other’s experiences recovering and any advice? I’m still feeling it’s difficult to walk much and have to take it easy with house chores, carrying my baby ect. I’m also still working on getting my mil","url":"/post/a78751799/csection-recovery-expectations","isSensitive":null,"createDate":"2026-10-24T01:28:35.000Z","updateDate":"2026-10-24T01:28:35.000Z","lastActivityDate":"2026-10-24T01:28:35.000Z","cmntCount":0,"images":[],"giphies":[],"user":{"globalUserId":"j0e0vPi481atqWa5","screenName":"Arlosmom2026","imageUrl":null,"__typename":"UserPublic"},"updateUser":{"globalUserId":"j0e0vPi481atqWa5","screenName":"Arlosmom2026","imageUrl":null,"__typename":"UserPublic"},"group":{"globalUserId":"Rkq9pHUA5YxK16QK","id":"85","title":"Pregnancy","url":"/groups/a85/pregnancy","__typename":"Group"},"lastActivityUser":null,"reactions":{"types":[],"count":0,"__typename":"ReactionSummary"},"poll":null,"__typename":"Post"},{"id":"78751783","globalUserId":"bJv4r72v2iuxsETc","title":"I think we finally decided!!","bodySnippet":"Just wanted to share because it’s taken us so long to decide. We think he will be Owen Murphy Sodders! Thanks for letting me post because we’re keeeping it a secret, but feels nice to “anonymously” share with people while we patiently wait for his arrival in a couple weeks. ","url":"/post/a78751783/i-think-we-finally-decided","isSensitive":null,"createDate":"2026-10-24T00:31:05.000Z","updateDate":"2026-10-24T00:31:05.000Z","lastActivityDate":"2026-10-24T01:52:45.000Z","cmntCount":2,"images":[],"giphies":[],"user":{"globalUserId":"bJv4r72v2iuxsETc","screenName":"kelismurphy","imageUrl":"https://imageserve.babycenter.com/8/000/009/glRGA1jYMSJRzUIFLHY6UlhGgSfO7uLQ_sq.jp