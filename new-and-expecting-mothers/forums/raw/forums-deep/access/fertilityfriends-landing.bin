        <script>
    function vsReadCookie(name) {
        let nameEQ = name + "=";
        let ca = document.cookie.split(";");
        let cValue = null;

        ca.forEach((entry) => {
        while (entry.charAt(0) === " ") {
            entry = entry.substring(1, entry.length);

            if (entry.indexOf(nameEQ) === 0) {
            cValue = entry.substring(nameEQ.length, entry.length);
            return;
            }
        }
        });
        return cValue;
    }
    let vsRetentionUrlParam = "utm_acquired_cohort";
    let vsRetentionCookieName = "vsretention";
    let vsRetentionCookieDuration = "";
    // if url string matches or the cookie exists already
    if (window.location.search.indexOf(vsRetentionUrlParam) >= 0 || 0) {
        let pageQueryParams = new URLSearchParams(window.location.search);
        let vsRetentionDate = pageQueryParams.get(vsRetentionUrlParam);
        if (typeof(vsRetentionCookieDuration) !== 'undefined' && vsRetentionCookieDuration !== '' && vsRetentionDate !== null) {
            const d = new Date();
            d.setTime(d.getTime() + vsRetentionCookieDuration * 1000);
            document.cookie = `${vsRetentionCookieName}=${vsRetentionDate};path=/;expires=${d.toGMTString()}`;
            ;
        } else if (vsRetentionDate !== null){
            document.cookie = `${vsRetentionCookieName}=${vsRetentionDate};path=/;`;
        }
        vsRetentionDate = vsReadCookie(vsRetentionCookieName);
        if (adsJSON.pageLevelKVTargeting.revenueExp) {
            if (Array.isArray(adsJSON.pageLevelKVTargeting.revenueExp)) {
                adsJSON.pageLevelKVTargeting.revenueExp.push('retention');
            } else {
                adsJSON.pageLevelKVTargeting.revenueExp = [adsJSON.pageLevelKVTargeting.revenueExp, 'retention'];
            }
        } else {
            adsJSON.pageLevelKVTargeting.revenueExp = ['retention'];
        }
        if (adsJSON.pageLevelKVTargeting['retention']) {
            if (Array.isArray(adsJSON.pageLevelKVTargeting['retention'])) {
                adsJSON.pageLevelKVTargeting['retention'].push(vsRetentionDate);
            } else {
                adsJSON.pageLevelKVTargeting['retention'] = [adsJSON.pageLevelKVTargeting['retention'], vsRetentionDate];
            }
        } else {
            adsJSON.pageLevelKVTargeting['retention'] = vsRetentionDate;
        }
}
</script>

    
    
