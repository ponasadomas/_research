<style>

    .cookieScrollBar {
        height: 150px;
        overflow-y: scroll;
    }
</style>    <script>
        $(document).ready(function () {

            // Prevent scroll jump
            function freezeScroll() {
                window.savedScroll = window.scrollY;
                document.body.style.position = 'fixed';
                document.body.style.top = `-${window.savedScroll}px`;
                document.body.style.width = '100%';
            }

            function restoreScroll() {
                document.body.style.position = '';
                document.body.style.top = '';
                window.scrollTo(0, window.savedScroll || 0);
            }

            function safeClick(elementId) {
                const btn = document.getElementById(elementId);
                if (btn) {
                    freezeScroll();
                    btn.click();
                    setTimeout(restoreScroll, 500);
                }
            }

            const popupKey = "tpPopupShown";

            if (!localStorage.getItem(popupKey)) {

                setTimeout(function () {
                    safeClick('ST_HOME_AdBTN');
                }, 7000);

                $('#model-header .close').on('click', function () {
                    safeClick('ST_HOME_JOINBTN');
                });

                localStorage.setItem(popupKey, "true");
            }
        });
    </script>

    </div>
    <div class="float-right" style="margin-right:90px">
        <p> <a id="ST_HOME_COOKIEPOLICY" data-toggle="modal" data-target="#CookieModel" href="#">Cookie Policy</a> | <a href="https://www.ohbaby.co.nz/information/terms-and-conditions">Terms & Conditions </a> | <a href="https://www.ohbaby.co.nz/information/privacy">Privacy policy </a> | Copyright © 2026 www.ohbaby.co.nz. All Rights reserved.  </p>
    </div>
