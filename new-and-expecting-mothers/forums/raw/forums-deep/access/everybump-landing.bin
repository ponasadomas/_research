<!--CT: Ad Placement-->

<style>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fadeOut {
    from { opacity: 1; }
    to { opacity: 0; }
  }

  .fade-in {
    animation: fadeIn 2s forwards;
  }

  .fade-out {
    animation: fadeOut 2s forwards;
  }

  .ipsType_huge {
    font-size: 64px;
    line-height: 1.11;
  }

  .ipsType_large {
    font-size: 16px;
    line-height: 1.25;
  }

  .ipsType_normal {
    font-size: 14px;
    line-height: 1.5;
  }

  .banner {
    font-size: 12px;
    text-transform: uppercase;
    margin-bottom: 5px;
    color: #006a87;
  }
</style>

<div id="bannerArea" class="ipsWidget" style="display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:10px 0;margin-bottom:15px;min-height:296.3px">
  <div id="bannerContent" style="display:flex;flex-direction:column;align-items:center;justify-content:center;">
    <span id="bannerHeading" class="banner"></span>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  var isFluidView = $('.fa-th-list').parent().hasClass('ipsButton_primary');

  if (isFluidView) {
    var activeTopics = $("h3.ipsWidget_title.ipsType_reset:contains('Active Topics')").closest('.cWidgetContainer');
    var hr = activeTopics.siblings('hr');

    activeTopics.hide();
    hr.hide();
  }

  var banners = [];
  var timer = false;

  const QUEUE_KEY = "eb_hero_queue";
  const BASE_DELAY = 15000;

  fetch('/banners.php')
    .then(response => response.json())
    .then(data => {
      banners = data;

      if (!banners || banners.length === 0) {
        return;
      }

      detectAdblock((adBlockerDetected) => {
        if (adBlockerDetected) {
          displayAdblockMessage();
          return;
        }

        const firstBanner = getNextBanner();

        if (!firstBanner) return;

        setBannerContent(
          firstBanner,
          document.getElementById('bannerContent')
        );

        // First rotation occurs after 15 seconds.
        timer = setInterval(updateBanner, BASE_DELAY);
      });
    })
    .catch(error => {
      console.error('Error fetching banners:', error);

      var bannerArea = document.getElementById('bannerContent');

      if (bannerArea) {
        bannerArea.innerHTML =
          '<p style="text-align: center;">Unable to load banners at this time.</p>';
      }
    });

  function detectAdblock(callback) {
    const bait = document.createElement('div');

    bait.className = 'adsbox ad-banner advertisement';
    bait.style.position = 'absolute';
    bait.style.left = '-9999px';
    bait.style.top = '-9999px';
    bait.style.width = '1px';
    bait.style.height = '1px';
    bait.style.pointerEvents = 'none';

    document.body.appendChild(bait);

    setTimeout(() => {
      const blocked =
        bait.offsetHeight === 0 ||
        bait.offsetWidth === 0 ||
        window.getComputedStyle(bait).display === 'none' ||
        window.getComputedStyle(bait).visibility === 'hidden';

      bait.remove();

      if (typeof callback === 'function') {
        callback(blocked);
      }
    }, 100);
  }

  function displayAdblockMessage() {
    var bannerArea = document.getElementById('bannerContent');

    if (!bannerArea) return;

    bannerArea.style.flex = 1;
    bannerArea.innerHTML = '';

    var iconSpan = document.createElement('span');
    iconSpan.classList.add('ipsType_huge');

    var iconElement = document.createElement('i');
    iconElement.classList.add(
      'fa',
      'fa-face-sad-tear',
      'ipsType_neutral'
    );

    iconSpan.appendChild(iconElement);
    bannerArea.appendChild(iconSpan);

    var paragraph1 = document.createElement('p');
    paragraph1.textContent = 'Please disable your ad blocker!';
    paragraph1.style.textAlign = 'center';
    paragraph1.style.padding = '0px 10px';
    paragraph1.style.fontWeight = 'bold';
    paragraph1.classList.add('ipsType_issue', 'ipsType_large');

    var paragraph2 = document.createElement('p');
    paragraph2.textContent =
      'Everybump relies on advertising to keep our community running.';
    paragraph2.style.textAlign = 'center';
    paragraph2.style.padding = '0px 10px';
    paragraph2.style.margin = '0px';
    paragraph2.classList.add('ipsType_normal');

    bannerArea.appendChild(paragraph1);
    bannerArea.appendChild(paragraph2);

    if (timer) {
      clearInterval(timer);
      timer = false;
    }
  }

  function selectFirstBanner() {
    const totalWeight = banners.reduce(
      (sum, banner) => sum + (banner.percentage || 1),
      0
    );

    const random = Math.random() * totalWeight;
    let cumulativeWeight = 0;

    for (const banner of banners) {
      cumulativeWeight += banner.percentage || 1;

      if (random <= cumulativeWeight) {
        return banner;
      }
    }

    return banners[0] || null;
  }

  function buildQueue() {
    const firstBanner = selectFirstBanner();

    if (!firstBanner) {
      sessionStorage.setItem(QUEUE_KEY, JSON.stringify([]));
      return;
    }

    const remaining = banners.filter(
      b => b.id !== firstBanner.id
    );

    for (let i = remaining.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));

      [remaining[i], remaining[j]] =
        [remaining[j], remaining[i]];
    }

    const queue = [firstBanner, ...remaining];

    sessionStorage.setItem(
      QUEUE_KEY,
      JSON.stringify(queue)
    );
  }

  function getNextBanner() {
    let queue = JSON.parse(
      sessionStorage.getItem(QUEUE_KEY) || '[]'
    );

    if (!queue.length) {
      buildQueue();

      queue = JSON.parse(
        sessionStorage.getItem(QUEUE_KEY) || '[]'
      );
    }

    const nextBanner = queue.shift() || null;

    sessionStorage.setItem(
      QUEUE_KEY,
      JSON.stringify(queue)
    );

    return nextBanner;
  }

  function updateBanner() {
    var bannerArea =
      document.getElementById('bannerContent');

    if (!bannerArea) return;

    bannerArea.classList.remove('fade-in');
    bannerArea.classList.add('fade-out');

    setTimeout(() => {
      const selectedBanner = getNextBanner();

      if (!selectedBanner) return;

      setBannerContent(
        selectedBanner,
        bannerArea
      );

      bannerArea.classList.remove('fade-out');
      bannerArea.classList.add('fade-in');

    }, 2000);
  }

  function setBannerContent(selectedBanner, bannerArea) {
    if (!bannerArea || !selectedBanner) return;

    bannerArea.innerHTML =
      '<span id="bannerHeading" class="banner"></span>';

    document.getElementById('bannerHeading').innerHTML =
      selectedBanner.headingHtml;

    var link = document.createElement('a');

    link.href = selectedBanner.linkUrl;
    link.referrerPolicy = 'no-referrer-when-downgrade';
    link.rel = 'nofollow sponsored';
    link.target = '_blank';

    var img = document.createElement('img');

    img.src = selectedBanner.imageUrl;
    img.referrerPolicy = 'no-referrer-when-downgrade';
    img.style.border = 'none';
    img.style.verticalAlign = 'middle';
    img.style.maxWidth = '300px';

    link.appendChild(img);
    bannerArea.appendChild(link);
  }
});
</script>

				
				
				
				



    
    



