<div id="bannerAreaSmall" style="display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:10px 0;">
  <div id="bannerContentSmall" style="display:flex;flex-direction:column;align-items:center;justify-content:center;">
  </div>
</div>

<script>

window.addEventListener('resize', () => {
  const bannerAreaSmall = document.getElementById('bannerContentSmall');
  if (bannerAreaSmall) {
    bannerAreaSmall.style.height = 'auto';
  }
});

document.addEventListener('DOMContentLoaded', function () {

  var bannersSmall = [];
  var timerSmall = false;

  const QUEUE_KEY = "eb_sidebar_small_queue";

  fetch('/banners.php?type=sidebar')
    .then(response => response.json())
    .then(data => {
      bannersSmall = data;

      if (!bannersSmall || bannersSmall.length === 0) {
        return;
      }

      const firstBanner = selectFirstBannerSmall();

      if (!firstBanner) return;

      setBannerContentSmall(firstBanner, document.getElementById('bannerContentSmall'));

      buildQueueSmall(firstBanner);

      const baseDelay = 15000;
      const randomOffset = Math.floor(Math.random() * 4000) + 1000;

      /*
      * 07/10/2026
      * Initial rotation timing corrected so the first banner remains displayed
      * for the normal rotation interval before the random offset is applied.
      *
      * Previously the initial timeout used only randomOffset, which caused the
      * first transition to begin 1-5 seconds after page load rather than after
      * the normal 15-second rotation interval.
      *
      * Subsequent rotations remain unchanged at 15 seconds.
      */
      setTimeout(() => {
        updateBannerSmall();
        timerSmall = setInterval(updateBannerSmall, baseDelay);
      }, baseDelay + randomOffset);
    })
    .catch(error => {
      console.error('Error fetching banners:', error);
      var bannerAreaSmall = document.getElementById('bannerContentSmall');
      if (bannerAreaSmall) {
        bannerAreaSmall.innerHTML = '<p style="text-align: center;">Unable to load banners at this time.</p>';
      }
    });

  function selectFirstBannerSmall() {

    const totalWeight = bannersSmall.reduce((sum, banner) => sum + (banner.percentage || 1), 0);
    const random = Math.random() * totalWeight;
    let cumulativeWeight = 0;

    for (const banner of bannersSmall) {
      cumulativeWeight += banner.percentage || 1;
      if (random <= cumulativeWeight) {
        return banner;
      }
    }

    return bannersSmall[0];

  }

  function buildQueueSmall(firstBanner) {

    const remaining = bannersSmall.filter(b => b.id !== firstBanner.id);

    for (let i = remaining.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [remaining[i], remaining[j]] = [remaining[j], remaining[i]];
    }

    sessionStorage.setItem(QUEUE_KEY, JSON.stringify(remaining));

  }

  function getNextBannerSmall() {

    let queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');

    if (queue.length === 0) {
      const firstBanner = selectFirstBannerSmall();
      if (!firstBanner) return null;
      buildQueueSmall(firstBanner);
      queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');
    }

    const nextBanner = queue.shift();

    sessionStorage.setItem(QUEUE_KEY, JSON.stringify(queue));

    return nextBanner;

  }

  function updateBannerSmall() {

    const bannerAreaSmall = document.getElementById('bannerContentSmall');

    if (!bannerAreaSmall) return;

    bannerAreaSmall.style.height = bannerAreaSmall.offsetHeight + 'px';
    bannerAreaSmall.style.transition = 'height 0.3s ease';

    bannerAreaSmall.classList.remove('fade-in');
    bannerAreaSmall.classList.add('fade-out');

    setTimeout(() => {

      const banner = getNextBannerSmall();

      if (!banner) return;

      setBannerContentSmall(banner, bannerAreaSmall);

      bannerAreaSmall.classList.remove('fade-out');
      bannerAreaSmall.classList.add('fade-in');

    }, 2000);

  }

  function setBannerContentSmall(selectedBanner, bannerAreaSmall) {

    if (!bannerAreaSmall || !selectedBanner) return;

    bannerAreaSmall.innerHTML = '';

    var link = document.createElement('a');
    link.href = selectedBanner.linkUrl;
    link.referrerPolicy = 'no-referrer-when-downgrade';
    link.rel = 'nofollow sponsored';
    link.target = '_blank';

    var img = document.createElement('img');
    img.src = selectedBanner.imageUrl;
    img.style.border = 'none';
    img.style.verticalAlign = 'middle';
    img.style.padding = '0px 10px';
    img.style.maxWidth = '100%';

    link.appendChild(img);
    bannerAreaSmall.appendChild(link);

  }

});
</script>
            </div>
        </div>
        
    

    
</section>

    
        



