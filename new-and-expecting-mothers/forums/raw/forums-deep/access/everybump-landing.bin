(function () {
  var config = {
    delaySeconds: 60,
    dismissDays: 7,
    registerUrl: "/community/register/",
    dismissedUntilKey: "eb_guest_popup_dismissed_until",
    firstSeenKey: "eb_guest_popup_first_seen"
  };

  function now() {
    return new Date().getTime();
  }

  function getStorageValue(key) {
    try {
      return localStorage.getItem(key);
    } catch (error) {
      return null;
    }
  }

  function setStorageValue(key, value) {
    try {
      localStorage.setItem(key, value);
      return true;
    } catch (error) {
      return false;
    }
  }

  function removeStorageValue(key) {
    try {
      localStorage.removeItem(key);
      return true;
    } catch (error) {
      return false;
    }
  }

  function getDismissedUntil() {
    return parseInt(getStorageValue(config.dismissedUntilKey) || "0", 10);
  }

  function setDismissed() {
    var until = now() + config.dismissDays * 24 * 60 * 60 * 1000;

    setStorageValue(config.dismissedUntilKey, String(until));
    removeStorageValue(config.firstSeenKey);
  }

  function getFirstSeen() {
    var stored = parseInt(getStorageValue(config.firstSeenKey) || "0", 10);

    if (stored > 0) {
      return stored;
    }

    var firstSeen = now();
    setStorageValue(config.firstSeenKey, String(firstSeen));

    return firstSeen;
  }

  function getRemainingDelayMs() {
    var firstSeen = getFirstSeen();
    var elapsedMs = now() - firstSeen;
    var requiredMs = config.delaySeconds * 1000;

    return Math.max(requiredMs - elapsedMs, 0);
  }

  function appearsLoggedIn() {
    return !!document.querySelector("#cUserLink, [data-el='user']");
  }

  function isAuthPage() {
    var path = window.location.pathname.toLowerCase();

    return (
      path.indexOf("/community/register") !== -1 ||
      path.indexOf("/community/login") !== -1 ||
      path.indexOf("/community/lostpassword") !== -1
    );
  }

  function createPopup() {
    var overlay = document.createElement("div");

    overlay.className = "eb-guest-popup-overlay";
    overlay.id = "ebGuestPopup";
    overlay.setAttribute("aria-hidden", "true");

    overlay.innerHTML = [
      '<div class="eb-guest-popup" role="dialog" aria-modal="true" aria-labelledby="ebGuestPopupTitle">',
        '<button class="eb-guest-popup-close" type="button" data-eb-guest-popup-close aria-label="Close">×</button>',

        '<p class="eb-guest-popup-kicker">New here?</p>',

        '<h2 class="eb-guest-popup-title" id="ebGuestPopupTitle">You have found one of Australia\'s long-running communities.</h2>',

        '<p class="eb-guest-popup-text">',
          'Everybump is a friendly Australian community for women, parents and carers talking about family, support and everyday life.',
        '</p>',

        '<ul class="eb-guest-popup-list">',
          '<li>Join active discussions with real people.</li>',
          '<li>Ask questions and share your experience.</li>',
          '<li>Access member-only discussions.</li>',
          '<li>Read plain-English Australian guides and resources.</li>',
        '</ul>',

        '<div class="eb-guest-popup-actions">',
          '<a class="ipsButton ipsButton--primary eb-guest-popup-action" href="' + config.registerUrl + '" data-eb-guest-popup-register>Join Everybump</a>',
          '<button class="ipsButton ipsButton--inherit eb-guest-popup-action" type="button" data-eb-guest-popup-close>Keep browsing</button>',
        '</div>',
      '</div>'
    ].join("");

    document.body.appendChild(overlay);

    overlay.querySelectorAll("[data-eb-guest-popup-close]").forEach(function (button) {
      button.addEventListener("click", function () {
        closePopup(overlay);
      });
    });

    var registerButton = overlay.querySelector("[data-eb-guest-popup-register]");

    if (registerButton) {
      registerButton.addEventListener("click", function () {
        setDismissed();
      });
    }

    overlay.addEventListener("click", function (event) {
      if (event.target === overlay) {
        closePopup(overlay);
      }
    });

    document.addEventListener("keydown", function (event) {
      if (event.key === "Escape" && overlay.classList.contains("is-visible")) {
        closePopup(overlay);
      }
    });

    return overlay;
  }

  function showPopup(overlay) {
    if (appearsLoggedIn()) return;
    if (isAuthPage()) return;
    if (getDismissedUntil() > now()) return;

    overlay.classList.add("is-visible");
    overlay.setAttribute("aria-hidden", "false");
  }

  function closePopup(overlay) {
    overlay.classList.remove("is-visible");
    overlay.setAttribute("aria-hidden", "true");
    setDismissed();
  }

  function initGuestPopup() {
    if (document.getElementById("ebGuestPopup")) return;
    if (appearsLoggedIn()) return;
    if (isAuthPage()) return;
    if (getDismissedUntil() > now()) return;

    var overlay = createPopup();
    var remainingDelayMs = getRemainingDelayMs();

    window.setTimeout(function () {
      showPopup(overlay);
    }, remainingDelayMs);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGuestPopup);
  } else {
    initGuestPopup();
  }
})();


/* =========================================================
   Everybump 6th Birthday Confetti
   Active: 22–24 October 2026
   Once per day, per browser
   ========================================================= */

(function () {
  
  const storageKey = "eb-birthday-last-shown";

  // Use Melbourne time regardless of visitor location
  const parts = new Intl.DateTimeFormat("en-GB", {
    timeZone: "Australia/Melbourne",
    year: "numeric",
    month: "2-digit",
    day: "2-digit"
  }).formatToParts(new Date());

  const datePart = type => parts.find(p => p.type === type).value;
  const today = `${datePart("year")}-${datePart("month")}-${datePart("day")}`;

  
// Every year, 22–24 October (Melbourne time)
const month = datePart("month");
const day = Number(datePart("day"));

if (month !== "10" || day < 22 || day > 24) return;


  // Respect accessibility preferences
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

  // Only celebrate once each day
  try {
    if (localStorage.getItem(storageKey) === today) return;
  } catch (e) {}

  function launchBirthdayConfetti() {
    if (document.getElementById("ebBirthdayConfetti")) return;

    const layer = document.createElement("div");
    layer.id = "ebBirthdayConfetti";

    Object.assign(layer.style, {
      position: "fixed",
      inset: "0",
      overflow: "hidden",
      pointerEvents: "none",
      zIndex: "99999"
    });

    document.body.appendChild(layer);

    const colours = [
      "#ff4d6d", "#ffca3a", "#8ac926",
      "#1982c4", "#b388eb", "#ff924c",
      "#00c9a7", "#ff66c4"
    ];

    const width = window.innerWidth;
    const height = window.innerHeight;
    const count = width < 600 ? 45 : 100;

    for (let i = 0; i < count; i++) {
      const leftSide = i % 2 === 0;
      const direction = leftSide ? 1 : -1;

      const piece = document.createElement("span");
      const size = 4 + Math.random() * 6;

      Object.assign(piece.style, {
        position: "absolute",
        bottom: "0",
        left: leftSide ? "0" : "100%",
        width: `${size}px`,
        height: `${size * (1 + Math.random())}px`,
        backgroundColor: colours[Math.floor(Math.random() * colours.length)],
        borderRadius: Math.random() > 0.7 ? "50%" : "1px",
        willChange: "transform, opacity"
      });

      layer.appendChild(piece);

      // Burst upwards from bottom corners
      const burstX = direction * width * (0.1 + Math.random() * 0.45);
      const burstY = -height * (0.35 + Math.random() * 0.5);

      // Drift and tumble back down
      const driftX = burstX + (Math.random() - 0.5) * 200;
      const rotation = 360 + Math.random() * 900;

      piece.animate([
        {
          transform: "translate(0, 0) rotate(0deg)",
          opacity: 1,
          offset: 0
        },
        {
          transform: `translate(${burstX}px, ${burstY}px) rotate(${rotation}deg)`,
          opacity: 1,
          offset: 0.35
        },
        {
          transform: `translate(${driftX}px, ${height * 0.2}px) rotate(${rotation * 2}deg)`,
          opacity: 0,
          offset: 1
        }
      ], {
        duration: 3500 + Math.random() * 1000,
        delay: Math.random() * 250,
        easing: "ease-out",
        fill: "forwards"
      });
    }

    // Remember that today's celebration has played
    try {
      localStorage.setItem(storageKey, today);
    } catch (e) {}

    // Clean up everything afterwards
    window.setTimeout(() => {
      layer.remove();
    }, 5000);
  }

  function initBirthdayConfetti() {
    window.setTimeout(launchBirthdayConfetti, 500);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initBirthdayConfetti, { once: true });
  } else {
    initBirthdayConfetti();
  }
})();

</script>


