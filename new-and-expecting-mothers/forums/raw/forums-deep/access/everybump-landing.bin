<section
	class="cWidgetContainer cWidgetContainer--isWidget"
	
	data-role='widgetReceiver'
	data-orientation='horizontal'
	data-widgetArea='header'
	style=""
	
	    data-widget-layout="table"
    
	    data-widget-area-id="9"
    
	    data-widget-full-width-items=""
    
	    data-widget-show-images="1"
    
	    data-widget-orientation="horizontal"
    
	    data-restrict-nesting="1"
    
    
>
    
    
    

    
        
        <div class="ipsWidget__content--wrap">
            <div
                class='ipsWidget ipsWidget--horizontal'  data-blocktitle="Custom Blocks" data-blockID="app_cms_Blocks_563db5dd" data-blockErrorMessage="This block cannot be shown. This could be because it needs configuring, is unable to show on this page, or will show after reloading this page." data-menuStyle="menu" data-blockConfig="1"
                data-controller='core.front.widgets.block'
            >
                
                
<div id="bannerAreaBottom" style="display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:10px 0;">
  <div id="bannerContentBottom" style="display:flex;flex-direction:column;align-items:center;justify-content:center;">
  </div>
</div>

<script>
window.addEventListener('resize', () => {
  const bannerAreaBottom = document.getElementById('bannerContentBottom');
  if (bannerAreaBottom) {
    bannerAreaBottom.style.height = 'auto';
  }
});

document.addEventListener('DOMContentLoaded', function () {
  var bannersBottom = [];
  var timerBottom = false;

  const QUEUE_KEY = "eb_leaderboard_queue_bottom";
  const RECENT_KEY = "eb_leaderboard_recent";
  const PAGE_KEY = "eb_leaderboard_current_page";
  const PLACEMENT_NAME = "bottom";
  const RECENT_LIMIT = 6;

  fetch('/banners.php?type=leaderboard')
    .then(response => response.json())
    .then(data => {
      bannersBottom = data;

      if (!bannersBottom || bannersBottom.length === 0) {
        return;
      }

      waitForTopThenStartBottom();
    })
    .catch(error => {
      console.error('Error fetching banners:', error);
      var bannerAreaBottom = document.getElementById('bannerContentBottom');
      if (bannerAreaBottom) {
        bannerAreaBottom.innerHTML = '<p style="text-align: center;">Unable to load banners at this time.</p>';
      }
    });

  function getRecentBannerIdsBottom() {
    try {
      return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
    } catch (e) {
      return [];
    }
  }

  function addRecentBannerBottom(id) {
    const recent = getRecentBannerIdsBottom().filter(x => x !== id);
    recent.unshift(id);
    localStorage.setItem(RECENT_KEY, JSON.stringify(recent.slice(0, RECENT_LIMIT)));
  }

  function getCurrentPageSelectionsBottom() {
    try {
      return JSON.parse(sessionStorage.getItem(PAGE_KEY) || '{}');
    } catch (e) {
      return {};
    }
  }

  function setCurrentPageSelectionBottom(id) {
    const current = getCurrentPageSelectionsBottom();
    current[PLACEMENT_NAME] = id;
    sessionStorage.setItem(PAGE_KEY, JSON.stringify(current));
  }

  function getOtherPlacementCurrentIdsBottom() {
    const current = getCurrentPageSelectionsBottom();

    return Object.entries(current)
      .filter(([placement]) => placement !== PLACEMENT_NAME)
      .map(([, id]) => id)
      .filter(Boolean);
  }

  function getHardExcludedBannerIdsBottom(excludeId) {
    let hardExcluded = getOtherPlacementCurrentIdsBottom();

    if (excludeId) {
      hardExcluded = hardExcluded.filter(id => id !== excludeId);
    }

    return [...new Set(hardExcluded)];
  }

  function getEligibleBannersBottom(excludeId) {
    const recent = getRecentBannerIdsBottom();
    const hardExcluded = getHardExcludedBannerIdsBottom(excludeId);

    let eligible = bannersBottom.filter(b => {
      if (excludeId && b.id === excludeId) return false;
      if (hardExcluded.includes(b.id)) return false;
      return !recent.includes(b.id);
    });

    if (eligible.length === 0) {
      eligible = bannersBottom.filter(b => {
        if (excludeId && b.id === excludeId) return false;
        if (hardExcluded.includes(b.id)) return false;
        return true;
      });
    }

    return eligible;
  }

  function selectWeightedBannerBottom(pool) {
    if (!pool || pool.length === 0) return null;

    const totalWeight = pool.reduce((sum, banner) => sum + (banner.percentage || 1), 0);
    const random = Math.random() * totalWeight;
    let cumulativeWeight = 0;

    for (const banner of pool) {
      cumulativeWeight += banner.percentage || 1;
      if (random <= cumulativeWeight) {
        return banner;
      }
    }

    return pool[0];
  }

  function selectFirstBannerBottom() {
    const eligible = getEligibleBannersBottom();
    return selectWeightedBannerBottom(eligible);
  }

  function buildQueueBottom(firstBanner) {
    const eligible = getEligibleBannersBottom(firstBanner.id);
    const fallback = bannersBottom.filter(b =>
      b.id !== firstBanner.id &&
      !eligible.some(e => e.id === b.id) &&
      !getHardExcludedBannerIdsBottom(firstBanner.id).includes(b.id)
    );

    for (let i = eligible.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [eligible[i], eligible[j]] = [eligible[j], eligible[i]];
    }

    for (let i = fallback.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [fallback[i], fallback[j]] = [fallback[j], fallback[i]];
    }

    const queue = [...eligible, ...fallback];
    sessionStorage.setItem(QUEUE_KEY, JSON.stringify(queue));
  }

  function getNextBannerBottom() {
    let queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');

    if (queue.length === 0) {
      const firstBanner = selectFirstBannerBottom();
      if (!firstBanner) return null;
      buildQueueBottom(firstBanner);
      queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');
    }

    return queue.shift();
  }

  function saveQueueBottom(queue) {
    sessionStorage.setItem(QUEUE_KEY, JSON.stringify(queue));
  }

  function waitForTopThenStartBottom() {
    const maxWaitMs = 2000;
    const pollEveryMs = 50;
    const startedAt = Date.now();

    const check = () => {
      const current = getCurrentPageSelectionsBottom();
      const topId = current.top || null;

      if (topId || (Date.now() - startedAt) >= maxWaitMs) {
        startBottomWidget();
        return;
      }

      setTimeout(check, pollEveryMs);
    };

    check();
  }

  function startBottomWidget() {
    const firstBanner = selectFirstBannerBottom();
    if (!firstBanner) return;

    setBannerContentBottom(firstBanner, document.getElementById('bannerContentBottom'));
    setCurrentPageSelectionBottom(firstBanner.id);
    addRecentBannerBottom(firstBanner.id);
    buildQueueBottom(firstBanner);

    const baseDelay = 15000;
    const phaseOffset = 7000;
    const randomOffset = Math.floor(Math.random() * 1500);

    /*
    * 07/10/2026
    * Initial rotation timing corrected so the first banner remains displayed
    * for the normal rotation interval before the placement-specific offset
    * is applied.
    *
    * Previously the initial timeout used only phaseOffset + randomOffset,
    * which caused the first transition to begin earlier than the normal
    * 15-second rotation interval.
    *
    * Subsequent rotations remain unchanged at 15 seconds.
    */
    setTimeout(() => {
      updateBannerBottom();
      timerBottom = setInterval(updateBannerBottom, baseDelay);
    }, baseDelay + phaseOffset + randomOffset);
  }

  function updateBannerBottom() {
    const bannerAreaBottom = document.getElementById('bannerContentBottom');
    if (!bannerAreaBottom) return;

    bannerAreaBottom.style.height = bannerAreaBottom.offsetHeight + 'px';
    bannerAreaBottom.style.transition = 'height 0.3s ease';

    bannerAreaBottom.classList.remove('fade-in');
    bannerAreaBottom.classList.add('fade-out');

    setTimeout(() => {
      const otherCurrentIds = getOtherPlacementCurrentIdsBottom();
      let queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');

      if (queue.length === 0) {
        const firstBanner = selectFirstBannerBottom();
        if (!firstBanner) return;
        buildQueueBottom(firstBanner);
        queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');
      }

      let nextIndex = queue.findIndex(b => !otherCurrentIds.includes(b.id));
      if (nextIndex === -1) nextIndex = 0;

      const banner = queue.splice(nextIndex, 1)[0];
      saveQueueBottom(queue);

      if (!banner) return;

      setBannerContentBottom(banner, bannerAreaBottom);
      setCurrentPageSelectionBottom(banner.id);
      addRecentBannerBottom(banner.id);

      bannerAreaBottom.classList.remove('fade-out');
      bannerAreaBottom.classList.add('fade-in');
    }, 2000);
  }

  function setBannerContentBottom(selectedBanner, bannerAreaBottom) {
    if (!bannerAreaBottom || !selectedBanner) return;

    bannerAreaBottom.innerHTML = '';

    var link = document.createElement('a');
    link.href = selectedBanner.linkUrl;
    link.referrerPolicy = 'no-referrer-when-downgrade';
    link.rel = 'nofollow sponsored';
    link.target = '_blank';

    var img = document.createElement('img');
    img.src = selectedBanner.imageUrl;
    img.style.border = 'none';
    img.style.verticalAlign = 'middle';
    img.style.padding = '0px 10px';
    img.style.maxWidth = '100%';

    link.appendChild(img);
    bannerAreaBottom.appendChild(link);
  }
});
</script>
            </div>
        </div>
        
    

    
</section>

    
        



