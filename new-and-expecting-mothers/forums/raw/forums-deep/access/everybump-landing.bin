<!-- Theme javascript -->
<script>
    
// Create the button
let backToTopBtn = document.createElement("a");
backToTopBtn.id = "backToTopBtn"; // Assign an ID for CSS targeting
backToTopBtn.className = "ipsButton ipsButton--primary";
backToTopBtn.href = "javascript:void(0)";
backToTopBtn.innerHTML = '<i class="fa-solid fa-chevron-up"></i>'; // Up-chevron icon

// Add to the document
document.body.appendChild(backToTopBtn);

// Show/hide button on scroll
window.addEventListener("scroll", function () {
    if (document.documentElement.scrollTop > 100 || document.body.scrollTop > 100) {
        backToTopBtn.style.opacity = "0.75"; // Visible at 75%
        backToTopBtn.style.pointerEvents = "all"; // Enable clicks when visible
    } else {
        backToTopBtn.style.opacity = "0";
        backToTopBtn.style.pointerEvents = "none"; // Prevent interactions when hidden
    }
});

// Scroll to top when clicked
backToTopBtn.addEventListener("click", function () {
    window.scrollTo({ top: 0, behavior: "smooth" });
});

document.querySelectorAll('i.fa-regular.fa-file-lines').forEach(icon => {
  const span = icon.closest('span');
  if (!span) return;

  const text = span.textContent.trim();
  const number = parseInt(text.replace(/[^\d]/g, ''), 10);

  if (!isNaN(number) && number >= 100) {
    span.style.color = 'darkred';
  }
});

document.addEventListener("DOMContentLoaded", () => {

  if (window.location.pathname === "/community/forums/forum/81-gone-anon/" &&
      window.location.search.includes("do=add")) {

    const checkbox = document.getElementById("check_post_anonymously");

    if (checkbox && !checkbox.checked) {
      checkbox.checked = true;
      checkbox.dispatchEvent(new Event("change", { bubbles: true }));
    }
  }

  function normaliseDoubleQuotes(text) {
    let out = "";
    let inQuote = false;

    for (let i = 0; i < text.length; i++) {
      const ch = text[i];

      if (ch !== '"') {
        out += ch;
        continue;
      }

      if (!inQuote) {
        // Opening quote
        // If it's stuck to a word, add a space before it: word"thing -> word "thing
        if (out.length && /\w/.test(out[out.length - 1])) out += " ";
        out += '"';

        // Trim spaces immediately after opening quote
        while (i + 1 < text.length && text[i + 1] === " ") i++;

        inQuote = true;
      } else {
        // Closing quote
        // Trim spaces immediately before closing quote
        while (out.length && out[out.length - 1] === " ") out = out.slice(0, -1);
        out += '"';

        // If it's stuck to the next word, add a space after it: "thing"next -> "thing" next
        const next = text[i + 1];
        if (next && /\w/.test(next)) out += " ";

        inQuote = false;
      }
    }

    return out;
  }

  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);

  let node;
  while ((node = walker.nextNode())) {
    const original = node.nodeValue;

    // Parentheses: trim spaces just inside ( and )
    let updated = original
      .replace(/\(\s+/g, "(")
      .replace(/\s+\)/g, ")");

    // Quotes: trim spaces inside, and fix missing spaces outside when quotes are jammed to words
    updated = normaliseDoubleQuotes(updated);

    if (updated !== original) node.nodeValue = updated;
  }
});





