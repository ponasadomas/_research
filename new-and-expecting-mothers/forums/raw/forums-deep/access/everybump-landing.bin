<section
	class="cWidgetContainer cWidgetContainer--isWidget"
	
	data-role='widgetReceiver'
	data-orientation='horizontal'
	data-widgetArea='header'
	style=""
	
	    data-widget-layout="table"
    
	    data-widget-area-id="11"
    
	    data-widget-full-width-items=""
    
	    data-widget-show-images="1"
    
	    data-widget-orientation="horizontal"
    
	    data-restrict-nesting="1"
    
    
>
    
    
    

    
        
        <div class="ipsWidget__content--wrap">
            <div
                class='ipsWidget ipsWidget--horizontal'  data-blocktitle="Custom Blocks" data-blockID="app_cms_Blocks_3660eb96" data-blockErrorMessage="This block cannot be shown. This could be because it needs configuring, is unable to show on this page, or will show after reloading this page." data-menuStyle="menu" data-blockConfig="1"
                data-controller='core.front.widgets.block'
            >
                
                
<div id="bannerAreaGamma" style="display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:10px 0;">
  <div id="bannerContentGamma" style="display:flex;flex-direction:column;align-items:center;justify-content:center;">
  </div>
</div>

<script>
window.addEventListener('resize', () => {
  const bannerAreaGamma = document.getElementById('bannerContentGamma');
  if (bannerAreaGamma) {
    bannerAreaGamma.style.height = 'auto';
  }
});

document.addEventListener('DOMContentLoaded', function () {
  var bannersGamma = [];
  var timerGamma = false;

  const QUEUE_KEY = "eb_leaderboard_queue_gamma";
  const RECENT_KEY = "eb_leaderboard_recent";
  const PAGE_KEY = "eb_leaderboard_current_page";
  const PLACEMENT_NAME = "gamma";
  const RECENT_LIMIT = 6;

  fetch('/banners.php?type=leaderboard')
    .then(response => response.json())
    .then(data => {
      bannersGamma = data;

      if (!bannersGamma || bannersGamma.length === 0) {
        return;
      }

      waitForTopThenStartGamma();
    })
    .catch(error => {
      console.error('Error fetching banners:', error);
      var bannerAreaGamma = document.getElementById('bannerContentGamma');
      if (bannerAreaGamma) {
        bannerAreaGamma.innerHTML = '<p style="text-align: center;">Unable to load banners at this time.</p>';
      }
    });

  function getRecentBannerIdsGamma() {
    try {
      return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
    } catch (e) {
      return [];
    }
  }

  function addRecentBannerGamma(id) {
    const recent = getRecentBannerIdsGamma().filter(x => x !== id);
    recent.unshift(id);
    localStorage.setItem(RECENT_KEY, JSON.stringify(recent.slice(0, RECENT_LIMIT)));
  }

  function getCurrentPageSelectionsGamma() {
    try {
      return JSON.parse(sessionStorage.getItem(PAGE_KEY) || '{}');
    } catch (e) {
      return {};
    }
  }

  function setCurrentPageSelectionGamma(id) {
    const current = getCurrentPageSelectionsGamma();
    current[PLACEMENT_NAME] = id;
    sessionStorage.setItem(PAGE_KEY, JSON.stringify(current));
  }

  function getHardExcludedBannerIdsGamma(excludeId) {
    const current = getCurrentPageSelectionsGamma();
    let hardExcluded = Object.entries(current)
      .filter(([placement]) => placement !== PLACEMENT_NAME)
      .map(([, id]) => id)
      .filter(Boolean);

    if (excludeId) {
      hardExcluded = hardExcluded.filter(id => id !== excludeId);
    }

    return [...new Set(hardExcluded)];
  }

  function getEligibleBannersGamma(excludeId) {
    const recent = getRecentBannerIdsGamma();
    const hardExcluded = getHardExcludedBannerIdsGamma(excludeId);

    let eligible = bannersGamma.filter(b => {
      if (excludeId && b.id === excludeId) return false;
      if (hardExcluded.includes(b.id)) return false;
      return !recent.includes(b.id);
    });

    if (eligible.length === 0) {
      eligible = bannersGamma.filter(b => {
        if (excludeId && b.id === excludeId) return false;
        if (hardExcluded.includes(b.id)) return false;
        return true;
      });
    }

    return eligible;
  }

  function selectWeightedBannerGamma(pool) {
    if (!pool || pool.length === 0) return null;

    const totalWeight = pool.reduce((sum, banner) => sum + (banner.percentage || 1), 0);
    const random = Math.random() * totalWeight;
    let cumulativeWeight = 0;

    for (const banner of pool) {
      cumulativeWeight += banner.percentage || 1;
      if (random <= cumulativeWeight) {
        return banner;
      }
    }

    return pool[0];
  }

  function selectFirstBannerGamma() {
    const eligible = getEligibleBannersGamma();
    return selectWeightedBannerGamma(eligible);
  }

  function buildQueueGamma(firstBanner) {
    const eligible = getEligibleBannersGamma(firstBanner.id);
    const fallback = bannersGamma.filter(b =>
      b.id !== firstBanner.id &&
      !eligible.some(e => e.id === b.id) &&
      !getHardExcludedBannerIdsGamma(firstBanner.id).includes(b.id)
    );

    for (let i = eligible.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [eligible[i], eligible[j]] = [eligible[j], eligible[i]];
    }

    for (let i = fallback.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [fallback[i], fallback[j]] = [fallback[j], fallback[i]];
    }

    const queue = [...eligible, ...fallback];
    sessionStorage.setItem(QUEUE_KEY, JSON.stringify(queue));
  }

  function saveQueueGamma(queue) {
    sessionStorage.setItem(QUEUE_KEY, JSON.stringify(queue));
  }

  function waitForTopThenStartGamma() {
    const maxWaitMs = 2000;
    const pollEveryMs = 50;
    const startedAt = Date.now();

    const check = () => {
      const current = getCurrentPageSelectionsGamma();
      const topId = current.top || null;

      if (topId || (Date.now() - startedAt) >= maxWaitMs) {
        startGammaWidget();
        return;
      }

      setTimeout(check, pollEveryMs);
    };

    check();
  }

  function startGammaWidget() {
    const firstBanner = selectFirstBannerGamma();
    if (!firstBanner) return;

    setBannerContentGamma(firstBanner, document.getElementById('bannerContentGamma'));
    setCurrentPageSelectionGamma(firstBanner.id);
    addRecentBannerGamma(firstBanner.id);
    buildQueueGamma(firstBanner);

    const baseDelay = 15000;
    const phaseOffset = 3500;
    const randomOffset = Math.floor(Math.random() * 1500);

    /*
    * 07/10/2026
    * Initial rotation timing corrected so the first banner remains displayed
    * for the normal rotation interval before the placement-specific offset
    * is applied.
    *
    * Previously the initial timeout used only phaseOffset + randomOffset,
    * which caused the first transition to begin earlier than the normal
    * 15-second rotation interval.
    *
    * Subsequent rotations remain unchanged at 15 seconds.
    */
    setTimeout(() => {
      updateBannerGamma();
      timerGamma = setInterval(updateBannerGamma, baseDelay);
    }, baseDelay + phaseOffset + randomOffset);
  }

  function updateBannerGamma() {
    const bannerAreaGamma = document.getElementById('bannerContentGamma');
    if (!bannerAreaGamma) return;

    bannerAreaGamma.style.height = bannerAreaGamma.offsetHeight + 'px';
    bannerAreaGamma.style.transition = 'height 0.3s ease';

    bannerAreaGamma.classList.remove('fade-in');
    bannerAreaGamma.classList.add('fade-out');

    setTimeout(() => {
      const hardExcluded = getHardExcludedBannerIdsGamma();
      let queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');

      if (queue.length === 0) {
        const firstBanner = selectFirstBannerGamma();
        if (!firstBanner) return;
        buildQueueGamma(firstBanner);
        queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');
      }

      let nextIndex = queue.findIndex(b => !hardExcluded.includes(b.id));
      if (nextIndex === -1) nextIndex = 0;

      const banner = queue.splice(nextIndex, 1)[0];
      saveQueueGamma(queue);

      if (!banner) return;

      setBannerContentGamma(banner, bannerAreaGamma);
      setCurrentPageSelectionGamma(banner.id);
      addRecentBannerGamma(banner.id);

      bannerAreaGamma.classList.remove('fade-out');
      bannerAreaGamma.classList.add('fade-in');
    }, 2000);
  }

  function setBannerContentGamma(selectedBanner, bannerAreaGamma) {
    if (!bannerAreaGamma || !selectedBanner) return;

    bannerAreaGamma.innerHTML = '';

    var link = document.createElement('a');
    link.href = selectedBanner.linkUrl;
    link.referrerPolicy = 'no-referrer-when-downgrade';
    link.rel = 'nofollow sponsored';
    link.target = '_blank';

    var img = document.createElement('img');
    img.src = selectedBanner.imageUrl;
    img.style.border = 'none';
    img.style.verticalAlign = 'middle';
    img.style.padding = '0px 10px';
    img.style.maxWidth = '100%';

    link.appendChild(img);
    bannerAreaGamma.appendChild(link);
  }
});
</script>
            </div>
        </div>
        
    

    
</section>

    
        



