	    data-restrict-nesting="1"
    
    
>
    
    
    

    
        
        <div class="ipsWidget__content--wrap">
            <div
                class='ipsWidget ipsWidget--horizontal'  data-blocktitle="Custom Blocks" data-blockID="app_cms_Blocks_e6bdc170" data-blockErrorMessage="This block cannot be shown. This could be because it needs configuring, is unable to show on this page, or will show after reloading this page." data-menuStyle="menu" data-blockConfig="1"
                data-controller='core.front.widgets.block'
            >
                
                
<div id="bannerAreaTop" style="display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:10px 0;">
  <div id="bannerContentTop" style="display:flex;flex-direction:column;align-items:center;justify-content:center;">
  </div>
</div>

<script>
window.addEventListener('resize', () => {
  const bannerAreaTop = document.getElementById('bannerContentTop');
  if (bannerAreaTop) {
    bannerAreaTop.style.height = 'auto';
  }
});

document.addEventListener('DOMContentLoaded', function () {
  var bannersTop = [];
  var timerTop = false;

  const QUEUE_KEY = "eb_leaderboard_queue_top";
  const RECENT_KEY = "eb_leaderboard_recent";
  const PAGE_KEY = "eb_leaderboard_current_page";
  const PLACEMENT_NAME = "top";
  const RECENT_LIMIT = 6;

  sessionStorage.removeItem(PAGE_KEY);

  fetch('/banners.php?type=leaderboard')
    .then(response => response.json())
    .then(data => {
      bannersTop = data;

      if (!bannersTop || bannersTop.length === 0) {
        return;
      }

      startTopWidget();
    })
    .catch(error => {
      console.error('Error fetching banners:', error);
      var bannerAreaTop = document.getElementById('bannerContentTop');
      if (bannerAreaTop) {
        bannerAreaTop.innerHTML = '<p style="text-align: center;">Unable to load banners at this time.</p>';
      }
    });

  function getRecentBannerIdsTop() {
    try {
      return JSON.parse(localStorage.getItem(RECENT_KEY) || '[]');
    } catch (e) {
      return [];
    }
  }

  function addRecentBannerTop(id) {
    const recent = getRecentBannerIdsTop().filter(x => x !== id);
    recent.unshift(id);
    localStorage.setItem(RECENT_KEY, JSON.stringify(recent.slice(0, RECENT_LIMIT)));
  }

  function getCurrentPageSelectionsTop() {
    try {
      return JSON.parse(sessionStorage.getItem(PAGE_KEY) || '{}');
    } catch (e) {
      return {};
    }
  }

  function setCurrentPageSelectionTop(id) {
    const current = getCurrentPageSelectionsTop();
    current[PLACEMENT_NAME] = id;
    sessionStorage.setItem(PAGE_KEY, JSON.stringify(current));
  }

  function getOtherPlacementCurrentIdsTop() {
    const current = getCurrentPageSelectionsTop();

    return Object.entries(current)
      .filter(([placement]) => placement !== PLACEMENT_NAME)
      .map(([, id]) => id)
      .filter(Boolean);
  }

  function getHardExcludedBannerIdsTop(excludeId) {
    let hardExcluded = getOtherPlacementCurrentIdsTop();

    if (excludeId) {
      hardExcluded = hardExcluded.filter(id => id !== excludeId);
    }

    return [...new Set(hardExcluded)];
  }

  function getEligibleBannersTop(excludeId) {
    const recent = getRecentBannerIdsTop();
    const hardExcluded = getHardExcludedBannerIdsTop(excludeId);

    let eligible = bannersTop.filter(b => {
      if (excludeId && b.id === excludeId) return false;
      if (hardExcluded.includes(b.id)) return false;
      return !recent.includes(b.id);
    });

    if (eligible.length === 0) {
      eligible = bannersTop.filter(b => {
        if (excludeId && b.id === excludeId) return false;
        if (hardExcluded.includes(b.id)) return false;
        return true;
      });
    }

    return eligible;
  }

  function selectWeightedBannerTop(pool) {
    if (!pool || pool.length === 0) return null;

    const totalWeight = pool.reduce((sum, banner) => sum + (banner.percentage || 1), 0);
    const random = Math.random() * totalWeight;
    let cumulativeWeight = 0;

    for (const banner of pool) {
      cumulativeWeight += banner.percentage || 1;
      if (random <= cumulativeWeight) {
        return banner;
      }
    }

    return pool[0];
  }

  function selectFirstBannerTop() {
    const eligible = getEligibleBannersTop();
    return selectWeightedBannerTop(eligible);
  }

  function buildQueueTop(firstBanner) {
    const eligible = getEligibleBannersTop(firstBanner.id);
    const fallback = bannersTop.filter(b =>
      b.id !== firstBanner.id &&
      !eligible.some(e => e.id === b.id) &&
      !getHardExcludedBannerIdsTop(firstBanner.id).includes(b.id)
    );

    for (let i = eligible.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [eligible[i], eligible[j]] = [eligible[j], eligible[i]];
    }

    for (let i = fallback.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [fallback[i], fallback[j]] = [fallback[j], fallback[i]];
    }

    const queue = [...eligible, ...fallback];
    sessionStorage.setItem(QUEUE_KEY, JSON.stringify(queue));
  }

  function getNextBannerTop() {
    let queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');

    if (queue.length === 0) {
      const firstBanner = selectFirstBannerTop();
      if (!firstBanner) return null;
      buildQueueTop(firstBanner);
      queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');
    }

    return queue.shift();
  }

  function saveQueueTop(queue) {
    sessionStorage.setItem(QUEUE_KEY, JSON.stringify(queue));
  }

  function startTopWidget() {
    const firstBanner = selectFirstBannerTop();
    if (!firstBanner) return;

    setBannerContentTop(firstBanner, document.getElementById('bannerContentTop'));
    setCurrentPageSelectionTop(firstBanner.id);
    addRecentBannerTop(firstBanner.id);
    buildQueueTop(firstBanner);

    const baseDelay = 15000;
    const phaseOffset = 0;
    const randomOffset = Math.floor(Math.random() * 1500);

    /*
    * 07/10/2026
    * Initial rotation timing corrected so the first banner remains displayed
    * for the normal rotation interval before the first scheduled update.
    *
    * Previously the initial timeout used only phaseOffset + randomOffset,
    * which could begin the first transition almost immediately after page load.
    *
    * Subsequent rotations remain unchanged at 15 seconds.
    */
    setTimeout(() => {
      updateBannerTop();
      timerTop = setInterval(updateBannerTop, baseDelay);
    }, baseDelay + phaseOffset + randomOffset);
  }
  function updateBannerTop() {
    const bannerAreaTop = document.getElementById('bannerContentTop');
    if (!bannerAreaTop) return;

    bannerAreaTop.style.height = bannerAreaTop.offsetHeight + 'px';
    bannerAreaTop.style.transition = 'height 0.3s ease';

    bannerAreaTop.classList.remove('fade-in');
    bannerAreaTop.classList.add('fade-out');

    setTimeout(() => {
      const otherCurrentIds = getOtherPlacementCurrentIdsTop();
      let queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');

      if (queue.length === 0) {
        const firstBanner = selectFirstBannerTop();
        if (!firstBanner) return;
        buildQueueTop(firstBanner);
        queue = JSON.parse(sessionStorage.getItem(QUEUE_KEY) || '[]');
      }

      let nextIndex = queue.findIndex(b => !otherCurrentIds.includes(b.id));
      if (nextIndex === -1) nextIndex = 0;

      const banner = queue.splice(nextIndex, 1)[0];
      saveQueueTop(queue);

      if (!banner) return;

      setBannerContentTop(banner, bannerAreaTop);
      setCurrentPageSelectionTop(banner.id);
      addRecentBannerTop(banner.id);

      bannerAreaTop.classList.remove('fade-out');
      bannerAreaTop.classList.add('fade-in');
    }, 2000);
  }

  function setBannerContentTop(selectedBanner, bannerAreaTop) {
    if (!bannerAreaTop || !selectedBanner) return;

    bannerAreaTop.innerHTML = '';

    var link = document.createElement('a');
    link.href = selectedBanner.linkUrl;
    link.referrerPolicy = 'no-referrer-when-downgrade';
    link.rel = 'nofollow sponsored';
    link.target = '_blank';

    var img = document.createElement('img');
    img.src = selectedBanner.imageUrl;
    img.style.border = 'none';
    img.style.verticalAlign = 'middle';
    img.style.padding = '0px 10px';
    img.style.maxWidth = '100%';

    link.appendChild(img);
    bannerAreaTop.appendChild(link);
  }
});
</script>
            </div>
        </div>
        
    

    
</section>

    
        



