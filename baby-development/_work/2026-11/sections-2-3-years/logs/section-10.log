out=['# baby-development: pattern 10, Other people interfere (children of 2 and 3 years)\\n\\n**Written:** 2026-11-20 from baby-development/evidence/2026-11/age-reread/digest-12.md\\n**Reviewed by the owner:** not yet\\n\\n## Limits\\n\\nA random sample of 20,000 posts from twelve parenting subreddits, 1 April–24 October 2026, was read without a keyword filter: 3,811 were on-niche, including 1,340 about children of two and three. This pattern has 27 on-niche and 13 near posts, all read; counts are posts tagged by one reader, not people or market prevalence. Forms from different digest readers would be merged by judgement; only one digest supplies this pattern, and its distinct forms remain separate.\\n']
for name,indices,denom in [('On-niche posts',range(12),27),('Near posts',range(12,22),13)]:
 out.append('## '+name+'\\n')
 for i in sorted(indices,key=lambda i:-int(re.search(r'"'^('"\\d+) of ',blocks[i],re.M)[1])):
  summary,qs,but=data[i]
  count=int(re.search(r'"'^('"\\d+) of ',blocks[i],re.M)[1])
  out.append(f'### {claims[i]}\\n\\n{count} of {denom} posts.\\n\\n{summary}\\n\\n'+'\\n'.join('- '+x for x in qs)+'\\n\\n**But:** '+but+'\\n')
out.append('## Across the on-niche posts\\n')
for claim,count,summary,qs,but in cross:
 out.append(f'### {claim}\\n\\n{count} of 27 posts.\\n\\n{summary}\\n\\n'+'\\n'.join('- '+x for x in qs)+'\\n\\n**But:** '+but+'\\n')
text='\\n'.join(out)+'\\n'
