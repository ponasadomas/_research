from pathlib import Path
import re
texts=[Path(f'baby-development/evidence/2026-11/second-reading/digest-{n}.md').read_text() for n in ('08','09')]
forms={}; headings=[]; quotes={}
for d,t in enumerate(texts):
    section=''; counters={}
    for b in re.split(r'(?="'^##?##? )'"',t,flags=re.M):
        ls=b.splitlines(); line=ls[0] if ls else ''
        if line.startswith('## '):
            section='yes' if ': yes posts' in line else 'near' if ': near posts' in line else 'cross'
            counters[section]=0; headings.append((line[3:],None))
        elif line.startswith('### '):
            counters[section]+=1; k=(d,section,counters[section])
            forms[k]=b; headings.append((line[4:],k))
    for line in t.splitlines():
        m=re.match(r'- \"(.*)\" \\[(["'^]]+)'"\\]"'$'"',line)
        if m:quotes.setdefault(m[2],[]).append(m[1])
    for s,i in re.findall(r'\"(["'^"'"\\n]+)\" \\[(["'^]]+)'"\\]',t):quotes.setdefault(i,[]).append(s)
def q(i,s):
    assert any(s in x for x in quotes[i]),(i,s)
    return f'\"{s}\" [{i}]'
F=[]; mapping={}
def add(sec,claim,keys,body,qs,but='nothing found against it.'):
    ks=[(d,sec,n) for d,n in keys]
    n=sum(int(re.search(r'"'^('"\\d+) of ',forms[k],re.M)[1]) for k in ks)
    for k in ks:
        assert k not in mapping
        mapping[k]=claim
    F.append((sec,claim,n,body,[q(*x) for x in qs],but))
def b(words,i,s):return words+' '+q(i,s)

