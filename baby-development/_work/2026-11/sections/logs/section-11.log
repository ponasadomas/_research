from pathlib import Path
import re
p=Path('baby-development/findings/2026-11/patterns/pattern-11.md').read_text()
s=Path('baby-development/evidence/2026-11/second-reading/digest-19.md').read_text()
quotes={}
# Every quoted finding excerpt, including But lines, must be inside digest text for that id.
for line in s.splitlines():
 m=re.match(r'- \"(.*)\" \\[(["'^]]+)'"\\]',line)
 if m: quotes.setdefault(m[2],[]).append(m[1])
 # Preserve inline counterquotes too.
 for m in re.finditer(r'\"(["'^"'"\\n]+)\" \\[(["'^]]+)'"\\]',line): quotes.setdefault(m[2],[]).append(m[1])
errors=[]
for n,line in enumerate(p.splitlines(),1):
 m=re.match(r'- \"(.*)\" \\[(["'^]]+)'"\\]',line)
 pairs=[(m[1],m[2])] if m else re.findall(r'\"(["'^"'"\\n]+)\" \\[(["'^]]+)'"\\]',line)
 for q,i in pairs:
  if not all(any(x in original for original in quotes.get(i,[])) for x in q.split(' […] ')):
   errors.append((n,i,q))
print('Words above Coverage:',len(p.split('## Coverage')[0].split()))
print('Digest excerpt mismatches:',errors)
print('Coverage rows:',len(re.findall(r'"'^'"\\| ',p.split('## Coverage')[1],re.M))-1)
