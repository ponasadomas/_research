        group='across' if 'across' in line else ('near' if 'near posts' in line else 'yes')
        out.append('| '+line[3:]+' | section title |')
    elif line.startswith('### '):
        x=sets[group][index[group]];index[group]+=1
        out.append('| '+line[4:]+' | '+x['title']+' |')
assert index=={'yes':19,'near':12,'across':4}
out+=['','</details>','']
path=Path('baby-development/findings/2026-11/patterns/pattern-06.md')
