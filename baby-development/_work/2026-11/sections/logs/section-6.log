        out+=['','### '+x['title'],'',f\"{x['n']} of {total} posts.\",'',x['prose'],'']
        out+=['- '+q(i,s) for i,s in x['qs']]
        out+=['','**But:** '+x['but']+(' '+q(x['bi'],x['bs']) if x['bi'] else '')]
above='\\n'.join(out)+'\\n'
