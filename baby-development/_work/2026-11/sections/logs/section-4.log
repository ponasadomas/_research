from pathlib import Path
import re
base=Path('baby-development/evidence/2026-11/second-reading')
digests={n:(base/f'digest-{n}.md').read_text() for n in (10,11)}
maps={
(10,'yes'):'toys open gifts worth media constrained active shoes safe rooms feeding seats beds outings car sensory swim learning routines clothes'.split(),
(11,'yes'):'toys sensory learning active gifts learning shoes shoe-time beds safe rooms routines feeding feeding seats clothes outings media constrained worth'.split(),
(10,'near'):'beds beds sleepwear safe clothes feeding media learning shoes open comfort swim active outings routines other'.split(),
(11,'near'):'sleepwear sleepwear beds bedding safe car outings clothes shoes toys learning learning open active learning media storage worth outings other'.split()}
counts={}; coverage=[]; quotes={}
for n,t in digests.items():
    for m in re.finditer(r'"'^- "(.*?)" '"\\[([a-z]+\\d+-\\d+)\\]',t,re.M|re.S):
        quotes.setdefault(m[2],[]).append(re.sub(r'\\s+',' ',m[1]))
    group=None; positions={}
    for block in re.split(r'(?="'^#{2,3} )'"',t,flags=re.M):
        first=block.splitlines()[0]
        if first.startswith('## '):
            group='yes' if ': yes posts' in first else 'near' if ': near posts' in first else 'across'
            coverage.append((first[3:],'section title'))
        elif first.startswith('### '):
            j=positions.get(group,0); positions[group]=j+1
            key=maps[n,group][j] if group"'!='"'across' else ['tried','others','bought','feeling'][j]
            if group"'!='"'across': counts[group,key]=counts.get((group,key),0)+int(re.search(r'"'^('"\\d+) of \\d+ posts\\.',block,re.M)[1])
            coverage.append((first[4:],(group,key)))
    for g in ('yes','near'): assert positions[g]==len(maps[n,g])
