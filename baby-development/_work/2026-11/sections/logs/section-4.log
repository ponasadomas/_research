corpus='\\n'.join(digests.values())
def normal(s): return re.sub(r'\\s+',' ',s).strip()
def check_fragment(q,id):
    # Bound each search to the nearest preceding quote delimiter, including wrapped bullets.
    passages=[]
    for t in digests.values():
        for m in re.finditer(r'(?:"'^- "|'"\\*\\*But:\\*\\*["'^'"\\n]*?\"|: \")([\\s\\S]*?)\" \\['+re.escape(id)+r'\\]',t,re.M): passages.append(normal(m[1]))
    assert passages, id
    assert all(any(normal(p) in passage for passage in passages) for p in re.split(r'\\s*\\[…\\]\\s*',q)),(id,q)
for claim,explanation,quotes,but in data.values():
    for id,q in quotes: check_fragment(q,id)
    for q,id in re.findall(r'\"(["'^"'"\\n]+)\" \\[(["'^]]+)'"\\]',but): check_fragment(q,id)
lines=['# baby-development: pattern 4, What should I get for this age?','','**Written:** 2026-11-20 from baby-development/evidence/2026-11/second-reading/digest-10.md baby-development/evidence/2026-11/second-reading/digest-11.md','**Reviewed by the owner:** not yet','','## Limits','','These posts come from a random, no-keyword sample of 20,000 posts in twelve parenting subreddits, 1 April–24 October 2026; 2,471 were on-niche. This pattern contains 245 on-niche and 165 near posts, all covered by the two digests; each count is posts tagged by one reader, not people or market prevalence. Forms named independently by digest readers were merged by judgement; cross-post tags overlap.','']
for g,title,total in [('yes','On-niche posts',245),('near','Near posts',165),('across','Across the on-niche posts',245)]:
