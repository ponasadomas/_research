 # The paragraph immediately following the count is the explanatory sentence.
 countidx=next(i for i,l in enumerate(lines) if re.fullmatch(r'\\d+ of \\d+ posts\\.',l))
 lines[countidx+2]=desc
 blocks[n]='\\n'.join(lines)+'\\n\\n'
 cov=cov.replace('| '+old+' |','| '+claim+' |')
body=''.join(blocks)
