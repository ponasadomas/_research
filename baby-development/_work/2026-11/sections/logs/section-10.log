def render(claim,count,total,summary,qs,but,bq):
 body=f'### {claim}\\n\\n{count} of {total} posts.\\n\\n{summary}\\n\\n'
 body+='\\n'.join('- '+quote(q) for q in qs)
 body+='\\n\\n**But:** '+but+(' '+quote(bq) if bq else '')+'\\n\\n'
 return body
