#!/usr/bin/env python3
"""Check a findings page or her-words.md.
  python3 -I check_findings.py <page.md> --quotes <quotes dir> [--quotes <dir>] [--evidence <file>]...
Every "quote" [id] must be word for word inside the record with that id; every finding must
have a count line, a quote and a But line; with --evidence, every heading of each evidence
file must appear in the page's Coverage section."""
import glob, json, os, re, sys
a = sys.argv[1:]; page = a[0]; qdirs = []; evidence = []
i = 1
while i < len(a):
    if a[i] == "--quotes": qdirs.append(os.path.expanduser(a[i + 1])); i += 2
    elif a[i] == "--evidence": evidence.append(os.path.expanduser(a[i + 1])); i += 2
    else: sys.exit(f"unknown argument {a[i]}")
if not qdirs: sys.exit("give at least one --quotes folder")
def norm(s):
    for x, y in (("’", "'"), ("‘", "'"), ("“", '"'), ("”", '"'), ("\\n", " "), ("\\", "")): s = s.replace(x, y)
    return re.sub(r"\s+", " ", s).strip().lower()
rec = {}
for d in qdirs:
    for f in sorted(glob.glob(os.path.join(d, "*.jsonl"))):
        for l in open(f, encoding="utf-8"):
            if l.strip(): r = json.loads(l); rec[r["id"]] = norm(r["quote"])
if not rec: sys.exit("no quote records found")
t = open(page, encoding="utf-8").read(); L = t.split("\n")
ID = r"([a-z]{2,}[0-9]{1,3}-[0-9]{3,5})"; problems = []; pairs = []
group = ""
for n, l in enumerate(L, 1):
    if l.startswith("## "): group = l[3:].strip()
    if re.match(r'^\s*[-*] "', l) and not re.search(r"\[" + ID + r"\]", l) and group not in ("Her vocabulary", "Public figures"):
        problems.append(f"line {n}: quote without a quote id")
    m = re.match(r'^\s*[-*] "(.+)" \[' + ID + r"\]", l)
    found = [(m.group(1), m.group(2))] if m else re.findall(r'"([^"\n]+)" \[' + ID + r"\]", l)
    for q, i_ in found: pairs.append((n, q, i_))
for n, q, i_ in pairs:
    if i_ not in rec: problems.append(f"line {n}: id {i_} is not in the quote files"); continue
    parts = [x for x in re.split(r"\s*\[…\]\s*|\s*\[\.\.\.\]\s*", q) if x.strip()]
    if not all(norm(x).rstrip(".,;") in rec[i_] for x in parts): problems.append(f"line {n}: not word for word from {i_}")
for i_ in set(re.findall(r"\[" + ID + r"\]", t)):
    if i_ not in rec: problems.append(f"id {i_} is not in the quote files")
is_words = os.path.basename(page) == "her-words.md"
if "**Reviewed by the owner:**" not in t: problems.append('no "**Reviewed by the owner:**" line')
findings = 0
if not is_words:
    if not re.search(r"^## Limits\s*$", t, re.M): problems.append('no "## Limits" section')
    blocks = []
    for g in re.split(r"^## ", t, flags=re.M)[1:]:
        gname = g.split("\n")[0].strip()
        for b in re.split(r"^### ", g, flags=re.M)[1:]: blocks.append((gname, b))
    for gname, b in blocks:
        name = b.split("\n")[0].strip(); body = b; findings += 1
        if gname == "Public figures":
            if not re.search(r"^Source: .+", body, re.M): problems.append(f'"{name}": public figure without a Source line')
            continue
        if not re.search(r"^\d[\d,]* (of [\d,]+ posts|quotes?( cited)?)\.", body, re.M): problems.append(f'"{name}": no count line')
        if not re.search(r'" \[' + ID + r"\]", body): problems.append(f'"{name}": no quote')
        if "**But:**" not in body: problems.append(f'"{name}": no But line')
    if not blocks: problems.append("no findings (### headings)")
if evidence:
    cov = t.split("## Coverage", 1)[1] if "## Coverage" in t else ""
    if not cov: problems.append('no "## Coverage" section')
    heads = [re.sub(r"^#+\s*", "", l).strip() for e in evidence for l in open(e, encoding="utf-8") if re.match(r"^#{2,3} ", l)]
    missing = [h for h in heads if h not in cov]
    if cov and missing: problems.append(f"{len(missing)} evidence headings not in Coverage, e.g. {missing[:3]}")
print(f"{os.path.basename(page)}: findings {findings}, quotes checked {len(pairs)}, words {len(t.split())}; " + ("OK" if not problems else "FAIL"))
for p in problems[:25]: print("  " + p)
sys.exit(1 if problems else 0)

