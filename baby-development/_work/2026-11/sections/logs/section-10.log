def quote(q):
 ident,words=q.split(':',1)
 candidates=re.findall(r'\"(.*?)\" \\['+re.escape(ident)+r'\\]',src,re.S)
 assert any(words in re.sub(r'\\s+',' ',s) for s in candidates),(ident,words)
 return f'\"{words}\" [{ident}]'
text='# baby-development: pattern 10, Other people interfere\\n\\n**Written:** 2026-11-20 from baby-development/evidence/2026-11/second-reading/digest-18.md\\n**Reviewed by the owner:** not yet\\n\\n## Limits\\n\\nA random, keyword-free sample of 20,000 posts from twelve parenting subreddits, 1 April–24 October 2026, yielded 2,471 on-niche posts; this pattern has 63 on-niche and 64 near posts, all read. Each count is posts tagged by one reader, not people or market prevalence; forms from different readers would be merged by judgement, but this pattern has one digest. Unstated demographics remain unknown; cross-tags overlap.\\n\\n'
mapping={}
