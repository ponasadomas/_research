assert len(out.split())<=2500
out+='## Coverage\\n\\n<details>\\n<summary>Every heading of the digests, and where it went</summary>\\n\\n| Digest heading | Went to |\\n|---|---|\\n'
for fi,p in enumerate(parts):
 out+=f'| {p.splitlines()[0]} | section title |\\n'
 for i,b in enumerate(forms[fi]):
  out+=f'| {b.splitlines()[0]} | {mappings[(fi,i)]} |\\n'
out+='\\n</details>\\n'
