mappings={}
for section,entries,fi,total in [('On-niche posts',yes,0,63),('Near posts',near,1,64)]:
 out+=f'## {section}\\n\\n'
 for i,claim,summary,qs,but,bq in sorted(entries,key=lambda x:-int(re.search(r'"'^('"\\d+) of',forms[fi][x[0]],re.M).group(1))):
  count=int(re.search(r'"'^('"\\d+) of',forms[fi][i],re.M).group(1))
  out+=render(claim,count,total,summary,qs,but,bq)
  mappings[(fi,i)]=claim
out+='## Across the on-niche posts\\n\\n'
for i,claim,count,summary,qs,but,bq in cross:
