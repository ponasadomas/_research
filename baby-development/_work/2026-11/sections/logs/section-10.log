for fi,(title,data,total) in enumerate([('On-niche posts',yes,63),('Near posts',near,64),('Across the on-niche posts',cross,63)]):
 entries=[r.split('|') for r in data.splitlines()]
 def count(e):
  i=int(e[0]); return [53,63,6,58][i] if fi==2 else int(re.search(r'"'^('"\\d+) of',forms[fi][i],re.M).group(1))
 if fi<2: entries.sort(key=lambda e:-count(e))
