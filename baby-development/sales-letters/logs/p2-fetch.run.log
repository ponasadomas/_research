import sys, os, json, subprocess, re, datetime
from pathlib import Path
root=Path('/home/thinkpad/GitHub/ads/mamivio.com/research/development')
os.chdir(root)
logs=root/'sales-letters/logs'
statefile=logs/'p2-run-state.json'
state=json.loads(statefile.read_text()) if statefile.exists() else {'queries':[], 'fetches':[]}
audit=logs/'p2-wayback-requests.jsonl'
def count():
 return sum(json.loads(s).get('event') in ('request','redirect') for s in audit.read_text().splitlines()) if audit.exists() else 0
def run(args):
 if count()>=220: raise SystemExit('CAP REACHED 220')
 env=dict(os.environ,WAYBACK_SCHEME='https',WAYBACK_REQUEST_LOG=str(audit),WAYBACK_REQUEST_CAP='220',WAYBACK_TRIES='1',WAYBACK_TIMEOUT='35')
 p=subprocess.run(['python3','-I','_tools/wayback.py']+args,env=env,capture_output=True,text=True)
 with (logs/'p2-commands.jsonl').open('a') as f: f.write(json.dumps({'args':args,'exit':p.returncode,'stdout':p.stdout,'stderr':p.stderr,'request_count':count()})+'\\n')
 print(p.stdout,end=''); print(p.stderr,end='',file=sys.stderr); print('REQUEST_COUNT',count())
 return p
cmd=sys.argv[1]
if cmd=='cdx':
 label,url=sys.argv[2:4]
 args=['cdx',url,'--from','2005','--to','2024','--limit','40','--collapse','timestamp:4','--filter','mimetype:text/html']+sys.argv[4:]
 p=run(args)
 folder=logs/'p2-cdx';folder.mkdir(exist_ok=True)
 stem=f'{len(state[\"queries\"])+1:03d}-{label}'
 (folder/(stem+'.tsv')).write_text(p.stdout);(folder/(stem+'.stderr')).write_text(p.stderr)
 state['queries'].append({'label':label,'url':url,'args':args,'file':str((folder/(stem+'.tsv')).relative_to(root)),'rows':len(p.stdout.splitlines()),'request_count':count()})
elif cmd=='fetch':
 slug,ts,url=sys.argv[2:5]
 out=f'_raw/sales-letters/{slug}--{ts}.txt'
 if Path(out).exists():raise SystemExit('Refusing to overwrite raw '+out)
 p=run(['fetch',ts,url,'--out',out]+sys.argv[5:])
 if Path(out).exists():
  header=Path(out).read_text().split('-'*70)[0]
  meta=dict(re.findall(r'"'^('"\\w+): (.*)"'$'"',header,re.M))
  state['fetches'].append({'slug':slug,'timestamp':ts,'url':url,'file':out,'http':meta['HTTP'],'words':int(meta['WORDS']),'letter':'pending','note':''})
elif cmd=='verdict':
 slug,ts,verdict,note=sys.argv[2:6]
 item=next(x for x in state['fetches'] if x['slug']==slug and x['timestamp']==ts)
 if item['letter']"'!='"'pending':raise SystemExit('Already logged')
 item['letter']=verdict;item['note']=note
 def clean(s):return str(s).replace('|','&#124;').replace('\\n',' ')
 row=[datetime.date.today().isoformat(),slug,item['url'],ts,item['http'],item['words'],verdict,'Phase 2: '+note]
 with (root/'sources/sales-letters.md').open('a') as f:f.write('| '+' | '.join(clean(x) for x in row)+' |\\n')
elif cmd=='status':
 print(json.dumps(state,indent=2));print('REQUEST_COUNT',count())
else: raise SystemExit(cmd)
statefile.write_text(json.dumps(state,indent=2)+'\\n')
