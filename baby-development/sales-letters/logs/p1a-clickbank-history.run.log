   if k.lower()"'!='"'cbrehoppp2':continue
   for url in values:
    host=urllib.parse.urlsplit(url).hostname or ''
    if not host or any(host==x or host.endswith('.'+x) for x in ['clickbank.net','clickbank.com','cbengine.com','cbengine.co','archive.org']):continue
    candidates.append({'domain':host.removeprefix('www.'),'url':url,'capture':row[0]})
 if candidates:
  counts=collections.Counter(x['domain'] for x in candidates)
