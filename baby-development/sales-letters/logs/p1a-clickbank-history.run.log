exec
/usr/bin/zsh -lc "cat > /tmp/p1a_fetch_roots.py <<'PY'
from p1a_common import run, out
for name, listing in [('clickbank-index-2008','cdx-clickbank-marketplace-https.tsv'),('cbengine-index-2008','cbengine-root.cdx.tsv'),('cbtrends-index-2008','cbtrends-root.cdx.tsv'),('cbanalytics-index-2008','cbanalytics-root.cdx.tsv'),('jvzoo-marketplace-2014','jvzoo-marketplace.cdx.tsv')]:
