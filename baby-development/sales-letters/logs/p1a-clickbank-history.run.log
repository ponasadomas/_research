  resolved[vendor]={'domain':domain,'url':chosen['url'],'source':path.name,'note':note}
  resolved_path.write_text(json.dumps(resolved,indent=2)+'\\n')
  print('RESOLVED',vendor,domain,chosen['url'],dict(counts),flush=True)
 else:print('UNRESOLVED',vendor,flush=True)
