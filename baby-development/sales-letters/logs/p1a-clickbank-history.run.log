 name='hopdomain-targets-'+vendor
 run(name,['cdx',vendor+'.hop.clickbank.net/','--match','domain','--from','2005','--to','2022','--limit','40','--status','any'])
 process(vendor,out/(name+'.cdx.tsv'))
