for area in ['Physical','Cognitive','Language','Social-Emotional']:
 for val in [0,1]:
  add('D2_age12_typical_'+area.replace('-','_')+'_all'+str(val),body(12,qs,lambda q: val if q['area']==area else q['rate']>=.5,True),'D')
 add('D2_age12_all_yes_except_'+area.replace('-','_'),body(12,qs,lambda q:q['area']"'!=area,True),'"'D')
for age in [0,1,2,3,6,12,24,36,48]:
 add(f'M_age{age:02d}_same_age12_typical',body(age,qs,lambda q:q['rate']>=.5,True),'model')
for target in [0,2,12]:
 add(f'G_age{target:02d}_age01_zero_ids',body(target,ordered(b[1]),extended=True),'G')
for source in [0,2]:
 add(f'G_age01_age{source:02d}_zero_ids',body(1,ordered(b[source]),extended=True),'G')
q1=ordered(b[1]); anchors={s['anchor']['id'] for s in b[1]['sections'] if s['anchor']}
add('G_age01_zero_omit_anchors',body(1,[q for q in q1 if q['id'] not in anchors],extended=True),'G')
for area in ['Physical','Cognitive','Language','Social-Emotional']:
 add('G_age01_zero_omit_'+area.replace('-','_'),body(1,[q for q in q1 if q['area']"'!=area],extended=True),'"'G')
for q in [q for q in q1 if q['area']=='Physical']:
 add(f'G_age01_zero_omit_id{q[\"id\"]}',body(1,[x for x in q1 if x['id']"'!=q['"'id']],extended=True),'G')
typical=body(12,qs,lambda q:q['rate']>=.5,True)
add('F_age12_typical_plus_unknown',dict(typical,answers=typical['answers']+[dict(id=999999,y=1)]),'F')
for k in range(1,9):
 add(f'F_age12_first{k:02d}_yes',body(12,qs[:k],lambda q:1,True),'F')
for label,ans in [('duplicate_first',typical['answers']+[typical['answers'][0]]),('duplicate_conflict',typical['answers']+[dict(id=qs[0]['id'],y=0)])]:
 add('F_age12_'+label,dict(typical,answers=ans),'F')
# Full inventories have published mean probability curves for norm inversion tests.
r=json.load(open('raw/api/result_age01_all_no_numeric.json'))
s=next(s for s in r['skills'] if s['skill']=='Secure Attachment')
for k in range(s['total']+1):
 ids={q['id'] for q in s['items'][:k]}
 add(f'M_secure_attachment_count{k:02d}',body(12,s['items'],lambda q:q['id'] in ids,True),'model')
# Reserve target-item random vectors to check equal-count model away from training orderings.
for k in [17,20,24,28,34,35]:
 ids=[q['id'] for q in qs];random.Random(3000+k).shuffle(ids);yes=set(ids[:k])
 add(f'M_age12_random_count{k:02d}',body(12,qs,lambda q:q['id'] in yes,True),'model')
pathlib.Path('logs/phase3-followups.json').write_text(json.dumps(jobs,indent=2)+'\\n')
print(len(jobs),'planned followups')
