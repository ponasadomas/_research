+    add('''## A. Determinism and answer order
+
+Mixed profile: age 12, all 39 IDs, `y=1` iff `rate>=0.5` (28 yes), `extended:false`.''')
+    add(table(["Probe","HTTP","devAge / band","Area months P, C, L, S","Identical raw bytes"],[
