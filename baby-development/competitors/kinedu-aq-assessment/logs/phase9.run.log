+  "CDC-15-LC-01": [[24], "loose", "At least one meaningful word can include a parent name; Kinedu does not state CDC's besides-mama/dada exclusion."],
+  "CDC-15-LC-03": [[258,19], "loose", "Giving an object on request/one-step instructions leave gesture support unspecified; CDC explicitly provides both a gesture and words."],
+  "CDC-15-CO-01": [[103], "loose", "Can correctly use everyday items is a success criterion; CDC only requires trying to use them appropriately."],
+  "CDC-15-MP-02": [[476], "loose", "Independent feeding with or without utensils does not establish feeding with fingers specifically."],
+  "CDC-18-SE-01": [[461], "loose", "Exploration near a caregiver omits looking back to check the caregiver's location."],
+  "CDC-18-SE-03": [[], "none", "No offering-hands-for-washing question."],
+  "CDC-18-SE-04": [[436], "loose", "Sustained attention for a few minutes while an adult reads is not the same minimal shared-looking-at-a-few-pages threshold."],
+  "CDC-18-LC-01": [[375,32], "loose", "Four words total or three named objects do not unambiguously require three words besides parent names."],
+  "CDC-18-LC-02": [[19,258], "loose", "Kinedu does not explicitly rule out gesture cues; CDC's no-gesture requirement materially affects difficulty."],
+  "CDC-18-CO-01": [[241,464], "loose", "Helping with chores need not be imitation; general family imitation need not involve chores."],
+  "CDC-18-MP-01": [[16,415,309], "loose", "A few first unsteady steps are earlier than established walking; walking while carrying a toy adds a task. No plain sustained-walking counterpart."],
