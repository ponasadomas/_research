+  "CDC-24-MP-02": [[637,727,726], "loose", "Similar-to-running acceleration is ambiguous; directed running or confident running across surfaces adds requirements."],
+  "CDC-24-MP-03": [[639,676,72], "loose", "Alternating feet or no hand support is harder; crawling stairs is a different action. No basic stair-walking question at the same level."],
+  "CDC-30-SE-01": [[1147,454], "loose", "Parallel play explicitly without interaction misses sometimes playing together; general social play omits the combined pattern."],
+  "CDC-30-SE-02": [[108], "loose", "Attention-seeking sounds/actions do not require verbally showing one's achievement with a look-at-me statement."],
+  "CDC-30-SE-03": [[241,148], "loose", "Chore participation or rule understanding does not require following a familiar routine after a spoken cue."],
+  "CDC-30-LC-03": [[437,614], "loose", "Naming familiar/everyday objects does not specify naming a book picture after a pointed what-is-this prompt."],
