from pathlib import Path
paths=[Path('CDC-COMPARISON.md'),Path('raw/cdc/cdc-milestones.csv'),Path('raw/cdc/matched-pairs.csv'),Path('raw/cdc/comparison-summary.json')]
before={str(p):hashlib.sha256(p.read_bytes()).hexdigest() for p in paths}
class Quiet:
 def write(self,s): return len(s)
 def flush(self): pass
for script in ['scripts/extract_cdc_milestones.py','scripts/build_cdc_comparison.py']:
