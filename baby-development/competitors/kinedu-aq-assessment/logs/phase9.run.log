+    (RAW / "checklist-manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
+    for m in manifest:
+        print(m["age_months"], m["milestone_count"], m["domains"])
+    print("Total:", len(rows))
+
+
+if __name__ == "__main__":
