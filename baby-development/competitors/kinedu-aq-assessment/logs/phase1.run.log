  2442	    5668: function(e) {
  2443	      e.exports = JSON.parse('{"1":"Abre la mano para tomar algo que le das.","3":"Mueve los brazos cuando ve algo que le gusta.","4":"Se pone en cuclillas para recoger cosas mientras camina.","5":"Imita lo que hacen sus amigos al jugar, como construir torres cuando ellos lo hacen.","6":"Cambia su atenci\xf3n entre dos objetos.","7":"Intenta copiar las palabras que dices.","9":"Boca abajo, puede levantar la parte superior de su cuerpo.","12":"Busca juguetes escondidos.","14":"Sostiene dos objetos con una mano.","15":"Camina o se desplaza apoy\xe1ndose en muebles grandes.","16":"Da un par de pasos por s\xed solo.","17":"Gatea.","19":"Sigue instrucciones simples de un paso (como \'Recoge el juguete\').","20":"Levanta los brazos para que lo cargues.","21":"Se mantiene encogido, con los brazos y las rodillas pegados al cuerpo.","22":"Saluda o se despide con movimientos de la mano.","23":"Balbucea como si conversara contigo y respeta turnos al hablar.","24":"Dice al menos una palabra con significado, como \'eta\' para \'galleta\'.","26":"Mira fijamente a la persona que le habla.","27":"Mira las cosas o personas cuando dices su nombre.","28":"Elige prestar atenci\xf3n a una persona o situaci\xf3n.","30":"Sostiene la cabeza por s\xed solo.","31":"Repite sonidos como \'baba\' o \'dada\'.","32":"Nombra correctamente al menos tres objetos.","33":"Intenta sentarse cuando est\xe1 boca arriba mientras lo jalas de las manos.","34":"Mete objetos en espacios peque\xf1os, como monedas en una alcanc\xeda.","35":"Prueba la causa y efecto dejando caer un objeto para ver si lo recoges.","36":"Muestra preferencia por ciertas personas.","37":"Se estira para alcanzar lo que quiere moviendo su cuerpo.","38":"Se sobresalta con los sonidos fuertes.","39":"Prueba qu\xe9 tan alto puede llegar cuando trepa.","40":"Explora su propio cuerpo con las manos.","41":"Se lleva las manos a la boca.","43":"Cuando presionas o apoyas sus pies contra una superficie firme, estira las piernas.","47":"Enrosca y desenrosca la tapa de una botella.","51":"Reacciona a diferentes tonos de voz.","53":"Copia lo que hacen sus cuidadores, como sacar un tel\xe9fono de juguete de una bolsa y decir \'hola\'.","54":"Imita un sonido como \'pa\' despu\xe9s de que lo dices.","55":"Copia sonidos de animales.","57":"Activa y detiene un juguete por s\xed solo.","63":"Observa con curiosidad y atenci\xf3n mientras haces cosas.","64":"Usa un brazo para levantar la parte superior de su cuerpo cuando est\xe1 boca abajo.","67":"Sabe qu\xe9 significa \'no\'.","69":"Identifica a los animales por su sonido.","71":"Da vuelta a las p\xe1ginas de un libro.","72":"Sube escaleras gateando.","73":"Agarra objetos y se los lleva a la boca.","75":"Boca abajo, levanta la cabeza por un momento.","78":"Se molesta cuando interrumpen su juego.","79":"Da a conocer lo que le gusta y lo que no con expresiones faciales.","81":"Se mira las manos por unos segundos.","82":"Explora y toca una mano con la otra a prop\xf3sito.","84":"Comparte sus juguetes con otros ni\xf1os.","85":"Ayuda a vestirse y desvestirse moviendo las partes del cuerpo correctas.","86":"Boca arriba, levanta y patalea con las piernas.","88":"Pide ayuda con gestos.","89":"Se mantiene concentrado en algo o alguien por un rato (1 minuto).","90":"Escucha a las personas hablar.","91":"Gira la cabeza hacia ambos lados cuando lo cargan en posici\xf3n vertical.","92":"Se voltea hacia ambos lados por s\xed solo.","93":"Le gustan m\xe1s las cosas suaves que las \xe1speras.","95":"Reacciona al verse en un espejo.","97":"Reconoce a sus cuidadores.","102":"Muestra inter\xe9s por las cosas desconocidas a su alrededor y las explora.","103":"Puede usar correctamente algunos objetos cotidianos (como beber de una taza o marcar un tel\xe9fono).","108":"Repite sonidos o acciones para que la gente lo mire.","109":"Entiende frases de tres palabras, como \'\xa1Mira, un perro!\'","110":"Cuando escucha su nombre, se acerca a la persona gateando, caminando o volteando hacia ella.","111":"Se comporta diferente con adultos conocidos y desconocidos.","112":"Se r\xede a carcajadas.","113":"Pasa de sentado a parado apoy\xe1ndose en un objeto grande, como un mueble.","114":"Se agarra los pies con las manos mientras est\xe1 boca arriba.","115":"Se apoya en codos y antebrazos para levantar la parte superior del cuerpo cuando est\xe1 boca abajo.","116":"Se arrastra para alcanzar algo que quiere.","117":"Presta atenci\xf3n a lugares y cosas nuevas.","118":"Se sienta por s\xed solo.","120":"Reconoce su reflejo en el espejo.","122":"Se calma al escuchar voces conocidas.","124":"Camina cuando alguien lo lleva de las manos.","126":"Les \'habla\' a otros beb\xe9s con balbuceos.","129":"Responde positivamente a los gestos de cari\xf1o.","130":"Controla su torso y cuello cuando un cuidador lo sostiene con los pies en el suelo.","131":"Agarra tu dedo o un objeto que pongas en su mano.","132":"Mantiene la cabeza estable, aunque todav\xeda necesita apoyo cuando lo cargan en posici\xf3n vertical.","133":"Agarra dos cosas, una en cada mano.","135":"Suelta a prop\xf3sito las cosas que sostiene.","136":"Boca arriba, mantiene las piernas abiertas en posici\xf3n de mariposa.","138":"Responde positivamente al contacto f\xedsico.","139":"Abre y cierra puertas y cajones usando las manijas.","140":"Usa una cosa para mover o empujar otra.","143":"Responde con balbuceos cuando le hablas.","144":"Gira la cabeza hacia la mano despu\xe9s de una caricia en la mejilla.","145":"Mira en la direcci\xf3n de un ruido.","146":"Abre y cierra las manos cuando le tocas la palma.","148":"Entiende reglas simples, como pintar en el papel y no en la mesa.","149":"Sacude objetos.","150":"Muestra el reflejo de Moro al levantar los brazos y estirar la espalda y el cuello cuando se sobresalta.","151":"Se voltea de boca abajo a boca arriba.","152":"Agarra las cosas con toda la mano.","153":"Se estira hacia algo y lo agarra.","157":"Relaciona sonidos con objetos, como el timbre con la puerta.","158":"Extiende los brazos hacia el frente cuando est\xe1 boca abajo.","159":"Estira brazos y piernas cuando est\xe1 boca abajo.","160":"Gira balance\xe1ndose de lado a lado mientras est\xe1 boca abajo.","162":"Boca arriba, levanta la cabeza y hace el esfuerzo de sentarse.","164":"Se mueve en diferentes direcciones al gatear.","165":"Cambia objetos de una mano a la otra.","168":"Patea una pelota mientras lo ayudan a caminar.","172":"Mete cosas en recipientes.","173":"Se coloca en posici\xf3n de gateo sobre manos y rodillas.","179":"Apila dos o m\xe1s bloques para hacer una torre.","182":"Camina por espacios angostos.","183":"Busca un objeto que se le cay\xf3 al suelo.","185":"Despeja el camino para agarrar lo que busca.","186":"Se siente t\xedmido o ansioso al conocer adultos nuevos.","188":"Toma conciencia de su entorno.","189":"Imita gestos simples despu\xe9s de verlos.","193":"Muestra el reflejo de Babinski al abrir los dedos del pie cuando le tocan la planta.","196":"Usa sonidos como \'m, n, p, t, d\' al balbucear.","197":"Hace sonidos de vocales como \'eh\' o \'ah\'.","199":"Entiende que los objetos tienen diferentes formas, texturas y tama\xf1os.","201":"Mantiene los pu\xf1os cerrados con fuerza.","203":"Descubre cosas escondidas bajo cobijas o mantas.","206":"Busca un juguete que acaba de ser escondido.","207":"Boca arriba, levanta las piernas unos 10 cm (4 pulgadas) del suelo.","208":"Pasa de estar parado a sentado sin ayuda.","209":"Pasa de estar sentado a ponerse de rodillas.","212":"Le gustan m\xe1s unas texturas que otras.","214":"Puede mirar un objeto o persona a la distancia de su brazo.","216":"Boca arriba, gira la cabeza a la izquierda y a la derecha.","217":"Golpea dos cosas entre s\xed.","218":"Copia expresiones faciales.","223":"Jala las cosas para acercarlas.","227":"Se sienta derecho y estable cuando se apoya en cojines o muebles.","230":"Gatea por encima o alrededor de obst\xe1culos.","235":"Saca objetos de un recipiente.","236":"Muestra el reflejo de succi\xf3n al succionar cuando algo le toca el paladar.","239":"Avanza impuls\xe1ndose con las piernas mientras est\xe1 boca abajo.","240":"Mira fijamente los rostros de las personas.","241":"Ayuda con tareas cotidianas, como recoger los juguetes.","243":"Reacciona diferente a las cosas calientes y fr\xedas.","245":"Se para sosteni\xe9ndose de algo.","247":"Hace sonidos guturales, como \'ga\' o \'gu\'.","249":"Llama a sus cuidadores \'mam\xe1\' o \'pap\xe1\'.","251":"Sostiene cosas usando todos los dedos menos el pulgar.","252":"Interact\xfaa con personas que conoce sonriendo o hablando.","258":"Te da algo cuando se lo pides.","262":"Se mece hacia adelante y hacia atr\xe1s en posici\xf3n de gateo.","267":"Rueda o se mueve para llegar a donde quiere.","269":"Intenta agarrar algo mientras est\xe1 boca abajo.","270":"Pasa de estar acostado a sentado sin ayuda.","271":"Se para por un momento con ayuda.","272":"Usa los brazos y las manos para ayudarse a mantenerse sentado sin caerse.","278":"Se\xf1ala los objetos que quiere.","279":"Se\xf1ala cosas que conoce cuando dices su nombre.","281":"Gira la cabeza para seguir objetos con la mirada.","283":"Sonr\xede cuando las personas hacen contacto visual.","285":"Sonr\xede por instinto; suele pasar al azar, sobre todo mientras duerme.","288":"Sostiene objetos grandes, como un oso de peluche, con ambas manos.","289":"Muestra el reflejo de b\xfasqueda al abrir la boca y voltear hacia tu mano cuando le acaricias la mejilla.","294":"Agarra un objeto peque\xf1o que pongas en sus manos.","295":"Sostiene objetos peque\xf1os con los dedos \xedndice.","296":"Sostiene cosas con las puntas de los dedos.","298":"Usa ambas manos juntas para manipular objetos, como abrir una caja.","299":"Se estira hacia un objeto con ambas manos.","301":"Usa diferentes tonos en su balbuceo.","303":"Mira a la persona que le habla.","304":"Tiene reacciones positivas, como sonre\xedr, o negativas, como estornudar, ante diferentes olores.","306":"Puede usar una cuchara por s\xed solo.","307":"Puede se\xf1alar al menos una parte del cuerpo cuando se lo pides.","308":"Expresa amor a las personas conocidas, como abraz\xe1ndolas.","309":"Puede caminar mientras sostiene un juguete peque\xf1o.","310":"Mueve juguetes con ruedas.","312":"Aplasta plastilina entre sus manos.","314":"Apila tres o m\xe1s bloques.","315":"Intenta cantar las canciones que conoce.","317":"Encuentra un objeto escondido debajo de varias cobijas.","325":"Pasa de estar parado a ponerse en cuclillas con fluidez, sin sentarse.","329":"Juega a imaginar, como darle de comer a una mu\xf1eca.","330":"Garabatea moviendo todo el brazo desde el hombro.","333":"Escucha con inter\xe9s cuando le hablas.","334":"Sabe la diferencia entre uno, dos y muchos.","335":"Mueve una parte del cuerpo cuando se lo pides.","338":"Aplaude o toca un instrumento al ritmo de una canci\xf3n.","340":"Te muestra cosas se\xf1al\xe1ndolas.","349":"Disfruta jugar solo.","350":"Se mantiene de pie firme sin necesitar apoyo.","352":"Nombra o se\xf1ala diferentes instrumentos de juguete.","353":"Repite palabras que escucha en conversaciones.","354":"Se divierte cuando juega con adultos.","355":"Empuja o jala juguetes mientras camina.","357":"Pasa cosas peque\xf1as de una caja a otra usando el pulgar y el \xedndice.","360":"Se\xf1ala a sus cuidadores, como \'mam\xe1\' o \'pap\xe1\'.","362":"Arruga papel usando ambas manos.","363":"Imita gestos con las manos, como aplaudir, saludar y se\xf1alar.","366":"Relaciona los sonidos de animales con la imagen correcta, como se\xf1alar al perro cuando dices \'guau\'.","368":"Responde preguntas simples con se\xf1as, acciones o palabras.","373":"Dice alrededor de 50 palabras.","375":"Dice cuatro o m\xe1s palabras.","377":"Usa toda la mano para sostener una crayola.","378":"Sostiene objetos peque\xf1os usando el pulgar y el \xedndice.","382":"Sube escaleras con un adulto, alternando los pies.","385":"Sabe la diferencia entre \'arriba\' y \'abajo\'.","386":"Sabe la diferencia entre \'adelante\' y \'atr\xe1s\'.","387":"Sabe la diferencia entre \'adentro\' y \'afuera\'.","391":"Usa palabras con la letra P, como \'pap\xe1\' o \'pelota\'.","394":"Usa palabras con la letra M, como \'mam\xe1\' o \'m\xe1s\'.","395":"Intenta decir la letra T poniendo la lengua detr\xe1s de los dientes.","396":"Se\xf1ala un objeto verde cuando se lo pides.","397":"Se\xf1ala un objeto azul cuando se lo pides.","398":"Se\xf1ala un objeto rojo cuando se lo pides.","399":"Se\xf1ala un objeto amarillo cuando se lo pides.","406":"Copia c\xf3mo los adultos usan las cosas (como fingir que habla por tel\xe9fono despu\xe9s de ver a mam\xe1 hacerlo).","408":"Derriba torres de bloques.","411":"Ayuda a quitarse la ropa, como bajarse los pantalones.","413":"Gatea hacia atr\xe1s para bajar algunos escalones.","414":"Hace bolitas de papel o plastilina con las manos.","415":"Da pasos cortos e inestables por s\xed solo.","417":"Se mueve al ritmo de la m\xfasica.","419":"Junta dos palabras para formar una frase corta, como \'m\xe1s galleta\'.","421":"Completa tareas de dos pasos, como \'Busca tu juguete y tr\xe1elo aqu\xed\'.","427":"Nombra figuras simples como el c\xedrculo, el tri\xe1ngulo o el cuadrado.","429":"Puede se\xf1alar un c\xedrculo.","430":"Se\xf1ala un tri\xe1ngulo.","431":"Se\xf1ala un cuadrado.","435":"Reconoce los nombres de personas conocidas.","436":"Presta atenci\xf3n unos minutos a un adulto que le lee un libro.","437":"Nombra objetos conocidos cuando se lo pides.","438":"Pasa de estar sentado a parado sin ayuda.","439":"Puede pronunciar diez o m\xe1s palabras.","441":"Sabe qu\xe9 cosas pertenecen a los miembros de la familia, como la bolsa de mam\xe1 o la cartera de pap\xe1.","443":"Mueve los brazos en c\xedrculos o de lado a lado, copiando tus movimientos.","445":"Nombra uno o dos alimentos.","451":"Nombra los sentimientos de un personaje en un cuento usando im\xe1genes, como se\xf1alar al personaje feliz.","452":"Copia sonidos cotidianos, como el de un coche o un tel\xe9fono.","454":"Juega y se divierte con otros ni\xf1os.","456":"Avienta una pelota por encima del hombro a una distancia de hasta 3 metros (10 pies).","457":"Recoge las cosas despu\xe9s de aventarlas.","458":"Detiene una pelota que rueda con las manos o el cuerpo.","459":"Juega con objetos mientras est\xe1 de pie.","461":"Explora por su cuenta con un cuidador cerca.","463":"Pega cosas en papel.","464":"Imita a los miembros de la familia durante el juego.","465":"Pide dos o tres cosas por su nombre, como \'mamila\' o \'comida\'.","467":"Rasga papel con ambas manos.","468":"Identifica los sonidos de instrumentos musicales, como tambores o guitarra.","469":"Repite los nombres de las partes del cuerpo cuando los escucha.","470":"Puede levantarse desde una posici\xf3n en cuclillas por s\xed solo.","471":"Baja escaleras con un adulto, alternando los pies.","472":"Encuentra el camino en lugares conocidos, como el cuarto de sus pap\xe1s.","475":"Participa en juegos de imaginaci\xf3n, como disfrazarse o actuar como bombero.","476":"Puede comer por s\xed solo, con o sin cubiertos.","478":"Se\xf1ala o nombra personajes de cuentos conocidos.","481":"Solo mueve la mu\xf1eca al garabatear.","483":"Nombra lugares en im\xe1genes, como parque, casa, mercado.","484":"Ya no se le caen las cosas por accidente.","490":"Dice palabras simples con la letra T, como \'tren\' o \'gato\'.","502":"Clasifica objetos por su tama\xf1o, como encontrar todos los bloques chiquitos en una pila de bloques.","503":"Clasifica cosas por su forma, como encontrar todos los bloques triangulares.","505":"Conoce entre 100 y 300 palabras de uso diario.","509":"Identifica a un ni\xf1o y una ni\xf1a en una imagen.","516":"Dibuja o pinta l\xedneas horizontales.","518":"Dibuja o pinta l\xedneas verticales.","519":"Puede dibujar o pintar con movimientos circulares.","521":"Ordena objetos por color, como encontrar todos los bloques rojos.","523":"Entiende la diferencia entre \'grande\' y \'chico\'.","524":"Completa oraciones de libros o canciones conocidas llenando los espacios.","527":"Describe caracter\xedsticas de objetos, animales o personas (por ejemplo, dice \'roja\' y se\xf1ala una pelota roja).","528":"Patea una pelota estando de pie.","529":"Intenta atrapar una pelota extendiendo los brazos hacia el frente.","530":"Bota una pelota en el suelo.","532":"Forma figuras con plastilina (como un animal).","534":"Usa palabras posesivas, como \'m\xedo\'.","536":"Hace tiras largas de plastilina rod\xe1ndola con las manos o sobre la mesa.","537":"Canta algunas palabras de una canci\xf3n.","538":"Sube por rampas caminando.","540":"Comunica una idea completa con una palabra, como \'parque\' para decir \'ll\xe9vame al parque\'.","544":"Habla brevemente de actividades recientes usando una o dos palabras.","551":"Copia lo que hacen los adultos al jugar, como arrullar y darle de comer a una mu\xf1eca como si fuera un beb\xe9.","558":"Mete cosas como un cord\xf3n en un agujero peque\xf1o.","559":"Dibuja l\xedneas en papel usando su dedo.","564":"Responde preguntas simples sobre una imagen (por ejemplo, si le preguntas \'\xbfde qu\xe9 color son las hojas?\', responde \'verdes\').","565":"Usa correctamente objetos de cuidado personal como el cepillo de pelo y el cepillo de dientes.","566":"Responde preguntas simples sobre un cuento.","568":"Nombra o se\xf1ala las herramientas que se usan en diferentes trabajos (como el estetoscopio del doctor).","569":"Entiende qu\xe9 es hablar fuerte y qu\xe9 es hablar bajito, y sabe cu\xe1ndo usar cada uno, como cu\xe1ndo hablar en voz baja.","572":"Nombra las cosas por su sonido, como decir \'tel\xe9fono\' cuando suena.","573":"Nombra m\xe1s de tres partes del cuerpo.","574":"Sabe para qu\xe9 sirven ciertas partes del cuerpo, como que los o\xeddos son para escuchar.","577":"Prefiere unos alimentos sobre otros.","579":"Identifica a quienes ayudan en la comunidad (como un doctor, un polic\xeda o un bombero).","587":"Dice palabras simples con la letra B, como \'beb\xe9\' o \'boca\'.","588":"Copia acciones f\xe1ciles, como agitar una sonaja.","589":"Pide ayuda balbuceando.","600":"Muestra cari\xf1o espont\xe1neamente a sus amigos.","602":"Muestra empat\xeda cuando ve a un amigo llorar (por ejemplo, intenta consolarlo).","603":"Sabe que algunas cosas le pertenecen y otras no.","606":"Puede abrir un cierre grande.","607":"Puede desabrochar un bot\xf3n grande de su ropa.","608":"Puede bajarse los pantalones.","609":"Sabe quitarse los zapatos.","610":"Se pone zapatos sin agujetas.","611":"Se pone una camisa sin botones.","612":"Se pone los pantalones.","613":"Puede hacer tareas con tres pasos claros, como \'Pon la manzana en el plato, toma agua y luego l\xedmpiate la cara\'.","614":"Nombra correctamente las cosas de uso diario.","615":"Diferencia entre \'sobre\', \'encima\' y \'debajo\', como poner algo debajo de la mesa cuando se lo pides.","617":"Habla con oraciones de cuatro a cinco palabras.","618":"Puede decir su nombre, su edad y su g\xe9nero.","619":"Llama a un amigo por su nombre.","620":"Dice palabras en plural (como coches, perros y gatos).","621":"Usa palabras como \'yo\', \'m\xed\' y \'t\xfa\'.","622":"La mayor\xeda de las personas le entienden cuando habla.","623":"Puede platicar usando de dos a tres oraciones.","625":"Incluye a otras personas o mascotas en sus juegos de imaginaci\xf3n.","627":"Empareja objetos con sus im\xe1genes en los libros.","628":"Entiende el significado de \'dos\' con una se\xf1a de los dedos.","631":"Da vuelta a las p\xe1ginas de un libro una por una.","632":"Apila 6 o m\xe1s bloques para hacer torres.","633":"Gira cosas que dan vueltas, como perillas de juguete o llaves del agua.","634":"Puede abrir y cerrar todo tipo de tapas, como las de frascos, pasta de dientes y botellas de agua.","635":"Trepa con facilidad, como en una escalera de los juegos del parque o en escalones.","637":"Agarra velocidad al moverse, casi como si corriera.","638":"Anda en triciclo.","639":"Puede subir escaleras sosteni\xe9ndose de algo y poniendo un pie despu\xe9s del otro.","640":"Se inclina hacia adelante sin caerse.","641":"Se sienta solo en una silla peque\xf1a.","642":"Patea una pelota hacia una direcci\xf3n espec\xedfica.","643":"Corre hacia una pelota y la patea.","644":"Avienta una pelota grande por encima de su cabeza con ambas manos.","645":"Asigna roles en juegos de imaginaci\xf3n con otros.","646":"Act\xfaa historias siguiendo un orden claro.","647":"Inventa cosas o personajes en sus juegos de imaginaci\xf3n.","648":"Le gusta m\xe1s jugar con amigos que solo.","649":"Coopera con otros ni\xf1os, como trabajar juntos para lograr algo.","650":"Resuelve problemas con otros ni\xf1os, como compartir juguetes o tomar turnos.","651":"Mezcla temas reales y de fantas\xeda al hablar.","653":"Habla de lo que le interesa.","655":"Canta una canci\xf3n de memoria.","656":"Usa oraciones de al menos cinco palabras.","657":"Cuenta una historia.","658":"Dice su nombre y apellido.","659":"Identifica tres o m\xe1s n\xfameros importantes para \xe9l o ella, como su edad o el n\xfamero de su casa.","660":"Nombra dos o m\xe1s colores.","661":"Puede contar cuando se lo pides.","664":"Recuerda partes de un cuento del d\xeda anterior.","665":"Reconoce cosas iguales y cuando son un poco diferentes, como un objeto fuera de lugar.","667":"Puede usar las tijeras correctamente con el pulgar hacia arriba.","670":"Brinca en un pie por 2 segundos.","671":"Mantiene el equilibrio en un pie por dos segundos o m\xe1s.","672":"Atrapa una pelota que rebota.","673":"Corta comida con un cuchillo para ni\xf1os bajo supervisi\xf3n.","674":"Sirve agua de una jarra a una taza con ambas manos.","675":"Come solo con un tenedor, usando toda la mano.","676":"Sube escaleras sin ayuda y sin detenerse de nada.","680":"Salta hacia adelante.","681":"Salta en su lugar con ambos pies.","682":"Salta hacia atr\xe1s.","683":"Se para en una pierna con un poco de ayuda.","684":"Da pasos apoyando el tal\xf3n y luego la punta del pie.","685":"Camina hacia atr\xe1s.","686":"Bebe de una taza con una mano.","687":"Apila 9 o m\xe1s bloques.","688":"Dice palabras simples con la letra N, como \'no\' o \'nena\'.","689":"Dice palabras simples con la letra D, como \'dedo\' o \'d\xeda\'.","690":"Dice palabras simples con la letra K, como \'kilo\' o \'karate\'.","691":"Dice palabras simples con la letra G, como \'gato\' o \'agua\'.","692":"Dice palabras simples con la letra F (como \'foca\' o \'flor\').","693":"Dice palabras simples con la letra Y, como \'yo\' o \'ya\'.","694":"Puede decir qui\xe9nes son sus amigos entre los ni\xf1os que conoce.","695":"Usa los dedos para decir su edad.","696":"Combina sustantivos y verbos, como \'mam\xe1 va\'.","698":"Habla de su d\xeda.","699":"Puede platicar usando cuatro oraciones seguidas.","700":"Responde preguntas b\xe1sicas de \'\xbfqui\xe9n?\', \'\xbfqu\xe9?\' y \'\xbfd\xf3nde?\'.","701":"Dice palabras que riman, como gato-pato.","702":"Nombra partes del cuerpo m\xe1s peque\xf1as (por ejemplo, el codo y las cejas).","703":"Entiende acciones cotidianas, como jugar o correr.","704":"Nombra y describe sus dibujos.","705":"Entiende cu\xe1ndo algo es largo o corto.","706":"Salta hacia adelante con ambos pies a la vez.","707":"Hace que sus juguetes \'hablen\' durante el juego de imaginaci\xf3n.","708":"Se para de puntitas sin ayuda.","709":"Baja las escaleras solo, alternando los pies y usando apoyo.","710":"Baja las escaleras solo, sin detenerse de nada.","711":"Sabe detenerse cuando corre.","712":"Camina de puntitas por cinco pasos.","713":"Salta desde una altura de unos 45 cm (18 pulgadas).","714":"Interact\xfaa con objetos en movimiento (por ejemplo, patea una pelota que se est\xe1 moviendo).","715":"Salta desde un escal\xf3n peque\xf1o.","716":"Al aventar, usa el cuerpo para apuntar (cambia el peso, mueve el brazo).","717":"Atrapa una pelota grande con los brazos y se mantiene firme.","718":"Atrapa una pelota en el aire solo con las manos.","721":"Mueve los brazos en direcci\xf3n opuesta a las piernas al correr.","723":"Corre con los codos doblados.","725":"Puede dar vueltas r\xe1pidas al correr, sin caerse ni detenerse.","726":"Corre con confianza en diferentes superficies, como concreto y pasto.","727":"Corre con direcci\xf3n.","728":"Entiende la diferencia entre \'pesado\' y \'ligero\'.","741":"Cuenta del 1 al 30.","756":"Levanta 5 dedos para indicar 5.","912":"Habla de noticias del peri\xf3dico, la radio, la televisi\xf3n u otras fuentes.","915":"Da instrucciones.","948":"Adapta el tono de su voz a diferentes situaciones (hace preguntas con tono ascendente, muestra sorpresa).","1027":"Agarra y suelta objetos con precisi\xf3n para construir estructuras con materiales de interior (bloques) y de exterior (palitos, hojas).","1127":"Identifica situaciones y actividades que disfruta.","1147":"Juega junto a otro ni\xf1o, pero sin interactuar directamente.","1152":"Se voltea de boca arriba a boca abajo."}')
