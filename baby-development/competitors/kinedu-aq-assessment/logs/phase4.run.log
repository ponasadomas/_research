import json,re,struct
start=json.loads(Path('raw/api/browser/A-start.response.json').read_text()); groups=[]
for i,s in enumerate(start['sections']):
    items=([s['anchor']] if s.get('anchor') else [])+s['items']+([start['calibration'][i]] if i<len(start['calibration']) else [])
    groups.append((s['area'],items))
block=Path('questions-by-age.md').read_text().split('## 12 months —')[1].split('\\n## 13 months')[0]
static=[]
for line in block.splitlines():
    m=re.match(r'- (?:\\*\\*anchor\\*\\* |\\*calibration \\(["'^)]*'"\\)\\* )?(\\d+) · ([\\d.]+) · (.*)',line)
    if m:static.append((int(m[1]),float(m[2]),m[3]))
served=[(q['id'],q['rate'],q['title']) for _,qs in groups for q in qs]
print('Static age12 equality',static==served,len(static),len(served))
for area,qs in groups:
    text=Path('raw/browser/A-area-'+area.lower()+'.snapshot.txt').read_text()
    positions=[text.find(json.dumps(q['title'],ensure_ascii=False)) for q in qs]
    print(area,'exact title in DOM in order',all(p>=0 for p in positions) and positions==sorted(positions),'yes',sum(q['rate']>=.5 for q in qs))
for p in sorted(Path('screenshots').glob('*.png')):
