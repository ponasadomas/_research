from pathlib import Path
import shutil
root=Path.cwd()
tmp=Path('/tmp/kinedu-browser')
for folder in ('screenshots/funnel2','raw/browser2','raw/api/browser2'):
    for p in (tmp/folder).iterdir():
        name=p.name.replace('.network-request','.json' if p.stem.split('.')[0] in ('start','result','lead') else '.body').replace('.network-response','.json' if p.stem.split('.')[0] in ('start','result','lead') else '.body')
        if p.name=='paywall-document.network-response': name='paywall-document.html'
        target=root/folder/name
        if target.exists(): raise RuntimeError(f'Unexpected target exists: {target}')
        shutil.move(str(p),target)
print('Moved MCP artifacts into project.')
PY
