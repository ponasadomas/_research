<!-- Oferta ANTES de los scripts compartidos: promo-price.js lee ?offer= de la
     URL al ejecutarse y su default es p49 (el de las promos). En adquisición el
     default es p79-t7, así que si el link no trae oferta la escribimos en la
     URL con replaceState — así el precio localizado, el checkout y el link que
     el usuario pueda compartir apuntan todos a la MISMA oferta. -->
<script>
(function () {
  'use strict';
  var ALLOWED = ['p49','p49-t7','p59','p59-t7','p79-t7','p39','p39-t7','p79-i30','p59-w1','p49-y499','p49-y699'];
  var DEFAULT_OFFER = 'p79-t7';
  var offer = DEFAULT_OFFER;
  try {
    var sp = new URLSearchParams(location.search);
    var o = sp.get('offer');
    if (o && ALLOWED.indexOf(o) !== -1) {
      offer = o;
    } else if (history.replaceState) {
      sp.set('offer', DEFAULT_OFFER);
      history.replaceState(null, '', location.pathname + '?' + sp.toString() + location.hash);
    }
    sessionStorage.setItem('kinedu_offer', offer);
  } catch (e) { /* nunca romper el paywall por la URL */ }
  window.__AQ_OFFER = offer;
