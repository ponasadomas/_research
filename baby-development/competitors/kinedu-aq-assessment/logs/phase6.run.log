+                 **request_audit)
+    (ROOT / "logs/phase6-validation.json").write_text(json.dumps(audit, indent=2) + "\n")
+
+    summary_lines = [
+        f"{status}: {len(recs)}/{len(jobs)} assessment requests; {observed}/{len(jobs)} complete reports.",
