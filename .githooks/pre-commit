#!/usr/bin/env bash
# Refuse files over 95 MB. GitHub rejects any file over 100 MB.
limit=$((95*1024*1024)); bad=0
while IFS= read -r -d '' f; do
  [ -f "$f" ] || continue
  size=$(stat -c%s "$f" 2>/dev/null || stat -f%z "$f")
  if [ "$size" -gt "$limit" ]; then echo "too large (over 95 MB): $f"; bad=1; fi
done < <(git diff --cached --name-only --diff-filter=AM -z)
[ $bad = 0 ] || { echo "Add these to .gitignore; they stay on disk and on the NAS backup."; exit 1; }
